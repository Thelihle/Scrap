		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.0.0-pre.49">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	
	
	<!-- Instead of explicitly including files, let's ensure they're preserved when publishing -->
	<ItemGroup>
		<None Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Change Password";
}
@using System.Text.RegularExpressions

<div class="change-password-form">
    <h2>CHANGE PASSWORD</h2>
    <p class="subtitle">You must change your password before continuing.</p>

    <form id="changePasswordForm">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" class="form-input" required>
            <div class="password-requirements">
                <ul>
                    <li class="requirement" data-requirement="length">At least 8 characters long</li>
                    <li class="requirement" data-requirement="uppercase">Contains uppercase letter</li>
                    <li class="requirement" data-requirement="lowercase">Contains lowercase letter</li>
                    <li class="requirement" data-requirement="number">Contains number</li>
                    <li class="requirement" data-requirement="special">Contains special character</li>
                </ul>
            </div>
        </div>

        <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" class="form-input" required>
        </div>

        <div class="error-message" style="display: none;"></div>
        <div class="success-message" style="display: none;"></div>

        <button type="submit" class="submit-btn">CHANGE PASSWORD</button>
    </form>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        font-family: -webkit-system-font, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, Ubuntu, "Helvetica Neue", Arial, sans-serif;
        position: relative;
    }

        /* Corporate background pattern */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(circle at 25% 25%, rgba(66, 139, 202, 0.1) 0%, transparent 50%), radial-gradient(circle at 75% 75%, rgba(40, 167, 69, 0.1) 0%, transparent 50%);
            z-index: -1;
        }

    .change-password-form {
        width: 100%;
        max-width: 420px;
        margin: 0 auto;
        padding: 30px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #dee2e6;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        position: relative;
    }

        /* Branding Enhancement */
        .change-password-form::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, #428bca, #28a745, #428bca);
            border-radius: 10px;
            z-index: -1;
            opacity: 0.1;
        }

    h2 {
        color: #1a1a2e;
        font-size: 28px;
        text-align: center;
        margin-bottom: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .subtitle {
        color: #6c757d;
        text-align: center;
        margin-bottom: 25px;
        font-size: 0.9rem;
        border-bottom: 2px solid #428bca;
        padding-bottom: 15px;
    }

    .form-group {
        position: relative;
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #495057;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        background: #fff;
        border: 2px solid #dee2e6;
        color: #495057;
        outline: none;
        transition: all 0.3s ease;
        font-size: 16px;
        border-radius: 4px;
    }

        .form-input:focus {
            border-color: #428bca;
            box-shadow: 0 0 0 0.2rem rgba(66, 139, 202, 0.25);
        }

    .password-toggle {
        position: absolute;
        right: 10px;
        top: 38px;
        background: transparent;
        border: none;
        color: #6c757d;
        cursor: pointer;
        z-index: 100;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.3s ease;
    }

        .password-toggle:hover {
            color: #428bca;
        }

    .password-requirements {
        margin-top: 12px;
        background: #f8f9fa;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #dee2e6;
    }

        .password-requirements ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

    .requirement {
        color: #dc3545;
        transition: color 0.3s ease;
        padding: 4px 0;
        font-size: 14px;
    }

        .requirement::before {
            content: '✕';
            margin-right: 8px;
            font-weight: bold;
        }

        .requirement.met {
            color: #28a745;
        }

            .requirement.met::before {
                content: '✓';
            }

    .submit-btn {
        width: 100%;
        padding: 12px;
        background: #428bca;
        border: 2px solid #428bca;
        color: #fff;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 15px;
        border-radius: 4px;
    }

        .submit-btn:hover {
            background: #3071a9;
            border-color: #3071a9;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .error-message, .success-message {
        padding: 12px;
        margin-top: 15px;
        text-align: center;
        border-radius: 4px;
        display: none;
    }

    .error-message {
        color: #dc3545;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
    }

    .success-message {
        color: #28a745;
        background: #d4edda;
        border: 1px solid #c3e6cb;
    }

    /* Animation */
    @@keyframes spin {
        from

    {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

    }

    .spin {
        animation: spin 1s linear infinite;
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .change-password-form

    {
        padding: 20px;
        margin: 10px;
    }

    .submit-btn {
        padding: 15px;
        font-size: 16px;
    }

    }
</style>

@section Scripts {
    <script>
        (function() {
            var specialCharRegex = new RegExp('[!@@#$%^&*()_+\\-=\\[\\]{};\':"\\\\|,.<>\\/?]');

            var requirements = {
                length: function(str) { return str.length >= 8; },
                uppercase: function(str) { return /[A-Z]/.test(str); },
                lowercase: function(str) { return /[a-z]/.test(str); },
                number: function(str) { return /[0-9]/.test(str); },
                special: function(str) {
                    return specialCharRegex.test(str);
                }
            };

            function updateRequirements(password) {
                Object.keys(requirements).forEach(function(key) {
                    var element = document.querySelector('.requirement[data-requirement="' + key + '"]');
                    if (element) {
                        if (requirements[key](password)) {
                            element.classList.add('met');
                        } else {
                            element.classList.remove('met');
                        }
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function() {
                // Remove any existing eye toggles
                document.querySelectorAll('.password-toggle').forEach(function(toggle) {
                    toggle.remove();
                });

                // Setup password fields
                var newPasswordInput = document.getElementById('newPassword');
                var confirmPasswordInput = document.getElementById('confirmPassword');

                if (newPasswordInput) {
                    addPasswordToggle(newPasswordInput);
                    newPasswordInput.addEventListener('input', function() {
                        updateRequirements(this.value);
                        validatePasswordMatch();
                    });
                    updateRequirements(newPasswordInput.value || '');
                }

                if (confirmPasswordInput) {
                    addPasswordToggle(confirmPasswordInput);
                    confirmPasswordInput.addEventListener('input', validatePasswordMatch);
                }

                function addPasswordToggle(input) {
                    // Get the parent with form-group class
                    var formGroup = input.closest('.form-group');
                    if (!formGroup) return;

                    // Create toggle button
                    var toggleBtn = document.createElement('button');
                    toggleBtn.type = 'button';
                    toggleBtn.className = 'password-toggle';
                    toggleBtn.innerHTML = '<i class="bi bi-eye-slash"></i>';

                    // Add click event
                    toggleBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();

                        if (input.type === 'password') {
                            input.type = 'text';
                            toggleBtn.innerHTML = '<i class="bi bi-eye"></i>';
                        } else {
                            input.type = 'password';
                            toggleBtn.innerHTML = '<i class="bi bi-eye-slash"></i>';
                        }
                    });

                    // Append to form group
                    formGroup.appendChild(toggleBtn);
                }

                // Form and validation setup
                var form = document.getElementById('changePasswordForm');
                var errorMsg = document.querySelector('.error-message');
                var successMsg = document.querySelector('.success-message');
                var submitBtn = document.querySelector('button[type="submit"]');

                function validatePasswordMatch() {
                    if (!newPasswordInput || !confirmPasswordInput) return true;

                    var newPassword = newPasswordInput.value;
                    var confirmPassword = confirmPasswordInput.value;

                    if (confirmPassword && newPassword !== confirmPassword) {
                        errorMsg.textContent = 'Passwords do not match';
                        errorMsg.style.display = 'block';
                        return false;
                    }
                    errorMsg.style.display = 'none';
                    return true;
                }

                if (form) {
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();

                        var newPassword = newPasswordInput.value;
                        var confirmPassword = confirmPasswordInput.value;
                        var clockNumber = '@Context.User.Identity.Name';

                        // Hide messages and disable button
                        errorMsg.style.display = 'none';
                        successMsg.style.display = 'none';
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> UPDATING...';

                        // Validate requirements
                        if (!Object.keys(requirements).every(function (key) {
                            return requirements[key](newPassword);
                        })) {
                            errorMsg.textContent = 'New password does not meet all requirements';
                            errorMsg.style.display = 'block';
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'CHANGE PASSWORD';
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            errorMsg.textContent = 'Passwords do not match';
                            errorMsg.style.display = 'block';
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'CHANGE PASSWORD';
                            return;
                        }

                        // Get the request verification token
                        var requestVerificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

                        // Replace the fetch call in your ChangePassword.cshtml script with this
                        fetch('/Account/HandlePasswordChange', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': requestVerificationToken
                            },
                            body: JSON.stringify({
                                ClockNumber: clockNumber,
                                NewPassword: newPassword
                            })
                        })
                            .then(function (response) {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok');
                                }
                                return response.json();
                            })
                            .then(function (result) {
                                if (result.success) {
                                    successMsg.textContent = 'Password changed successfully. Redirecting...';
                                    successMsg.style.display = 'block';

                                    // Give the server a moment to process the session update
                                    setTimeout(function () {
                                        if (result.redirectUrl) {
                                            window.location.href = result.redirectUrl;
                                        } else {
                                            // Fallback redirects based on common user types
                                            const userType = '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower()';
                                            if (userType === 'operator') {
                                                window.location.href = '/Operator/Index';
                                            } else if (userType === 'admin') {
                                                window.location.href = '/ScrapApproval/AdminWeightDashboard';
                                            } else {
                                                window.location.href = '/ScrapApproval/Dashboard';
                                            }
                                        }
                                    }, 1500);
                                } else {
                                    throw new Error(result.message || 'Failed to change password');
                                }
                            })
                            .catch(function (error) {
                                console.error('Error:', error);
                                errorMsg.textContent = error.message;
                                errorMsg.style.display = 'block';
                            })
                            .finally(function () {
                                submitBtn.disabled = false;
                                submitBtn.textContent = 'CHANGE PASSWORD';
                            });
                    });
                }
            });
        })();
    </script>
}
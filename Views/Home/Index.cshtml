@{
    ViewData["Title"] = "Scrap Management";
}
<div class="min-h-screen flex items-center justify-center bg-gray-100 relative overflow-hidden">
    <div class="container mx-auto px-4 text-center relative z-10">
        <div class="logo-container mb-8">
            <span class="hesto-text">HEST</span>
            <span class="hesto-o">O</span>
            <span class="harnesses-text">HARNESSES</span>
        </div>

        <div class="scrap-visualization mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" class="mx-auto max-w-full scrap-svg">
                <defs>
                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur class="blur" stdDeviation="4" result="coloredBlur"/>
                        <feMerge>
                            <feMergeNode in="coloredBlur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                <rect x="50" y="50" width="300" height="100" fill="#003366" rx="10" filter="url(#glow)"/>
                <path d="M100 75 L150 125 L200 75 L250 125 L300 75" stroke="#FFC600" stroke-width="4" fill="none" filter="url(#glow)"/>
                <circle cx="75" cy="100" r="20" fill="#FFC600" filter="url(#glow)"/>
                <circle cx="325" cy="100" r="20" fill="#FFC600" filter="url(#glow)"/>
            </svg>
        </div>

        <h1 class="text-3xl text-blue-900 mb-4">SCP Control</h1>
        <p class="text-gray-700 mb-6">
            Please <a asp-controller="Account" asp-action="Login" class="text-blue-600 hover:underline font-bold">login</a> to access the <strong>Secure Control Panel</strong>
        </p>
        <div class="quote-container mb-6">
            <p class="text-gray-600 italic max-w-md mx-auto">
                "Transforming Waste into Opportunity: Precision Scrap Management for Optimal Efficiency"
            </p>
        </div>
        <div>
            <a asp-controller="Account" asp-action="Login" class="bg-blue-600 text-white px-8 py-3 rounded-full hover:bg-blue-700 transition inline-block">
                Login to SCP
            </a>
        </div>
    </div>

    <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
        <div class="absolute bg-blue-500 opacity-20 rounded-full animate-pulse" style="width: 300px; height: 300px; top: -150px; left: -150px;"></div>
        <div class="absolute bg-yellow-500 opacity-20 rounded-full animate-pulse" style="width: 400px; height: 400px; bottom: -200px; right: -200px;"></div>
    </div>
</div>

<style>
    .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, sans-serif;
    }
    .hesto-text {
        color: #003366;
        font-size: 48px;
        font-weight: bold;
        letter-spacing: -2px;
    }
    .hesto-o {
        color: #003366;
        font-size: 48px;
        font-weight: bold;
        margin: 0 -5px;
        background: linear-gradient(135deg, #FFC600 50%, white 50%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .harnesses-text {
        color: #003366;
        font-size: 24px;
        font-weight: normal;
        margin-left: 10px;
    }
    .scrap-visualization {
        max-width: 500px;
        margin: 0 auto;
    }
    .scrap-svg {
        transition: all 0.3s ease;
    }
    .scrap-svg:hover {
        transform: scale(1.05);
    }
    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
    }
    .animate-pulse {
        animation: pulse 2s infinite;
    }
</style>
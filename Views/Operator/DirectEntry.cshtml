    // ── INIT ──────────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        loadSavedEntries();
        attachEventListeners();
        loadScrapSections();
    });

    // ── TOGGLE: enable/disable form ───────────────────────────────────────────
    function setFormEnabled(enabled) {
        formEnabled = enabled;
        const fields = ['manualPartNumber','scrapSection','scrapReason','quantity',
                        'partPosition','lengthInput','machineType','machineNumber','engineeringPlant'];
        fields.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.disabled = !enabled;
        });

        const overlay  = document.getElementById('formDisabledOverlay');
        const actBtns  = document.getElementById('formActionButtons');
        if (overlay) overlay.style.display  = enabled ? 'none'  : 'flex';
        if (actBtns) actBtns.style.display  = enabled ? 'flex'  : 'none';

        if (!enabled) {
            // reset visible conditional fields
            ['positionDiv','lengthDiv','machineTypeDiv','machineNumberDiv','engineeringPlantDiv']
                .forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
        }
    }

    // ── SECTIONS ──────────────────────────────────────────────────────────────
    function loadScrapSections() {
        const scrapSection = document.getElementById('scrapSection');
        scrapSection.innerHTML = '<option value="">Select Section</option>';
        STATIC_SCRAP_DATA.sections.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.value; opt.textContent = s.text;
            scrapSection.appendChild(opt);
        });
    }

    async function handleSectionChange() {
        if (!formEnabled) return;
        const scrapSection = document.getElementById('scrapSection');
        const scrapReason  = document.getElementById('scrapReason');
        const sectionId    = scrapSection.value;

        scrapReason.innerHTML = '<option value="">Select Reason</option>';
        scrapReason.disabled  = !sectionId;

        // show/hide conditional divs
        document.getElementById('positionDiv')        .style.display = sectionId === "2"  ? 'block' : 'none';
        document.getElementById('lengthDiv')          .style.display = ["5","6"].includes(sectionId) ? 'block' : 'none';
        document.getElementById('machineTypeDiv')     .style.display = sectionId === "5"  ? 'block' : 'none';
        document.getElementById('machineNumberDiv')   .style.display = 'none';
        document.getElementById('engineeringPlantDiv').style.display = sectionId === "10" ? 'block' : 'none';

        if (!sectionId) return;

        // try API first, fall back to static
        scrapReason.innerHTML = '<option value="">Loading...</option>';
        scrapReason.disabled  = true;
        try {
            let reasons = await loadReasonsFromAPI(sectionId);
            if (!reasons || reasons.length === 0) reasons = STATIC_SCRAP_DATA.reasonsBySection[sectionId] || [];
            scrapReason.innerHTML = '<option value="">Select Reason</option>';
            reasons.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.value; opt.textContent = r.text;
                scrapReason.appendChild(opt);
            });
            scrapReason.disabled = false;
        } catch(e) {
            scrapReason.innerHTML = '<option value="">Error loading</option>';
        }

        if (sectionId === "2") loadPositions();
        if (sectionId === "5") loadMachineTypes();
    }

    function loadMachineTypes() {
        const mt = document.getElementById('machineType');
        if (!mt) return;
        mt.innerHTML = '<option value="">Select Machine Type</option>';
        STATIC_SCRAP_DATA.preAssemblyFordMachines.forEach(m => {
            const o = document.createElement('option'); o.value = m.value; o.textContent = m.text;
            mt.appendChild(o);
        });
    }

    function handleMachineTypeChange() {
        const mt  = document.getElementById('machineType');
        const mnd = document.getElementById('machineNumberDiv');
        const mn  = document.getElementById('machineNumber');
        if (!mt.value) { mnd.style.display = 'none'; return; }
        mnd.style.display = 'block';
        mn.innerHTML = '<option value="">Select Machine Number</option>';
        (STATIC_SCRAP_DATA.machineNumbers[mt.value] || []).forEach(n => {
            const o = document.createElement('option'); o.value = n; o.textContent = n;
            mn.appendChild(o);
        });
    }

    async function loadReasonsFromAPI(sectionId) {
        try {
            const res = await fetch(`/Operator/GetScrapReasonsBySection?sectionId=${sectionId}`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const result = await res.json();
            return result.success && result.data ? result.data : null;
        } catch(e) { return null; }
    }

    function loadPositions() {
        const pp = document.getElementById('partPosition');
        if (!pp) return;
        pp.innerHTML = '<option value="">Select Position</option>';
        STATIC_SCRAP_DATA.combiMeterPositions.forEach(p => {
            const o = document.createElement('option'); o.value = p; o.textContent = p;
            pp.appendChild(o);
        });
    }

    // ── ADD / EDIT ENTRIES ────────────────────────────────────────────────────
    function addToReview() { editState.isEditing ? updateExistingEntry() : addNewEntry(); }

    function addNewEntry() {
        const partNumber   = document.getElementById('manualPartNumber').value.trim();
        const scrapSection = document.getElementById('scrapSection');
        const scrapReason  = document.getElementById('scrapReason');
        const quantity     = document.getElementById('quantity');
        const partPosition = document.getElementById('partPosition');
        const engPlant     = document.getElementById('engineeringPlant');

        if (!partNumber)        { alert('Please enter a part number'); return; }
        if (!scrapSection.value){ alert('Please select a scrap section'); return; }
        if (!scrapReason.value) { alert('Please select a scrap reason'); return; }
        if (!quantity.value || parseInt(quantity.value) <= 0) { alert('Please enter a valid quantity'); return; }
        if (scrapSection.value === "2" && (!partPosition || !partPosition.value)) { alert('Position is required for CombiMeter'); return; }
        if (scrapSection.value === "10" && (!engPlant || !engPlant.value)) { alert('Please select a plant for Engineering'); return; }

        scrapState.entries.push(createEntryFromForm());
        saveToStorage(); updateReviewTable(); clearFormOnly();
    }

    function updateExistingEntry() {
        const scrapSection = document.getElementById('scrapSection');
        const scrapReason  = document.getElementById('scrapReason');
        const quantity     = document.getElementById('quantity');
        if (!scrapSection.value || !scrapReason.value || !quantity.value || parseInt(quantity.value) <= 0) {
            alert('Please fill in all required fields'); return;
        }
        const updated = createEntryFromForm();
        const idx = editState.editingIndex < scrapState.entries.length ? editState.editingIndex : scrapState.entries.length;
        scrapState.entries.splice(idx, 0, updated);
        saveToStorage(); updateReviewTable(); clearFormOnly(); exitEditingMode();
        alert('Entry updated!');
    }

    function createEntryFromForm() {
        const scrapSection = document.getElementById('scrapSection');
        const scrapReason  = document.getElementById('scrapReason');
        const quantity     = document.getElementById('quantity');
        const partPosition = document.getElementById('partPosition');
        const lengthInput  = document.getElementById('lengthInput');
        const machineType  = document.getElementById('machineType');
        const machineNumber= document.getElementById('machineNumber');
        const engPlant     = document.getElementById('engineeringPlant');

        let lengthValue = 0;
        if (lengthInput?.value?.trim()) { const lv = parseFloat(lengthInput.value); if (!isNaN(lv) && lv >= 0) lengthValue = lv; }

        return {
            partNumber:        document.getElementById('manualPartNumber').value.trim(),
            department:        document.getElementById('department')?.textContent?.trim() || '',
            line:              document.getElementById('line')?.textContent?.trim() || '',
            shift:             document.getElementById('shift')?.textContent?.trim() || '',
            scrapSectionId:    parseInt(scrapSection.value),
            sectionName:       scrapSection.options[scrapSection.selectedIndex].text,
            reasonId:          parseInt(scrapReason.value),
            scrapReason:       scrapReason.options[scrapReason.selectedIndex].text,
            position:          scrapSection.value === "2" ? (partPosition?.value || "") : "",
            length:            lengthValue,
            machineType:       machineType?.value || "",
            machineNumber:     machineNumber?.value || "",
            engineeringPlant:  engPlant?.value || "",
            quantity:          parseInt(quantity.value),
            stockUom:          'EA',
            materialCost:      0,
            timestamp:         new Date().toISOString()
        };
    }

    function deleteEntry(index) {
        if (confirm('Delete this entry?')) {
            scrapState.entries.splice(index, 1);
            saveToStorage(); updateReviewTable();
        }
    }

    function toggleEntryDetails(index) {
        const det = document.getElementById(`entry-details-${index}`);
        if (det) {
            document.querySelectorAll('.entry-details.visible').forEach(el => { if (el !== det) el.classList.remove('visible'); });
            det.classList.toggle('visible');
        }
    }

    function editEntry(index) {
        if (index < 0 || index >= scrapState.entries.length) return;
        const entry = scrapState.entries[index];
        editState.originalEntry = JSON.parse(JSON.stringify(entry));
        editState.isEditing     = true;
        editState.editingIndex  = index;

        // Enable form for editing
        const toggle = document.getElementById('enableFormToggle');
        if (toggle) { toggle.checked = true; setFormEnabled(true); }

        document.getElementById('manualPartNumber').value = entry.partNumber;
        document.getElementById('quantity').value         = entry.quantity;

        const ss = document.getElementById('scrapSection');
        ss.value = entry.scrapSectionId.toString();
        handleSectionChange().then(() => {
            setTimeout(() => {
                document.getElementById('scrapReason').value = entry.reasonId.toString();
                if (entry.position) { const pp = document.getElementById('partPosition'); if (pp) pp.value = entry.position; }
                if (entry.length > 0) { const li = document.getElementById('lengthInput'); if (li) li.value = entry.length; }
                if (entry.engineeringPlant) { const ep = document.getElementById('engineeringPlant'); if (ep) ep.value = entry.engineeringPlant; }
            }, 150);
        });

        scrapState.entries.splice(index, 1);
        saveToStorage(); updateReviewTable(); showEditingMode();
    }

    function showEditingMode() {
        const addBtn  = document.getElementById('addToReviewBtn');
        const clrBtn  = document.getElementById('clearBtn');
        if (addBtn) { addBtn.textContent = 'Update Entry'; addBtn.style.backgroundColor = '#ffa500'; }
        if (clrBtn) { clrBtn.textContent = 'Cancel Edit';  clrBtn.style.backgroundColor = '#ff4444'; clrBtn.style.color = '#fff'; }
        const sec = document.getElementById('scrapEntrySection');
        if (sec) { sec.style.borderColor = '#ffa500'; sec.style.boxShadow = '0 0 15px rgba(255,165,0,0.3)'; }
    }

    function exitEditingMode() {
        const addBtn = document.getElementById('addToReviewBtn');
        const clrBtn = document.getElementById('clearBtn');
        if (addBtn) { addBtn.textContent = 'Add to Review'; addBtn.style.backgroundColor = ''; }
        if (clrBtn) { clrBtn.textContent = 'Clear'; clrBtn.style.backgroundColor = ''; clrBtn.style.color = ''; }
        const sec = document.getElementById('scrapEntrySection');
        if (sec) { sec.style.borderColor = ''; sec.style.boxShadow = ''; }
        editState.isEditing = false; editState.editingIndex = -1; editState.originalEntry = null;
    }

    function clearFormOnly() {
        ['manualPartNumber','scrapSection','scrapReason','quantity',
         'partPosition','lengthInput','machineType','machineNumber','engineeringPlant']
            .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
        const sr = document.getElementById('scrapReason');
        if (sr) { sr.disabled = true; sr.innerHTML = '<option value="">Select Reason</option>'; }
        ['positionDiv','lengthDiv','machineTypeDiv','machineNumberDiv','engineeringPlantDiv']
            .forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
    }

    function clearForm() { editState.isEditing ? cancelEdit() : clearFormOnly(); }

    function cancelEdit() {
        if (!confirm('Cancel editing? Changes will be lost.')) return;
        if (editState.originalEntry) {
            const idx = editState.editingIndex < scrapState.entries.length ? editState.editingIndex : scrapState.entries.length;
            scrapState.entries.splice(idx, 0, editState.originalEntry);
            saveToStorage(); updateReviewTable();
        }
        clearFormOnly(); exitEditingMode();
    }

    // ── REVIEW TABLE ──────────────────────────────────────────────────────────
    function updateReviewTable() {
        const body = document.getElementById('reviewTableBody');
        const totalQtyEl = document.getElementById('totalQuantity');
        if (!body) return;
        body.innerHTML = '';
        let totalQty = 0;

        if (scrapState.entries.length === 0) {
            body.innerHTML = '<div class="no-entries">No saved entries found. Go to <strong>Scan Part</strong> to create entries.</div>';
            if (totalQtyEl) totalQtyEl.textContent = '0';
            return;
        }

        scrapState.entries.forEach((entry, index) => {
            const card = document.createElement('div');
            card.className = 'scrap-entry-card';

            const positionDetails     = entry.position ? `<div class="entry-detail"><strong>Position:</strong> ${entry.position}</div>` : '';
            const lengthDetails       = entry.length && entry.length > 0 ? `<div class="entry-detail"><strong>Length:</strong> ${entry.length} mm</div>` : '';
            const machineDetails      = entry.machineType && entry.machineNumber ? `<div class="entry-detail"><strong>Machine:</strong> ${entry.machineType.toUpperCase()} – ${entry.machineNumber}</div>` : '';
            const engPlantDetails     = entry.engineeringPlant ? `<div class="entry-detail"><strong>Plant:</strong> ${entry.engineeringPlant}</div>` : '';

            card.innerHTML = `
                <div class="entry-header" onclick="toggleEntryDetails(${index})">
                    <div class="entry-title">${entry.partNumber} — ${entry.scrapReason} (${entry.sectionName})</div>
                    <div class="entry-quantity">Qty: ${entry.quantity}</div>
                </div>
                <div class="entry-details" id="entry-details-${index}">
                    ${positionDetails}${lengthDetails}${machineDetails}${engPlantDetails}
                    <div class="entry-detail"><strong>Department:</strong> ${entry.department}</div>
                    <div class="entry-detail"><strong>Line:</strong> ${entry.line}</div>
                    <div class="entry-detail"><strong>Shift:</strong> ${entry.shift}</div>
                    <div class="entry-actions">
                        <button type="button" class="btn-edit"   onclick="editEntry(${index})">Edit</button>
                        <button type="button" class="btn-delete" onclick="deleteEntry(${index})">Delete</button>
                    </div>
                </div>`;
            body.appendChild(card);
            totalQty += parseInt(entry.quantity) || 0;
        });

        if (totalQtyEl) totalQtyEl.textContent = totalQty;
    }

    // ── STORAGE ───────────────────────────────────────────────────────────────
    function saveToStorage() {
        const d = JSON.stringify(scrapState.entries);
        sessionStorage.setItem('scrapEntries', d);
        localStorage.setItem('scrapEntries', d);
    }

    function loadSavedEntries() {
        try {
            const d = sessionStorage.getItem('scrapEntries') || localStorage.getItem('scrapEntries');
            if (d) {
                const arr = JSON.parse(d);
                if (Array.isArray(arr) && arr.length > 0) {
                    scrapState.entries = arr;
                    updateReviewTable();
                    return arr.length;
                }
            }
        } catch(e) { console.error('Storage load error:', e); }
        updateReviewTable(); // show empty state
        return 0;
    }

    function clearStorage() {
        sessionStorage.removeItem('scrapEntries');
        localStorage.removeItem('scrapEntries');
        scrapState.entries = [];
    }

    // ── EVENT LISTENERS ───────────────────────────────────────────────────────
    function attachEventListeners() {
        document.getElementById('enableFormToggle')?.addEventListener('change', function() {
            setFormEnabled(this.checked);
            if (this.checked) {
                // re-populate sections now that selects are enabled
                loadScrapSections();
            }
        });

        document.getElementById('scrapSection')  ?.addEventListener('change', handleSectionChange);
        document.getElementById('machineType')   ?.addEventListener('change', handleMachineTypeChange);
        document.getElementById('addToReviewBtn')?.addEventListener('click',  addToReview);
        document.getElementById('clearBtn')      ?.addEventListener('click',  clearForm);
        document.getElementById('submitAllBtn')  ?.addEventListener('click',  handleSubmitAll);
        document.getElementById('addNewPartBtn') ?.addEventListener('click',  () => { window.location.href = '/Operator/ScanPart'; });
        document.getElementById('viewHistoryBtn')?.addEventListener('click',  () => { window.location.href = '/Operator/ScrapHistory'; });
        document.getElementById('scanPartBtn')   ?.addEventListener('click',  () => { window.location.href = '/Operator/ScanPart'; });
    }

    // ── SUBMIT ────────────────────────────────────────────────────────────────
    async function handleSubmitAll() {
        if (scrapState.entries.length === 0) { alert('No entries to submit.'); return; }
        if (!confirm(`Submit ${scrapState.entries.length} entries?`)) return;

        const submitBtn   = document.getElementById('submitAllBtn');
        const progressDiv = document.getElementById('submissionProgress');
        if (progressDiv) progressDiv.classList.remove('hidden');
        if (submitBtn)   { submitBtn.disabled = true; submitBtn.textContent = 'Submitting...'; }

        try {
            let successCount = 0, failCount = 0;
            const failedEntries = [];
            let batchId = null;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            for (let i = 0; i < scrapState.entries.length; i++) {
                const entry = scrapState.entries[i];
                try {
                    const payload = {
                        partNumber:       entry.partNumber,
                        scrapSectionId:   parseInt(entry.scrapSectionId),
                        reasonId:         parseInt(entry.reasonId),
                        scrapReason:      entry.scrapReason,
                        quantity:         parseInt(entry.quantity),
                        position:         entry.position || "",
                        length:           entry.length || 0,
                        weight:           entry.weight || 0,
                        scrapType:        entry.scrapType || 'component',
                        machineType:      entry.machineType || "",
                        machineNumber:    entry.machineNumber || "",
                        department:       entry.department,
                        line:             entry.line,
                        shift:            entry.shift,
                        stockUom:         entry.stockUom || "",
                        materialCost:     parseFloat(entry.materialCost) || 0,
                        partCategory:     entry.partCategory || "",
                        plant:            entry.plant || "",
                        company:          entry.company || "B",
                        batchScrapId:     batchId,
                        status:           "Pending TL",
                        engineeringPlant: entry.engineeringPlant || ""
                    };

                    const res = await fetch('/Operator/SubmitScrap', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(payload)
                    });

                    if (res.ok) {
                        const result = await res.json();
                        if (result.success) {
                            successCount++;
                            if (batchId === null && result.data?.batchScrapId) batchId = result.data.batchScrapId;
                        } else {
                            failCount++; failedEntries.push({ index: i, entry, error: result.message });
                        }
                    } else {
                        failCount++; failedEntries.push({ index: i, entry, error: `HTTP ${res.status}` });
                    }
                } catch(err) {
                    failCount++; failedEntries.push({ index: i, entry, error: err.message });
                }
                await new Promise(r => setTimeout(r, 200));
            }

            if (progressDiv) progressDiv.classList.add('hidden');

            if (failCount === 0) {
                clearStorage(); showSuccessState();
            } else {
                alert(`⚠️ ${successCount} submitted, ${failCount} failed.\nFailed entries remain for retry.`);
                const successIdx = [];
                for (let i = 0; i < scrapState.entries.length; i++) {
                    if (!failedEntries.some(f => f.index === i)) successIdx.push(i);
                }
                successIdx.reverse().forEach(i => scrapState.entries.splice(i, 1));
                saveToStorage(); updateReviewTable();
            }
        } catch(err) {
            alert('Error: ' + err.message);
            if (progressDiv) progressDiv.classList.add('hidden');
        } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Submit All'; }
        }
    }

    function showSuccessState() {
        ['partInfoSection','scrapEntrySection','reviewSection'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
        document.getElementById('successMessage')?.classList.remove('hidden');
        document.getElementById('postSubmissionActions')?.classList.remove('hidden');
        scrapState.isSubmitted = true;
    }

    // ── NAVIGATION ────────────────────────────────────────────────────────────
    function navigateHome() { window.location.href = '/Operator/Index'; }

    window.toggleEntryDetails = toggleEntryDetails;
    window.deleteEntry        = deleteEntry;
    window.editEntry          = editEntry;
    window.navigateHome       = navigateHome;
</script>

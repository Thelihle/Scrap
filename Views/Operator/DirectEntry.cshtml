@model ScrapEntryViewModel
@{
    ViewData["Title"] = "Direct Scrap Entry - SCP Control";
    Layout = "_TeamLeaderLayout";
}

<div class="scrap-container">
    <!-- Navigation Bar -->
    <div class="navigation-bar">
        <button onclick="navigateHome()" class="nav-button back-button" id="homeBtn">
            <i class="bi bi-house"></i> Home
        </button>
        <form action="/Account/Logout" method="post" style="margin: 0;" id="logoutForm">
            <input type="hidden" data-clock-number="@User.Identity?.Name" value="@User.Identity?.Name" />
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-button logout-button">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>

    <!-- Direct Entry Header -->
    <div class="part-info-section" id="partInfoSection">
        <h2 class="section-title">
            <i class="bi bi-pencil-square"></i> Direct Scrap Entry
        </h2>

        <!-- Info banner -->
        <div class="info-banner">
            <i class="bi bi-info-circle"></i>
            Your previously saved entries have been loaded below. Review and click <strong>Submit All</strong> to save them to the database.
        </div>

        <div class="info-cards">
            <div class="info-card">
                <label>Department</label>
                <span id="department">@Model.Department</span>
            </div>
            <div class="info-card">
                <label>Line</label>
                <span id="line">@Model.Line</span>
            </div>
            <div class="info-card">
                <label>Shift</label>
                <span id="shift">@Model.Shift</span>
            </div>
        </div>
    </div>

    <!-- Scrap Entry Form — Part Number & Quantity DISABLED -->
    <div class="scrap-entry-section" id="scrapEntrySection">
        <h2 class="section-title">
            Scrap Details
            <span class="add-more-toggle-label">
                Add another entry?
                <label class="toggle-switch">
                    <input type="checkbox" id="enableFormToggle" />
                    <span class="toggle-slider"></span>
                </label>
            </span>
        </h2>

        <div id="formDisabledOverlay" class="form-disabled-notice">
            <i class="bi bi-lock"></i> Toggle above to add a new entry
        </div>

        <form id="scrapForm" class="scrap-form">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <!-- Part Number — DISABLED -->
                <div class="form-group">
                    <label for="manualPartNumber">Part Number</label>
                    <input type="text" id="manualPartNumber" class="form-control"
                           placeholder="Enable form to enter part number"
                           disabled />
                    <small class="form-help">Toggle above to enable entry</small>
                </div>

                <!-- Scrap Section -->
                <div class="form-group">
                    <label for="scrapSection">Scrap Section</label>
                    <select id="scrapSection" class="form-control" disabled>
                        <option value="">Select Section</option>
                    </select>
                </div>

                <!-- Machine Type (Pre-Assembly Ford only) -->
                <div id="machineTypeDiv" class="form-group" style="display:none;">
                    <label for="machineType">Machine Type</label>
                    <select id="machineType" class="form-control" disabled>
                        <option value="">Select Machine Type</option>
                    </select>
                </div>

                <!-- Machine Number -->
                <div id="machineNumberDiv" class="form-group" style="display:none;">
                    <label for="machineNumber">Machine Number</label>
                    <select id="machineNumber" class="form-control" disabled>
                        <option value="">Select Machine Number</option>
                    </select>
                </div>

                <!-- Engineering Plant -->
                <div id="engineeringPlantDiv" class="form-group" style="display:none;">
                    <label for="engineeringPlant">Plant *</label>
                    <select id="engineeringPlant" class="form-control" disabled>
                        <option value="">Select Plant</option>
                        <option value="Plant A">Plant A</option>
                        <option value="Plant B">Plant B</option>
                        <option value="Plant C">Plant C</option>
                        <option value="Fielli">Fielli</option>
                    </select>
                </div>

                <!-- Scrap Reason -->
                <div class="form-group">
                    <label for="scrapReason">Scrap Reason</label>
                    <select id="scrapReason" class="form-control" disabled>
                        <option value="">Select Reason</option>
                    </select>
                </div>

                <!-- Position (CombiMeter) -->
                <div id="positionDiv" class="form-group" style="display:none;">
                    <label for="partPosition">Position</label>
                    <select id="partPosition" class="form-control" disabled>
                        <option value="">Select Position</option>
                    </select>
                </div>

                <!-- Length (Pre-Assembly) -->
                <div id="lengthDiv" class="form-group" style="display:none;">
                    <label for="lengthInput">Length (mm)</label>
                    <input type="number" id="lengthInput" step="0.001" min="0"
                           placeholder="Enter length in mm" class="form-control" disabled />
                </div>

                <!-- Quantity — DISABLED -->
                <div class="form-group">
                    <label for="quantity">Quantity</label>
                    <input type="number" id="quantity" min="1" class="form-control"
                           placeholder="Enable form to enter quantity"
                           disabled />
                </div>
            </div>

            <div class="action-buttons" id="formActionButtons" style="display:none;">
                <button type="button" id="addToReviewBtn" class="action-button primary-button">
                    Add to Review
                </button>
                <button type="button" id="clearBtn" class="action-button secondary-button">
                    Clear
                </button>
            </div>
        </form>
    </div>

    <!-- Review Entries -->
    <div class="review-section" id="reviewSection">
        <h2 class="section-title">Review Entries</h2>
        <div class="entry-cards" id="reviewTableBody"></div>

        <div class="totals-section">
            <div class="total-item">
                <span class="total-label">Total Quantity:</span>
                <span class="total-value" id="totalQuantity">0</span>
            </div>
        </div>

        <div class="action-buttons final-actions">
            <button type="button" class="action-button secondary-button" id="addNewPartBtn">
                Scan New Part
            </button>
            <button type="button" id="submitAllBtn" class="action-button primary-button">
                Submit All
            </button>
        </div>
    </div>

    <!-- Success Message -->
    <div class="success-message hidden" id="successMessage">
        <h3>✅ Scrap Entries Submitted Successfully!</h3>
        <p>All entries have been submitted and saved to the database.</p>
    </div>

    <!-- Post-Submission Actions -->
    <div class="review-section hidden" id="postSubmissionActions">
        <h2 class="section-title">Next Actions</h2>
        <div class="action-buttons final-actions">
            <button type="button" class="action-button secondary-button" id="viewHistoryBtn">
                View Scrap History
            </button>
            <button type="button" class="action-button primary-button" id="scanPartBtn">
                Scan Part Numbers
            </button>
        </div>
    </div>
</div>

<div class="submission-progress hidden" id="submissionProgress">
    <div class="progress-text">Submitting entries to database...</div>
</div>

<style>
    :root {
        --neon-cyan: #00fff2;
        --neon-cyan-glow: rgba(0, 255, 242, 0.3);
        --dark-bg: #121212;
        --card-bg: rgba(0, 21, 20, 0.95);
        --warning-color: #ff4444;
        --success-color: #00ff00;
        --border-radius: 6px;
    }

    body {
        background: var(--dark-bg);
        color: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .scrap-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .navigation-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .nav-button {
        background: transparent;
        border: 1px solid var(--neon-cyan);
        color: var(--neon-cyan);
        padding: 10px 16px;
        border-radius: var(--border-radius);
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        font-size: 14px;
    }

        .nav-button:hover {
            background: rgba(0,255,242,0.1);
            box-shadow: 0 0 10px var(--neon-cyan-glow);
        }

    .logout-button {
        border-color: var(--warning-color);
        color: var(--warning-color);
    }

        .logout-button:hover {
            background: rgba(255,68,68,0.1);
            box-shadow: 0 0 10px rgba(255,68,68,0.3);
        }

    /* Info banner */
    .info-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(0, 255, 242, 0.07);
        border: 1px solid rgba(0, 255, 242, 0.3);
        border-radius: var(--border-radius);
        padding: 12px 16px;
        margin-bottom: 20px;
        color: rgba(0,255,242,0.85);
        font-size: 14px;
    }

        .info-banner i {
            font-size: 18px;
            flex-shrink: 0;
        }

        .info-banner strong {
            color: var(--neon-cyan);
        }

    .section-title {
        color: var(--neon-cyan);
        font-size: 22px;
        margin-bottom: 20px;
        position: relative;
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 3px;
            background: var(--neon-cyan);
            border-radius: 3px;
        }

    /* Toggle switch */
    .add-more-toggle-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: rgba(0,255,242,0.6);
        font-weight: 400;
        margin-left: auto;
        cursor: pointer;
    }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.15);
        border-radius: 22px;
        transition: 0.3s;
        border: 1px solid rgba(0,255,242,0.3);
    }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 2px;
            bottom: 2px;
            background-color: rgba(0,255,242,0.5);
            border-radius: 50%;
            transition: 0.3s;
        }

    input:checked + .toggle-slider {
        background-color: rgba(0,255,242,0.2);
        border-color: var(--neon-cyan);
    }

        input:checked + .toggle-slider:before {
            transform: translateX(18px);
            background-color: var(--neon-cyan);
        }

    /* Disabled form notice */
    .form-disabled-notice {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.03);
        border: 1px dashed rgba(255,255,255,0.15);
        border-radius: var(--border-radius);
        padding: 10px 14px;
        margin-bottom: 16px;
        color: rgba(255,255,255,0.35);
        font-size: 13px;
    }

    .part-info-section, .scrap-entry-section, .review-section {
        margin-bottom: 30px;
        padding: 20px;
        background: var(--card-bg);
        border-radius: var(--border-radius);
        border: 1px solid var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0,255,242,0.15);
    }

    .info-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .info-card {
        background: rgba(0,255,242,0.05);
        padding: 15px;
        border-radius: var(--border-radius);
        border: 1px solid rgba(0,255,242,0.3);
    }

        .info-card label {
            display: block;
            color: var(--neon-cyan);
            font-size: 13px;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-card span {
            display: block;
            color: white;
            font-size: 17px;
            font-weight: 500;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        color: var(--neon-cyan);
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        background: #ffffff;
        border: 1px solid var(--neon-cyan);
        border-radius: 4px;
        color: #000000;
        font-size: 16px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            box-shadow: 0 0 10px var(--neon-cyan-glow);
        }

        .form-control:disabled {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.25);
            cursor: not-allowed;
        }

        .form-control::placeholder {
            color: #666;
            opacity: 0.8;
        }

    .form-help {
        color: #666;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .form-text {
        color: #888;
        font-size: 12px;
        margin-top: 5px;
    }

    /* Machine / Engineering field styling */
    #machineTypeDiv, #machineNumberDiv {
        background: rgba(23,162,184,0.05);
        padding: 12px;
        border-radius: var(--border-radius);
        border: 1px solid rgba(23,162,184,0.3);
    }

    #engineeringPlantDiv {
        background: rgba(108,117,125,0.05);
        padding: 12px;
        border-radius: var(--border-radius);
        border: 1px solid rgba(108,117,125,0.3);
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }

    .action-button {
        padding: 12px 24px;
        border-radius: var(--border-radius);
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        font-size: 15px;
    }

        .action-button.primary-button {
            background: var(--neon-cyan);
            color: #000;
        }

            .action-button.primary-button:hover {
                background: #00ddd0;
                box-shadow: 0 0 15px var(--neon-cyan-glow);
            }

        .action-button.secondary-button {
            background: transparent;
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
        }

            .action-button.secondary-button:hover {
                background: rgba(0,255,242,0.1);
            }

        .action-button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    /* Entry cards */
    .scrap-entry-card {
        margin-bottom: 15px;
        border: 1px solid var(--neon-cyan);
        border-radius: var(--border-radius);
        overflow: hidden;
        transition: all 0.2s ease;
    }

        .scrap-entry-card:hover {
            box-shadow: 0 0 10px var(--neon-cyan-glow);
        }

    .entry-header {
        padding: 15px;
        background: rgba(0,255,242,0.05);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .entry-header:hover {
            background: rgba(0,255,242,0.1);
        }

    .entry-title {
        color: var(--neon-cyan);
        font-weight: bold;
        font-size: 16px;
    }

    .entry-quantity {
        color: var(--neon-cyan);
        font-weight: 500;
    }

    .entry-details {
        display: none;
        padding: 15px;
        background: rgba(0,0,0,0.3);
        border-top: 1px solid var(--neon-cyan);
    }

        .entry-details.visible {
            display: block;
        }

    .entry-detail {
        margin-bottom: 8px;
        color: #ccc;
    }

    .entry-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-edit {
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        background: var(--neon-cyan);
        color: black;
        border: none;
    }

        .btn-edit:hover {
            background: #00ddd0;
        }

    .btn-delete {
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        background: transparent;
        border: 1px solid var(--warning-color);
        color: var(--warning-color);
    }

        .btn-delete:hover {
            background: rgba(255,68,68,0.1);
        }

    .no-entries {
        text-align: center;
        color: #888;
        padding: 40px 20px;
        font-style: italic;
    }

    .totals-section {
        margin: 25px 0;
        padding: 15px;
        border-top: 1px solid var(--neon-cyan);
        border-bottom: 1px solid var(--neon-cyan);
        background: rgba(0,255,242,0.05);
    }

    .total-item {
        display: flex;
        justify-content: space-between;
        color: var(--neon-cyan);
        margin: 8px 0;
        font-size: 16px;
    }

    .total-value {
        font-weight: bold;
    }

    .final-actions {
        margin-top: 20px;
        justify-content: space-between;
    }

        .final-actions .action-button {
            flex: 1;
        }

    .success-message {
        background: rgba(0,255,0,0.1);
        border: 2px solid var(--success-color);
        color: var(--success-color);
        padding: 20px;
        border-radius: var(--border-radius);
        text-align: center;
        margin: 20px 0;
        font-size: 18px;
        font-weight: bold;
    }

    .submission-progress {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.9);
        color: var(--neon-cyan);
        padding: 20px 40px;
        border-radius: 8px;
        border: 2px solid var(--neon-cyan);
        box-shadow: 0 0 25px rgba(0,255,242,0.4);
        z-index: 10000;
        font-weight: 500;
        font-size: 16px;
    }

    .hidden {
        display: none !important;
    }

    @@media (max-width: 768px) {
        .info-cards {
            grid-template-columns: 1fr 1fr;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons, .final-actions {
            flex-direction: column;
        }

        .action-button {
            width: 100%;
        }

        .section-title {
            font-size: 18px;
        }

        .add-more-toggle-label {
            margin-left: 0;
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .info-cards {
            grid-template-columns: 1fr;
        }

        .part-info-section, .scrap-entry-section, .review-section {
            padding: 15px;
        }
    }
</style>


</style>

<script>
    let entries = [];
    let scrapType = 'component';

    const MACHINE_TYPES = [
        { value:"komax",             text:"Komax" },
        { value:"manual",            text:"Manual" },
        { value:"battery",           text:"Battery" },
        { value:"twisting",          text:"Twisting" },
        { value:"wrapshield",        text:"WrapShield" },
        { value:"bonders",           text:"Bonders" },
        { value:"shielded",          text:"Shielded" },
        { value:"sleeves",           text:"Sleeves" },
        { value:"internallogistics", text:"Internal Logistics" },
        { value:"moulding",          text:"Moulding" },
        { value:"combimeter",        text:"Combimeter" },
        { value:"manualcrimping",    text:"Manual Crimping" },
        { value:"weldsplice",        text:"WeldSplice" },
        { value:"bonder",            text:"Bonder" }
    ];

    const NO_MACHINE_NUM = ['manualcrimping','bonder'];

    const MACHINE_NUMBERS = {
        komax: ["K1","K2","K3","K4","K5","K6","K7","K8","K9","K10",
                "K11","K12","K13","K14","K15","K16","K17","K18","K19","K20",
                "K21","K22","K23","K24","K25","K26","K27","K28","K29","K30",
                "M1","M2","M3","M4","M5","M6","M7",
                "AC1","AC2","AC3","AC4","AC5","AC6","AC7","AC8","AC9","AC10",
                "AC11","AC12","AC13","AC14","AC15","AC/AC95","AC95",
                "AC95-1","AC95-2","AC95-3","AC95-4"],
        manual:             ["M1","M2","M3","M4","M5","M6","M7","M8","M9","M10","M11","M12","M13","M14","M15"],
        battery:            ["B1","B2","B3","B4","B5","B6","B7","B8","B9","B10","B11"],
        twisting: ["Tw1","Tw2","Tw3","Tw4","Tw5","Tw6","Tw7","Tw8","Tw9","Tw10",
                   "Tw11","Tw12","Tw13","Tw14","Tw15","Tw16","Tw17","Tw18","Tw19","Tw20",
                   "Tw21","Tw22","Tw23","Tw24","Tw25","Tw26","Tw27","Tw28","Tw29","Tw30",
                   "Tw31","Tw32","Tw33","Tw34","Tw35","Tw36","Tw37","Tw38","Tw39","Tw40",
                   "Tw41","Tw42","Tw43","Tw44","Tw45","Tw46","Tw47","Tw48","Tw49","Tw50"],
        wrapshield:         ["W1","W2","W3","W4","W5"],
        bonders:            ["Bm1","Bm2","Bm3","Bm4","Bm5"],
        shielded:   ["Sc1","Sc2","Sc3","Sc4","Sc5","Sc6","Sc7",
                     "Cutting Machine","Cut down","Stripping Machine"],
        sleeves:            ["Extrusion","Sleeve-Cutting"],
        internallogistics:  ["Feeders","Chasers"],
        moulding:           ["Moulding"],
        combimeter:         ["481D","Segment","TFT"],
        weldsplice: ["M1","M2","M3","M4","M5","M6","M7","M8","M9","M10"]
    };

    const SECTIONS = [
        { value:"1",  text:"Production" },   { value:"2",  text:"CombiMeter" },
        { value:"3",  text:"Moulding" },     { value:"4",  text:"Sleeve" },
        { value:"5",  text:"Ground" },       { value:"6",  text:"Battery" },
        { value:"7",  text:"Rework" },       { value:"8",  text:"Pre-Assembly Ford" },
        { value:"9",  text:"Pre-Assembly Isuzu" }, { value:"10", text:"Pre-Assembly Csuv" },
        { value:"11", text:"Pre-Assembly TSAM" },  { value:"12", text:"Engineering" }, { value:"13", text:"SQA" },
        { value:"14", text:"STORES" }, { value:"15", text:"PROCESS" }, { value:"16", text:"QUALITY" }, { value:"17", text:"PURCHASING" }
    ];

    const COMBIMETER_POSITIONS = [
        "AMBIENT PRISM","BEZEL","BARCODE LABEL","CASE","COMBI METER","DIAL HOLDER",
        "DISPLAY LCD","FRONT GLASS","FUEL POINTER","ID LABEL","LCD PRISM","LCD",
        "MODULE CASE","PCB ASSY","REAR COVER","RING","RUBBER BUSH","SPEED METER",
        "SPEED PRISM","SPEED SCREW","TEMPO POINTER","TRIP POINTER PCB ASSY",
        "TRIP KNOB","STEPPER MOTOR"
    ];

        const SLEEVE_POSITIONS = [
        "COT start up/set up",
        "COT production quality (hard/soft sleeve)",
        "COT production quality (wall thickness)",
        "COT Production quality (hole on sleeve)",
        "COT Purging",
        "VOB Purging",
        "VOB start up/diameter change",
        "VOB Production (wall thickness)",
        "VOB Production (hole on sleeve)"
    ];

    // Init
    document.addEventListener('DOMContentLoaded', function() {
        const params = new URLSearchParams(window.location.search);
        scrapType = params.get('scrapType')?.toLowerCase() || 'component';

        const dept = document.getElementById('department')?.textContent?.trim().toUpperCase();
        const sel  = document.getElementById('scrapSection');
        sel.innerHTML = '<option value="">Select section...</option>';

        let toShow = SECTIONS;
        if      (dept === 'FORD')  toShow = SECTIONS.filter(s => ["1","5","8"].includes(s.value));
        else if (dept === 'ISUZU') toShow = SECTIONS.filter(s => ["1","6","9"].includes(s.value));

        toShow.forEach(s => {
            const o = document.createElement('option');
            o.value = s.value; o.textContent = s.text;
            sel.appendChild(o);
        });

        sel.addEventListener('change', onSectionChange);
        document.getElementById('machineType').addEventListener('change', onMachineTypeChange);
        document.getElementById('scrapReason').addEventListener('change', updateNextBtn);
        document.getElementById('engineeringPlant')?.addEventListener('change', updateNextBtn);
        document.getElementById('partPosition')?.addEventListener('change', updateNextBtn);
        document.getElementById('machineNumber')?.addEventListener('change', updateNextBtn);

        loadSavedEntries();
        renderEntryList();
    });

    async function onSectionChange() {
        const sId = document.getElementById('scrapSection').value;
        const rSel = document.getElementById('scrapReason');

        rSel.innerHTML = '<option value="">Loading reasons...</option>';
        rSel.disabled = true;

        ['machineTypeDiv','machineNumberDiv','engineeringPlantDiv','positionDiv'].forEach(id => {
            document.getElementById(id)?.classList.add('hidden');
        });
        document.getElementById('machineType').value = '';
        document.getElementById('machineNumber').value = '';

        if (!sId) {
            rSel.innerHTML = '<option value="">Select section first...</option>';
            updateNextBtn();
            return;
        }

        if (["8","9","10","11"].includes(sId)) {
            document.getElementById('machineTypeDiv').classList.remove('hidden');
            const mt = document.getElementById('machineType');
            mt.innerHTML = '<option value="">Select machine type...</option>';
            MACHINE_TYPES.forEach(m => {
                const o = document.createElement('option');
                o.value = m.value; o.textContent = m.text;
                mt.appendChild(o);
            });
        }

        if (sId === "12") {
            document.getElementById('engineeringPlantDiv').classList.remove('hidden');
            document.getElementById('engineeringPlant').value = '';
        }

    if (sId === "2" || sId === "4") {
        document.getElementById('positionDiv').classList.remove('hidden');
        const pp = document.getElementById('partPosition');
        pp.innerHTML = '<option value="">Select position...</option>';
        const positionList = sId === "2" ? COMBIMETER_POSITIONS : SLEEVE_POSITIONS;
        positionList.forEach(p => {
            const o = document.createElement('option');
            o.value = p; o.textContent = p;
            pp.appendChild(o);
        });
    }

        // Fetch reasons live from the database instead of the hardcoded REASONS object
    try {
        const res = await fetch(`/Operator/GetScrapReasonsBySection?sectionId=${sId}`);
        const data = await res.json();

        rSel.innerHTML = '<option value="">Select reason...</option>';

        if (data.success && Array.isArray(data.data)) {
            const groups = { Component: [], Wire: [], Other: [] };
            data.data.forEach(r => {
                const key = r.category === 'Component' ? 'Component'
                          : r.category === 'Wire'      ? 'Wire'
                          : 'Other';
                groups[key].push(r);
            });

            function addGroup(label, items) {
                if (items.length === 0) return;
                const og = document.createElement('optgroup');
                og.label = label;
                items.forEach(r => {
                    const o = document.createElement('option');
                    o.value = r.value;
                    o.textContent = r.text;
                    og.appendChild(o);
                });
                rSel.appendChild(og);
            }

            // Sections with no categorized reasons render flat, same as before
            if (groups.Component.length === 0 && groups.Wire.length === 0) {
                data.data.forEach(r => {
                    const o = document.createElement('option');
                    o.value = r.value; o.textContent = r.text;
                    rSel.appendChild(o);
                });
            } else {
                addGroup('COMPONENT / CONNECTOR REASONS', groups.Component);
                addGroup('WIRE REASONS', groups.Wire);
                addGroup('OTHER', groups.Other);
            }
        } else {
            rSel.innerHTML = '<option value="">No reasons found</option>';
        }
    } catch (e) {
        rSel.innerHTML = '<option value="">Error loading reasons</option>';
        console.error('Failed to load scrap reasons:', e);
    }

        rSel.disabled = false;
        updateNextBtn();
    }

    function onMachineTypeChange() {
        const mtVal = document.getElementById('machineType').value;
        const mnDiv = document.getElementById('machineNumberDiv');
        const mnSel = document.getElementById('machineNumber');

        if (!mtVal || NO_MACHINE_NUM.includes(mtVal)) {
            mnDiv.classList.add('hidden');
            mnSel.value = '';
            updateNextBtn();
            return;
        }

        mnSel.innerHTML = '<option value="">Select machine number...</option>';
        (MACHINE_NUMBERS[mtVal] || []).forEach(n => {
            const o = document.createElement('option');
            o.value = n; o.textContent = n;
            mnSel.appendChild(o);
        });
        mnDiv.classList.remove('hidden');
        updateNextBtn();
    }

    function validateStep1() {
        const sId  = document.getElementById('scrapSection').value;
        const rVal = document.getElementById('scrapReason').value;
        if (!sId || !rVal) return false;

        if (["8","9","10","11"].includes(sId)) {
            const mt = document.getElementById('machineType').value;
            if (!mt) return false;
            if (!NO_MACHINE_NUM.includes(mt) && !document.getElementById('machineNumber').value) return false;
        }

    if (sId === "12" && !document.getElementById('engineeringPlant').value) return false;
    if ((sId === "2" || sId === "4") && !document.getElementById('partPosition').value) return false;

        return true;
    }

    function updateNextBtn() {
        const btn = document.getElementById('toStep2Btn');
        if (btn) btn.disabled = !validateStep1();
    }

    function goToStep2() {
        if (!validateStep1()) return;

        const sId  = document.getElementById('scrapSection').value;
        const rSel = document.getElementById('scrapReason');
        const sSel = document.getElementById('scrapSection');
        const rText = rSel.options[rSel.selectedIndex]?.text || '';
        const sText = sSel.options[sSel.selectedIndex]?.text || '';
        const mt    = document.getElementById('machineType').value;
        const mn    = document.getElementById('machineNumber').value;
        const ep    = document.getElementById('engineeringPlant').value;
        const pp    = document.getElementById('partPosition').value;

        document.getElementById('selectedReasonLabel').textContent = rText;

        let chips = `<span class="chip-item">${sText}</span>`;
        if (mt) chips += `<span class="chip-item">${MACHINE_TYPES.find(m=>m.value===mt)?.text||mt}</span>`;
        if (mn) chips += `<span class="chip-item">${mn}</span>`;
        if (ep) chips += `<span class="chip-item">${ep}</span>`;
        if (pp) chips += `<span class="chip-item">${pp}</span>`;
        chips += `<span class="chip-item" style="color:#1a1a2e;border-color:#428bca;">${rText}</span>`;

        document.getElementById('selectionSummary').innerHTML = chips;
    document.getElementById('quantity').value = 1;

    const lengthDiv = document.getElementById('lengthDiv');
    const lengthInput = document.getElementById('lengthCm');
    lengthDiv.classList.add('hidden');
    lengthInput.value = '';

    const weightDiv = document.getElementById('weightDiv');
    const weightInput = document.getElementById('weightKg');
    if ((sId === "3" || sId === "4") && mt !== 'shielded') {
        weightDiv.classList.remove('hidden');
        weightInput.value = '';
    } else {
        weightDiv.classList.add('hidden');
        weightInput.value = '';
    }

    const qtyBlock = document.getElementById('qtyBlock');
    if (mt === 'shielded') {
        qtyBlock.classList.add('hidden');
        document.getElementById('quantity').value = 1; // backend still stores a qty
    } else {
        qtyBlock.classList.remove('hidden');
    }

    // Pre-fill if editing
    if (editingIndex >= 0) {
        const e = entries[editingIndex];
        document.getElementById('quantity').value = e.quantity;
        if ((sId === "3" || sId === "4") && mt !== 'shielded' && e.weight > 0) {
            weightInput.value = e.weight;
        }
    }

    showStep(2);
    }

    function goToStep1() {
        editingIndex = -1;
        showStep(1);
    }

    function addAnotherReason() {
        document.getElementById('scrapSection').value = '';
        const rSel = document.getElementById('scrapReason');
        rSel.innerHTML = '<option value="">Select section first...</option>';
        rSel.disabled = true;
        ['machineTypeDiv','machineNumberDiv','engineeringPlantDiv','positionDiv'].forEach(id => {
            document.getElementById(id)?.classList.add('hidden');
        });
        updateNextBtn();
        showStep(1);
    }

    function showStep(n) {
        ['step1','step2','step3'].forEach((id,i) => {
            document.getElementById(id)?.classList.toggle('hidden', i+1 !== n);
        });
        ['step-ind-1','step-ind-2','step-ind-3'].forEach((id,i) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('active','done');
            if (i+1 === n) el.classList.add('active');
            if (i+1 <  n)  el.classList.add('done');
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

        function scanNewPart() {
        if (entries.length > 0) {
            if (!confirm('You have ' + entries.length + ' unsaved entry(ies) that have NOT been submitted.\n\nThey will be saved and you can come back to submit them.\n\nGo to scan a new part?')) {
                return;
            }
        }
        window.location.href = '/Operator/ScanPart';
    }

    function changeQty(delta) {
        const inp = document.getElementById('quantity');
        inp.value = Math.max(1, (parseInt(inp.value) || 0) + delta);
    }

    function addEntryAndContinue() {
        const sSel = document.getElementById('scrapSection');
        const rSel = document.getElementById('scrapReason');
        const sId  = sSel.value;
        const mt   = document.getElementById('machineType').value;

        // Quantity — Shielded doesn't track piece count, defaults to 1
        let qty;
        if (mt === 'shielded') {
            qty = 1;
        } else {
            qty = parseInt(document.getElementById('quantity').value);
            if (!qty || qty < 1) { alert('Please enter a valid quantity'); return; }
        }

        // Length — no longer captured for Shielded at all
        let lengthVal = 0;

        // Weight — required for Moulding (3) / Sleeve (4) only; not for Shielded
    // Weight — optional for Moulding (3) / Sleeve (4); operator decides whether to capture it
    let weightVal = 0;
    if ((sId === "3" || sId === "4") && mt !== 'shielded') {
        const weightInput = document.getElementById('weightKg').value;
        if (weightInput) {
            weightVal = parseFloat(weightInput);
            if (isNaN(weightVal) || weightVal < 0) {
                alert('Please enter a valid weight in kg');
                document.getElementById('weightKg').focus();
                return;
            }
        }
    }

        const newEntry = {
            partNumber:       document.getElementById('partNumber')?.textContent?.trim() || '',
            department:       document.getElementById('department')?.textContent?.trim() || '',
            line:             document.getElementById('line')?.textContent?.trim() || '',
            shift:            document.getElementById('shift')?.textContent?.trim() || '',
            scrapSectionId:   parseInt(sId),
            sectionName:      sSel.options[sSel.selectedIndex]?.text || '',
            reasonId:         parseInt(rSel.value),
            scrapReason:      rSel.options[rSel.selectedIndex]?.text || '',
            position: (sId === "2" || sId === "4") ? (document.getElementById('partPosition').value || "") : "",
            machineType:      mt || "",
            machineNumber:    document.getElementById('machineNumber').value || "",
            engineeringPlant: document.getElementById('engineeringPlant').value || "",
            quantity:         qty,
            scrapType,
            weight: weightVal, hasWeight: weightVal > 0, length: lengthVal,
            stockUom:     document.getElementById('stockUom')?.value || 'EA',
            materialCost: parseFloat(document.getElementById('materialCost')?.value) || 0,
            partCategory: document.getElementById('partCategory')?.value || '',
            plant:        document.getElementById('plant')?.value || '',
            company:      document.getElementById('company')?.value || 'B',
            timestamp:    new Date().toISOString()
        };

        if (editingIndex >= 0) {
            entries[editingIndex] = newEntry;
            editingIndex = -1;
        } else {
            entries.push(newEntry);
        }

        saveToStorage();
        renderEntryList();
        showStep(3);
    }

    function renderEntryList() {
        const container = document.getElementById('entryList');
        if (!container) return;

        if (entries.length === 0) {
            container.innerHTML = '<div class="no-entries-msg">No entries yet.</div>';
            document.getElementById('totalItems').textContent = '0';
            document.getElementById('totalQty').textContent   = '0';
            document.getElementById('clearAllBtn')?.remove();
            return;
        }

        let totalQty = 0;
        container.innerHTML = entries.map((e, i) => {
            totalQty += e.quantity;
            const machineInfo = e.machineType
                ? `<span class="entry-machine">${e.machineType.toUpperCase()}${e.machineNumber ? ' — ' + e.machineNumber : ''}</span>`
                : '';
            const plantInfo   = e.engineeringPlant ? `<span class="entry-machine">${e.engineeringPlant}</span>` : '';
            const posInfo     = e.position         ? `<span class="entry-machine">${e.position}</span>`         : '';
                const lengthInfo  = e.length > 0       ? `<span class="entry-machine">${e.length} cm</span>`         : '';
    const weightInfo  = e.weight > 0       ? `<span class="entry-machine">${e.weight} kg</span>`          : '';
            return `
            <div class="entry-card">
                <div class="entry-row">
                    <div style="flex:1;min-width:0;cursor:pointer;" onclick="editEntry(${i})">
                        <div class="entry-reason">${e.scrapReason}</div>
                        <div style="display:flex;gap:6px;margin-top:4px;flex-wrap:wrap;align-items:center;">
                            <span class="entry-section-tag">${e.sectionName}</span>
                            ${machineInfo}${plantInfo}${posInfo}${lengthInfo}${weightInfo}
                        </div>
                    </div>
                    <span class="entry-qty-badge">Qty: ${e.quantity}</span>
                    <button class="entry-edit" onclick="editEntry(${i})" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="entry-delete" onclick="deleteEntry(${i})" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>`;
        }).join('');

        document.getElementById('totalItems').textContent = entries.length;
        document.getElementById('totalQty').textContent   = totalQty;

        addClearAllButton();
    }

    function addClearAllButton() {
        if (document.getElementById('clearAllBtn')) return;

        const btn = document.createElement('button');
        btn.id = 'clearAllBtn';
        btn.className = 'btn-back';
        btn.style.cssText = 'border-color:#dc3545;color:#dc3545;width:100%;justify-content:center;margin-top:10px;';
        btn.innerHTML = '<i class="bi bi-trash3"></i> Clear All Entries';
        btn.onclick = clearAllEntries;

        const totalsRow = document.querySelector('.totals-row');
        if (totalsRow) totalsRow.insertAdjacentElement('afterend', btn);
    }

    function clearAllEntries() {
        if (!confirm('Remove all ' + entries.length + ' entries? This cannot be undone.')) return;
        entries = [];
        saveToStorage();
        renderEntryList();
        showStep(1);
    }


    let editingIndex = -1;

    async function editEntry(index) {
        const e = entries[index];
        editingIndex = index;

        // Populate Step 1 fields
        document.getElementById('scrapSection').value = e.scrapSectionId;
        await onSectionChange();   // wait for reasons to actually load before selecting one

        document.getElementById('scrapReason').value = e.reasonId;

        if (e.machineType) {
            document.getElementById('machineType').value = e.machineType;
            onMachineTypeChange();
            setTimeout(() => {
                if (e.machineNumber) document.getElementById('machineNumber').value = e.machineNumber;
                updateNextBtn();
            }, 50);
        }
        if (e.engineeringPlant) document.getElementById('engineeringPlant').value = e.engineeringPlant;
        if (e.position) document.getElementById('partPosition').value = e.position;

        updateNextBtn();
        showStep(1);
    }



    function deleteEntry(index) {
        if (!confirm('Remove this entry?')) return;
        entries.splice(index, 1);
        saveToStorage();
        renderEntryList();
        if (entries.length === 0) showStep(1);
    }

    function getStorageKey() {
        const clockNumber = '@User.Identity?.Name' || 'unknown';
        return 'scrapEntries_' + clockNumber;
    }

    function saveToStorage() {
        try {
            const d = JSON.stringify(entries);
            const key = getStorageKey();
            sessionStorage.setItem(key, d);
            localStorage.setItem(key, d);
        } catch(e) {}
    }

    function loadSavedEntries() {
        try {
            const key = getStorageKey();
            const d = sessionStorage.getItem(key) || localStorage.getItem(key);
            if (d) {
                const arr = JSON.parse(d);
                if (Array.isArray(arr) && arr.length > 0) {
                    entries = arr;
                    renderEntryList();
                    showPendingIndicator(entries.length);
                    showPendingPromptBanner();
                }
            }
        } catch(e) {}
        showStep(1);
    }


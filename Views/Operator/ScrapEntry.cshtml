    function deleteEntryFromModal(index) {
        if (!confirm('Remove this entry?')) return;
        entries.splice(index, 1);
        saveToStorage();
        // Refresh modal
        document.getElementById('pendingModal')?.remove();
        if (entries.length > 0) {
            showPendingPartsModal();
            showPendingIndicator(entries.length);
        } else {
            document.getElementById('pendingIndicatorBtn').style.display = 'none';
        }
    }

    function discardAll() {
        if (!confirm('Discard ALL ' + entries.length + ' saved entries?')) return;
        clearStorage();
        document.getElementById('pendingModal')?.remove();
        document.getElementById('pendingIndicatorBtn').style.display = 'none';
        renderEntryList();
    }

    function goToSubmit() {
        document.getElementById('pendingModal')?.remove();
        renderEntryList();
        showStep(3);
    }


@model ScrapEntryViewModel
@{
    ViewData["Title"] = "HESTO Harnesses - Scrap Entry";
    Layout = "_TeamLeaderLayout";
}

<div class="wizard-container">

    <!-- Top Bar -->
    <div class="top-bar">
        <button onclick="navigateHome()" class="top-btn home-btn">
            <i class="bi bi-house-fill"></i> Home
        </button>
        <div class="part-pill">
            <i class="bi bi-upc-scan"></i>
            <strong>@Model.PartNumber</strong>
            <span class="dept-text">@Model.Department &bull; @Model.Line &bull; Shift @Model.Shift</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
            <!-- Pending entries indicator — shown by JS when there are saved entries -->
            <button id="pendingIndicatorBtn"
                    onclick="showPendingPartsModal()"
                    style="display:none;
                       background:linear-gradient(135deg,#ffc107,#fd7e14);
                       border:none;border-radius:8px;
                       color:white;padding:8px 14px;
                       font-size:13px;font-weight:700;
                       cursor:pointer;
                       display:none;
                       align-items:center;gap:6px;
                       white-space:nowrap;
                       box-shadow:0 2px 8px rgba(255,193,7,0.4);
                       transition:all 0.2s;"
                    onmouseover="this.style.transform='scale(1.03)'"
                    onmouseout="this.style.transform='scale(1)'">
                <i class="bi bi-clock-history"></i>
                <span id="pendingIndicatorCount">0</span> pending
            </button>
            <form action="/Account/Logout" method="post" style="margin:0;" id="logoutForm">
                <input type="hidden" value="@User.Identity?.Name" />
                @Html.AntiForgeryToken()
                <button type="submit" class="top-btn logout-btn">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- Hidden fields -->
    <input type="hidden" id="materialCost" value="@Model.MaterialCost.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
    <input type="hidden" id="stockUom" value="@Model.StockUom" />
    <input type="hidden" id="partCategory" value="@Model.PartCategory" />
    <input type="hidden" id="plant" value="@Model.Plant" />
    <input type="hidden" id="company" value="@Model.Company" />
    <span id="partNumber" style="display:none;">@Model.PartNumber</span>
    <span id="department" style="display:none;">@Model.Department</span>
    <span id="line" style="display:none;">@Model.Line</span>
    <span id="shift" style="display:none;">@Model.Shift</span>

    <!-- STEP INDICATOR -->
    <div class="steps-bar" id="stepsBar">
        <div class="step active" id="step-ind-1">
            <div class="step-circle">1</div>
            <div class="step-label">Select Reason</div>
        </div>
        <div class="step-line"></div>
        <div class="step" id="step-ind-2">
            <div class="step-circle">2</div>
            <div class="step-label">Quantity</div>
        </div>
        <div class="step-line"></div>
        <div class="step" id="step-ind-3">
            <div class="step-circle">3</div>
            <div class="step-label">Review &amp; Submit</div>
        </div>
    </div>

    <!-- STEP 1: SELECT SECTION + REASON -->
    <div class="wizard-card" id="step1">
        <div class="card-heading">
            <span class="card-num">1</span>
            <div>
                <h2>What went wrong?</h2>
                <p>Select the area and reason for the scrap</p>
            </div>
        </div>

        <div class="field-row">
            <div class="field-block">
                <label for="scrapSection">Scrap Section</label>
                <select id="scrapSection" class="sel">
                    <option value="">Select section...</option>
                </select>
            </div>

            <div class="field-block hidden" id="machineTypeDiv">
                <label for="machineType"><i class="bi bi-gear-fill"></i> Machine Type</label>
                <select id="machineType" class="sel accent-sel">
                    <option value="">Select machine type...</option>
                </select>
            </div>

            <div class="field-block hidden" id="machineNumberDiv">
                <label for="machineNumber"><i class="bi bi-hash"></i> Machine Number</label>
                <select id="machineNumber" class="sel accent-sel">
                    <option value="">Select machine number...</option>
                </select>
            </div>

            <div class="field-block hidden" id="engineeringPlantDiv">
                <label for="engineeringPlant"><i class="bi bi-building"></i> Plant</label>
                <select id="engineeringPlant" class="sel eng-sel">
                    <option value="">Select plant...</option>
                    <option value="Plant A">Plant A</option>
                    <option value="Plant B">Plant B</option>
                    <option value="Plant C">Plant C</option>
                    <option value="Fielli">Fielli</option>
                </select>
            </div>

            <div class="field-block" id="reasonBlock">
                <label for="scrapReason">Scrap Reason</label>
                <select id="scrapReason" class="sel" disabled>
                    <option value="">Select section first...</option>
                </select>
            </div>

            <div class="field-block hidden" id="positionDiv">
                <label for="partPosition">Position</label>
                <select id="partPosition" class="sel">
                    <option value="">Select position...</option>
                </select>
            </div>
        </div>

        <div class="step-footer">
            <button class="btn-next" id="toStep2Btn" onclick="goToStep2()" disabled>
                Next: Enter Quantity <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- STEP 2: QUANTITY -->
    <div class="wizard-card hidden" id="step2">
        <div class="card-heading">
            <span class="card-num">2</span>
            <div>
                <h2>How many pieces?</h2>
                <p>Enter the quantity for <strong id="selectedReasonLabel"></strong></p>
            </div>
        </div>

        <div class="summary-chip" id="selectionSummary"></div>

        <div class="qty-block" id="qtyBlock">
            <label for="quantity">Quantity</label>
            <div class="qty-row">
                <button type="button" class="qty-stepper" onclick="changeQty(-1)">&#8722;</button>
                <input type="number" id="quantity" class="qty-input" min="1" value="1" />
                <button type="button" class="qty-stepper" onclick="changeQty(1)">+</button>
            </div>
        </div>

        <div class="field-block hidden" id="lengthDiv" style="max-width:240px;margin:0 auto 20px;">
            <label for="lengthCm"><i class="bi bi-rulers"></i> Length (cm)</label>
            <input type="number" id="lengthCm" class="sel" min="0" step="0.1" placeholder="Enter length in cm" />
        </div>

        <div class="field-block hidden" id="weightDiv" style="max-width:240px;margin:0 auto 20px;">
            <label for="weightKg"><i class="bi bi-speedometer"></i> Weight (kg)</label>
            <input type="number" id="weightKg" class="sel" min="0" step="0.01" placeholder="Enter weight in kg (optional)" />
        </div>

        <div class="step-footer two-btns">
            <button class="btn-back" onclick="goToStep1()">
                <i class="bi bi-arrow-left"></i> Back
            </button>
            <button class="btn-next" id="addEntryBtn" onclick="addEntryAndContinue()">
                <i class="bi bi-plus-circle-fill"></i> Add to List
            </button>
        </div>
    </div>

    <!-- STEP 3: REVIEW & SUBMIT -->
    <div class="wizard-card hidden" id="step3">
        <div class="card-heading">
            <span class="card-num">3</span>
            <div>
                <h2>Review &amp; Submit</h2>
                <p>Check your entries then submit</p>
            </div>
        </div>

        <div id="entryList"></div>

        <div class="totals-row">
            <div class="total-chip">
                <span>Total Entries</span>
                <strong id="totalItems">0</strong>
            </div>
            <div class="total-chip">
                <span>Total Qty</span>
                <strong id="totalQty">0</strong>
            </div>
        </div>

        <div class="step-footer" style="display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; justify-content:space-between; gap:10px;">
                <button class="btn-back" onclick="addAnotherReason()">
                    <i class="bi bi-plus"></i> Add Reason (Same Part)
                </button>
                <button class="btn-submit" id="submitAllBtn" onclick="handleSubmitAll()">
                    <i class="bi bi-check-circle-fill"></i> Submit All
                </button>
            </div>
            <!-- This is the one that goes to ScanPart -->
            <button class="btn-scan-new" onclick="scanNewPart()">
                <div class="scan-new-icon">
                    <i class="bi bi-upc-scan"></i>
                </div>
                <div class="scan-new-text">
                    <span class="scan-new-title">Scan / Add New Part</span>
                    <span class="scan-new-sub">Scan a different part number for a new scrap entry</span>
                </div>
                <div class="scan-new-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </button>
        </div>
    </div>

    <!-- SUCCESS STATE -->
    <div class="wizard-card success-card hidden" id="successCard">
        <div class="success-icon">&#x2705;</div>
        <h2>Submitted!</h2>
        <p>All scrap entries have been saved successfully.</p>

        <div id="printLabelPrompt" style="
        margin-top:20px;padding:16px;
        background:rgba(255,193,7,0.12);border:2px solid #ffc107;
        border-radius:12px;text-align:left;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <i class="bi bi-printer-fill" style="font-size:22px;color:#fd7e14;"></i>
                <strong style="color:#1a1a2e;font-size:15px;">Weigh &amp; print label for Batch #<span id="successBatchId">—</span></strong>
            </div>
            <p style="font-size:13px;color:#6c757d;margin-bottom:14px;line-height:1.5;">
                If the physical scrap for this batch is ready, weigh it and print its location label now.
                Only print once <strong>all</strong> scrap for this batch has been captured above — a weight
                can no longer be recorded without a matching scrap submission.
            </p>
            <button class="btn-next" style="width:100%;justify-content:center;" onclick="confirmAndOpenPrintModal()">
                <i class="bi bi-printer"></i> Weigh &amp; Print Label
            </button>
        </div>

        <div class="step-footer two-btns" style="justify-content:center;gap:1rem;margin-top:1.5rem;">
            <button class="btn-back" onclick="window.location.href='/Operator/ScrapHistory'">
                <i class="bi bi-clock-history"></i> View History
            </button>
            <button class="btn-next" onclick="window.location.href='/Operator/ScanPart'">
                <i class="bi bi-upc-scan"></i> New Part
            </button>
        </div>
    </div>

    <!-- Blocking confirmation before weighing/printing -->
    <div id="scrapConfirmModal" style="
    display:none; position:fixed; top:0; left:0;
    width:100vw; height:100vh; background:rgba(0,0,0,0.85);
    z-index:100000; align-items:center; justify-content:center; padding:16px;">
        <div style="background:#1e293b;border:2px solid #ffc107;border-radius:12px;
                max-width:420px;width:100%;padding:24px;box-shadow:0 25px 50px rgba(0,0,0,0.8);">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size:26px;color:#ffc107;"></i>
                <h5 style="color:white;margin:0;font-size:17px;">Confirm Before Printing</h5>
            </div>
            <p style="color:#cbd5e1;font-size:14px;line-height:1.6;margin-bottom:20px;">
                Have you captured <strong style="color:#ffc107;">ALL</strong> the scrap for this batch?
                <br><br>
                Once you weigh and print this label, the weight will be recorded against
                <strong style="color:#93c5fd;">Batch #<span id="confirmBatchId"></span></strong> only,
                and cannot be linked to any scrap added afterwards.
            </p>
            <div style="display:flex;gap:10px;">
                <button onclick="closeScrapConfirmModal()" style="
                flex:1;background:transparent;border:2px solid #475569;color:#94a3b8;
                padding:11px;border-radius:8px;cursor:pointer;font-weight:600;font-size:14px;">
                    No, I still have scrap to add
                </button>
                <button onclick="proceedToWeighAfterConfirm()" style="
                flex:1;background:#28a745;border:2px solid #28a745;color:white;
                padding:11px;border-radius:8px;cursor:pointer;font-weight:700;font-size:14px;">
                    Yes, Weigh &amp; Print
                </button>
            </div>
        </div>
    </div>

    <!-- Print Location Label Modal (moved here from Index.cshtml) -->
    <div id="printLocationModal" style="
    display:none; position:fixed; top:0; left:0;
    width:100vw; height:100vh; background:rgba(0,0,0,0.85);
    z-index:99999; align-items:center; justify-content:center;
    padding:16px; box-sizing:border-box; overflow-y:auto;">

        <div style="
        background:#1e293b; border:2px solid #428bca; border-radius:12px;
        width:100%; max-width:460px; margin:auto;
        box-shadow:0 25px 50px rgba(0,0,0,0.8);
        display:flex; flex-direction:column;
        height:calc(100vh - 32px); max-height:600px;
        overflow:hidden;">

            <div style="
            background:linear-gradient(135deg,#2563eb,#3b82f6);
            padding:1rem 1.25rem;
            display:flex; justify-content:space-between; align-items:center;
            flex-shrink:0;">
                <h5 style="color:white; margin:0; font-size:16px; font-weight:700;
                   display:flex; align-items:center; gap:8px;">
                    <i class="bi bi-printer"></i> Print Location Label — Batch #<span id="modalBatchId"></span>
                </h5>
                <button onclick="closePrintLocationModal()" style="
                background:rgba(255,255,255,0.15); border:none; color:white;
                width:32px; height:32px; border-radius:50%; cursor:pointer;
                font-size:16px; display:flex; align-items:center; justify-content:center;
                line-height:1; flex-shrink:0;">
                    ✕
                </button>
            </div>

            <div style="padding:1.25rem; overflow-y:auto; flex:1; min-height:0;">
                <div style="
                background:rgba(66,139,202,0.15); border:1px solid rgba(66,139,202,0.4);
                border-radius:8px; padding:0.6rem 0.75rem; margin-bottom:1rem;
                font-size:12px; color:#93c5fd; line-height:1.4;
                display:flex; align-items:flex-start; gap:6px;">
                    <i class="bi bi-info-circle" style="flex-shrink:0; margin-top:1px;"></i>
                    <span>Label attaches to physical scrap for location traceability.</span>
                </div>

                <div style="margin-bottom:0.875rem;">
                    <label style="display:block; font-weight:600; font-size:11px;
                color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                        Printer *
                    </label>
                    <select id="locationPrinterSelect" style="
                width:100%; padding:10px 12px; background:#334155;
                border:2px solid #428bca; border-radius:8px;
                color:white; font-size:14px; box-sizing:border-box;
                appearance:none; cursor:pointer;">
                        <option value="">Loading printers...</option>
                    </select>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.875rem;">
                    <div>
                        <label style="display:block; font-weight:600; font-size:11px;
                    color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                            Department
                        </label>
                        <input type="text" id="locationDept" readonly style="
                    width:100%; padding:10px 12px; background:#0f172a;
                    border:2px solid #334155; border-radius:8px;
                    color:#64748b; font-size:13px; box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block; font-weight:600; font-size:11px;
                    color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                            Line
                        </label>
                        <input type="text" id="locationLine" readonly style="
                    width:100%; padding:10px 12px; background:#0f172a;
                    border:2px solid #334155; border-radius:8px;
                    color:#64748b; font-size:13px; box-sizing:border-box;" />
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.875rem;">
                    <div>
                        <label style="display:block; font-weight:600; font-size:11px;
                    color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                            Shift
                        </label>
                        <input type="text" id="locationShift" readonly style="
                    width:100%; padding:10px 12px; background:#0f172a;
                    border:2px solid #334155; border-radius:8px;
                    color:#64748b; font-size:13px; box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block; font-weight:600; font-size:11px;
                    color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                            Machine No. <span style="color:#475569;font-weight:400;text-transform:none;">(optional)</span>
                        </label>
                        <input type="text" id="locationMachine" style="
                    width:100%; padding:10px 12px; background:#334155;
                    border:2px solid #475569; border-radius:8px;
                    color:white; font-size:13px; box-sizing:border-box;" />
                    </div>
                </div>

                <div style="margin-bottom:0.875rem;">
                    <label style="display:block; font-weight:600; font-size:11px;
                color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                        Weight (kg) *
                    </label>
                    <div style="position:relative;">
                        <input type="number" id="locationWeight" step="0.001" min="0.001"
                               placeholder="0.000" style="
                    width:100%; padding:10px 48px 10px 12px; background:#334155;
                    border:2px solid #428bca; border-radius:8px;
                    color:white; font-size:15px; box-sizing:border-box;
                    font-weight:600;" />
                        <span style="
                    position:absolute; right:12px; top:50%; transform:translateY(-50%);
                    color:#64748b; font-size:13px; font-weight:600;
                    pointer-events:none;">kg</span>
                    </div>
                </div>

                <div style="margin-bottom:0.875rem;">
                    <label style="display:block; font-weight:600; font-size:11px;
                color:#94a3b8; text-transform:uppercase; letter-spacing:.6px; margin-bottom:0.3rem;">
                        Notes <span style="color:#475569; font-weight:400; text-transform:none;">(optional)</span>
                    </label>
                    <input type="text" id="locationNotes" placeholder="e.g. Morning batch, Rework scrap..." style="
                width:100%; padding:10px 12px; background:#334155;
                border:2px solid #475569; border-radius:8px;
                color:white; font-size:14px; box-sizing:border-box;" />
                </div>

                <div id="printLocationError" style="
            display:none; background:rgba(220,53,69,0.15);
            border:1px solid #dc3545; border-radius:8px;
            padding:0.75rem; color:#f87171; font-size:13px;
            line-height:1.4;">
                </div>
            </div>

            <div style="
        padding:0.875rem 1.25rem;
        border-top:1px solid rgba(66,139,202,0.2);
        display:flex; gap:0.75rem; flex-shrink:0;">
                <button onclick="closePrintLocationModal()" style="
            flex:1; background:transparent; border:2px solid #475569;
            color:#94a3b8; padding:11px; border-radius:8px;
            cursor:pointer; font-weight:600; font-size:14px;">
                    Cancel
                </button>
                <button id="confirmPrintLocationBtn" onclick="submitPrintLocationLabel()" style="
            flex:2; background:#2563eb; border:2px solid #2563eb;
            color:white; padding:11px; border-radius:8px;
            cursor:pointer; font-weight:700; font-size:14px;
            display:flex; align-items:center; justify-content:center; gap:8px;">
                    <i class="bi bi-printer"></i> Print &amp; Record Weight
                </button>
            </div>
        </div>
    </div>

    <!-- Submission spinner -->
    <div class="spinner-overlay hidden" id="spinnerOverlay">
        <div class="spinner-box">
            <div class="spin-ring"></div>
            <p>Submitting...</p>
        </div>
    </div>

</div>

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        color: #1a1a2e;
    }

    .hidden {
        display: none !important;
    }

    .wizard-container {
        max-width: 760px;
        margin: 0 auto;
        padding: 16px;
    }

    /* Top bar */
    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: rgba(255,255,255,0.97);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        flex-wrap: wrap;
    }

    .part-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
        font-size: 14px;
        color: #1a1a2e;
        overflow: hidden;
    }

        .part-pill strong {
            color: #428bca;
            font-size: 16px;
            white-space: nowrap;
        }

    .dept-text {
        color: #6c757d;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .top-btn {
        border: 2px solid;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        background: transparent;
        white-space: nowrap;
    }

    .home-btn {
        border-color: #428bca;
        color: #428bca;
    }

        .home-btn:hover {
            background: #428bca;
            color: white;
        }

    .logout-btn {
        border-color: #dc3545;
        color: #dc3545;
    }

        .logout-btn:hover {
            background: #dc3545;
            color: white;
        }

    /* Steps bar */
    .steps-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        background: rgba(255,255,255,0.12);
        border-radius: 50px;
        padding: 10px 20px;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .step-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        transition: all 0.3s;
        border: 2px solid rgba(255,255,255,0.2);
    }

    .step-label {
        font-size: 11px;
        color: rgba(255,255,255,0.5);
        font-weight: 600;
        white-space: nowrap;
        transition: color 0.3s;
    }

    .step.active .step-circle {
        background: #428bca;
        color: white;
        border-color: #5daeed;
        box-shadow: 0 0 0 4px rgba(66,139,202,0.3);
    }

    .step.active .step-label {
        color: white;
    }

    .step.done .step-circle {
        background: #28a745;
        color: white;
        border-color: #34c759;
    }

    .step.done .step-label {
        color: rgba(255,255,255,0.8);
    }

    .step-line {
        flex: 1;

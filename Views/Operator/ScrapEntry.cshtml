    function discardAndStartFresh() {
        if (!confirm('Discard all ' + entries.length + ' saved entry(ies) and start fresh?')) return;
        clearStorage();
        entries = [];
        renderEntryList();
        document.getElementById('savedBanner')?.remove();
        // Reset step indicators
        ['step-ind-1','step-ind-2','step-ind-3'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.classList.remove('done','active'); }
        });
        document.getElementById('step-ind-1')?.classList.add('active');
        showStep(1);
    }

    function clearStorage() {
        const key = getStorageKey();
        sessionStorage.removeItem(key);
        localStorage.removeItem(key);
        entries = [];

        const pendingBtn = document.getElementById('pendingIndicatorBtn');
        if (pendingBtn) pendingBtn.style.display = 'none';
    }


        let lastSubmittedBatchId = null;   // ← NEW: set once SubmitScrap tells us the real batch id

    async function handleSubmitAll() {
        if (entries.length === 0) { alert('No entries to submit.'); return; }
        if (!confirm(`Submit ${entries.length} entry(ies)?`)) return;

        const submitBtn = document.getElementById('submitAllBtn');
        const spinner   = document.getElementById('spinnerOverlay');
        submitBtn.disabled = true;
        spinner.classList.remove('hidden');

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        let successCount = 0, failCount = 0, batchId = null;

        for (const entry of entries) {
            try {
                const res = await fetch('/Operator/SubmitScrap', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        partNumber:       entry.partNumber,
                        scrapSectionId:   parseInt(entry.scrapSectionId),
                        reasonId:         parseInt(entry.reasonId),
                        scrapReason:      entry.scrapReason,
                        quantity:         parseInt(entry.quantity),
                        position:         entry.position    || "",
                        length:           parseFloat(entry.length) || 0,
                        weight:           parseFloat(entry.weight) || 0,
                        scrapType:        entry.scrapType   || 'component',
                        machineType:      entry.machineType || "",
                        machineNumber:    entry.machineNumber || "",
                        department:       entry.department,
                        line:             entry.line,
                        shift:            entry.shift,
                        stockUom:         entry.stockUom    || "",
                        materialCost:     parseFloat(entry.materialCost) || 0,
                        partCategory:     entry.partCategory || "",
                        plant:            entry.plant        || "",
                        company:          entry.company      || "B",
                        batchScrapId:     batchId,
                        status:           "Pending TL",
                        engineeringPlant: entry.engineeringPlant || ""
                    })
                });

                if (res.ok) {
                    const result = await res.json();
                    if (result.success) {
                        successCount++;
                        if (!batchId && result.data?.batchScrapId) batchId = result.data.batchScrapId;
                    } else { failCount++; }
                } else { failCount++; }
            } catch(e) { failCount++; }

            await new Promise(r => setTimeout(r, 150));
        }

        spinner.classList.add('hidden');
        submitBtn.disabled = false;

        if (failCount === 0) {
            try {
                await fetch('/Operator/FinalizeAllActiveSessions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
            } catch(e) {}
            clearStorage();
            lastSubmittedBatchId = batchId;                          // ← NEW
            showSuccessState();
        } else {
            alert('Submitted: ' + successCount + ', Failed: ' + failCount + '. Please try again.');
        }
    }

    function showSuccessState() {
        ['step1','step2','step3'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
        document.getElementById('successCard').classList.remove('hidden');

        ['step-ind-1','step-ind-2','step-ind-3'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.classList.remove('active'); el.classList.add('done'); }
        });

        const pendingBtn = document.getElementById('pendingIndicatorBtn');
        if (pendingBtn) pendingBtn.style.display = 'none';
        document.getElementById('pendingModal')?.remove();

        // ✅ NEW: show which batch this was, and enable the print prompt only if we actually have one
        const batchLabel = lastSubmittedBatchId ? lastSubmittedBatchId : '—';
        document.getElementById('successBatchId').textContent = batchLabel;
        document.getElementById('confirmBatchId').textContent = batchLabel;
        document.getElementById('modalBatchId').textContent   = batchLabel;
        document.getElementById('printLabelPrompt').style.display = lastSubmittedBatchId ? 'block' : 'none';

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ✅ NEW: the blocking confirmation gate
    function confirmAndOpenPrintModal() {
        if (!lastSubmittedBatchId) {
            alert('No batch found for this submission. Please contact IT support.');
            return;
        }
        document.getElementById('scrapConfirmModal').style.display = 'flex';
    }

    function closeScrapConfirmModal() {
        document.getElementById('scrapConfirmModal').style.display = 'none';
    }

    function proceedToWeighAfterConfirm() {
        closeScrapConfirmModal();
        openPrintLocationModal();
    }

    // ── Print Location Label (moved from Index.cshtml, now batch-aware) ──────
    async function openPrintLocationModal() {
        const modal = document.getElementById('printLocationModal');
        const errorDiv = document.getElementById('printLocationError');
        if (errorDiv) errorDiv.style.display = 'none';

        document.getElementById('locationDept').value    = document.getElementById('department')?.textContent?.trim() || '';
        document.getElementById('locationLine').value    = document.getElementById('line')?.textContent?.trim() || '';
        document.getElementById('locationShift').value   = document.getElementById('shift')?.textContent?.trim() || '';
        document.getElementById('locationMachine').value = '';
        document.getElementById('locationNotes').value   = '';
        document.getElementById('locationWeight').value  = '';

        modal.style.display = 'flex';

        const printerSelect = document.getElementById('locationPrinterSelect');
        printerSelect.innerHTML = '<option value="">Loading...</option>';

        try {
            const res  = await fetch('/Operator/GetAvailablePrinters');
            const data = await res.json();

            if (data.success && data.printers?.length > 0) {
                printerSelect.innerHTML = '<option value="">Select Printer</option>';
                data.printers.forEach(p => {
                    const opt = document.createElement('option');
                    const id   = p.printerConfigId ?? p.printerconfigid ?? p.PrinterConfigId;
                    const name = p.printerName     ?? p.printername     ?? p.PrinterName ?? '';
                    const desc = p.description     ?? p.Description     ?? '';
                    opt.value       = id;
                    opt.textContent = desc ? `${name} — ${desc}` : name;
                    printerSelect.appendChild(opt);
                });
            } else {
                printerSelect.innerHTML = '<option value="">No printers available</option>';
            }
        } catch (err) {
            printerSelect.innerHTML = '<option value="">Error loading printers</option>';
        }
    }

    function closePrintLocationModal() {
        document.getElementById('printLocationModal').style.display = 'none';
    }

    async function submitPrintLocationLabel() {
        const printerConfigId = document.getElementById('locationPrinterSelect').value;
        const department      = document.getElementById('locationDept').value;
        const line            = document.getElementById('locationLine').value;
        const shift            = document.getElementById('locationShift').value;
        const machine          = document.getElementById('locationMachine').value;
        const notes            = document.getElementById('locationNotes').value;
        const weightRaw        = document.getElementById('locationWeight')?.value?.trim();
        const weight            = weightRaw && !isNaN(parseFloat(weightRaw)) ? parseFloat(weightRaw) : 0;
        const errorDiv          = document.getElementById('printLocationError');
        const btn                = document.getElementById('confirmPrintLocationBtn');
        const token              = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        errorDiv.style.display = 'none';

        if (!lastSubmittedBatchId) {
            errorDiv.textContent   = 'No scrap batch found for this session. Please submit scrap first.';
            errorDiv.style.display = 'block';
            return;
        }
        if (!printerConfigId) {
            errorDiv.textContent  = 'Please select a printer.';
            errorDiv.style.display = 'block';
            return;
        }
        if (!department || !line || !shift) {
            errorDiv.textContent  = 'Location details are missing. Please update your user location first.';
            errorDiv.style.display = 'block';
            return;
        }
        if (!weight || weight <= 0 || isNaN(weight)) {
            errorDiv.textContent   = 'Please enter a valid weight greater than zero.';
            errorDiv.style.display = 'block';
            document.getElementById('locationWeight').focus();
            return;
        }

        btn.disabled     = true;
        btn.textContent  = 'Sending...';

        try {
            const res  = await fetch('/Operator/PrintLocationLabel', {
                method:  'POST',
                headers: {
                    'Content-Type':             'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    printerConfigId: parseInt(printerConfigId),
                    department, line, shift, notes,
                    machineNumber: machine,
                    weight: weight,
                    batchScrapId: lastSubmittedBatchId   // ← NEW: the enforced link
                })
            });
            const data = await res.json();

            if (data.success) {
                closePrintLocationModal();
                alert('✅ ' + data.message);
                document.getElementById('printLabelPrompt').style.display = 'none'; // one weigh/print per batch
            } else {
                errorDiv.textContent  = data.message || 'Print failed.';
                errorDiv.style.display = 'block';
            }
        } catch (err) {
            errorDiv.textContent  = `Error: ${err.message}`;
            errorDiv.style.display = 'block';
        } finally {
            btn.disabled    = false;
            btn.innerHTML   = '<i class="bi bi-printer"></i> Print & Record Weight';
        }
    }

    document.getElementById('printLocationModal')
        ?.addEventListener('click', function (e) {
            if (e.target === this) closePrintLocationModal();
        });


    function navigateHome() { window.location.href = '/Operator/Index'; }
</script>

@model List<ScrapHistoryViewModel>
@{
    ViewData["Title"] = "My Scrap History";
    Layout = null;

    string FriendlyStatus(string status) => status?.ToUpper() switch
    {
        "APPROVED" => "Done ✅",
        "PENDING TL" => "Waiting for Team Leader",
        "PENDING GL" => "Waiting for Group Leader",
        "PENDING MANAGER" => "Waiting for Manager",
        "PENDING SENIOR MANAGER" => "Waiting for Senior Manager",
        _ => "In Progress"
    };

    string StatusColor(string status) => status?.ToUpper() switch
    {
        "APPROVED" => "#28a745",
        "PENDING TL" => "#856404",
        "PENDING GL" => "#0c5460",
        "PENDING MANAGER" => "#7d4e00",
        "PENDING SENIOR MANAGER" => "#4a2c8a",
        _ => "#495057"
    };

    string StatusBg(string status) => status?.ToUpper() switch
    {
        "APPROVED" => "rgba(40,167,69,0.12)",
        "PENDING TL" => "rgba(255,193,7,0.12)",
        "PENDING GL" => "rgba(23,162,184,0.12)",
        "PENDING MANAGER" => "rgba(253,126,20,0.12)",
        "PENDING SENIOR MANAGER" => "rgba(111,66,193,0.12)",
        _ => "rgba(108,117,125,0.12)"
    };

    string StatusBorder(string status) => status?.ToUpper() switch
    {
        "APPROVED" => "#28a745",
        "PENDING TL" => "#ffc107",
        "PENDING GL" => "#17a2b8",
        "PENDING MANAGER" => "#fd7e14",
        "PENDING SENIOR MANAGER" => "#6f42c1",
        _ => "#6c757d"
    };

    var approved = Model.Count(m => m.Status?.ToUpper() == "APPROVED");
    var pending = Model.Count(m => m.Status?.ToUpper() != "APPROVED");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Scrap History</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            color: #1a1a2e;
        }

        .page {
            max-width: 800px;
            margin: 0 auto;
            padding: 16px;
        }

        /* Top bar */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.97);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.15);
            gap: 10px;
            flex-wrap: wrap;
        }

        .top-btn {
            border: 2px solid;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            background: transparent;
            white-space: nowrap;
            text-decoration: none;
        }

        .home-btn {
            border-color: #428bca;
            color: #428bca;
        }

            .home-btn:hover {
                background: #428bca;
                color: white;
            }

        .logout-btn {
            border-color: #dc3545;
            color: #dc3545;
        }

            .logout-btn:hover {
                background: #dc3545;
                color: white;
            }

        .page-title-block {
            text-align: center;
            flex: 1;
        }

        .page-title {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
        }

        .page-subtitle {
            font-size: 12px;
            color: #6c757d;
            margin-top: 2px;
        }

        /* Summary cards */
        .summary-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .summary-card {
            background: rgba(255,255,255,0.97);
            border-radius: 12px;
            padding: 16px 12px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
        }

            .summary-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
            }

            .summary-card.total::before {
                background: #428bca;
            }

            .summary-card.done::before {
                background: #28a745;
            }

            .summary-card.wait::before {
                background: #ffc107;
            }

        .summary-num {
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 4px;
        }

        .summary-label {
            font-size: 11px;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* Filter tabs */
        .filter-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .tab {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s;
            background: rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.7);
        }

            .tab:hover {
                background: rgba(255,255,255,0.25);
                color: white;
            }

            .tab.active {
                background: white;
                color: #428bca;
            }

        /* Entry cards */
        .entry-card {
            background: rgba(255,255,255,0.97);
            border-radius: 12px;
            margin-bottom: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: box-shadow 0.2s;
            border-left: 4px solid #dee2e6;
        }

            .entry-card:hover {
                box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            }

        .entry-main {
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            cursor: pointer;
            user-select: none;
        }

        .entry-left {
            flex: 1;
            min-width: 0;
        }

        .entry-reason {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 5px;
        }

        .date-btn {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: 2px solid rgba(255,255,255,0.3);
            background: transparent;
            color: rgba(255,255,255,0.7);
            transition: all 0.2s;
        }

            .date-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .date-btn.active {
                background: white;
                color: #428bca;
                border-color: white;
            }

        .entry-meta {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }

        .meta-tag {
            font-size: 11px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 4px;
            background: #e9ecef;
            color: #495057;
        }

        .meta-part {
            color: #428bca;
            background: rgba(66,139,202,0.1);
        }

        .meta-date {
            color: #6c757d;
            font-size: 10px;
        }

        .entry-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
            flex-shrink: 0;
        }

        .qty-badge {
            font-size: 13px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            background: rgba(40,167,69,0.1);
            border: 1px solid #28a745;
            color: #28a745;
            white-space: nowrap;
        }

        .status-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            white-space: nowrap;
            border: 1px solid;
        }

        .expand-icon {
            font-size: 14px;
            color: #adb5bd;
            transition: transform 0.2s;
            flex-shrink: 0;
        }

        .entry-card.expanded .expand-icon {
            transform: rotate(180deg);
        }

        /* Expanded detail */
        .entry-detail {
            display: none;
            padding: 0 16px 16px;
            border-top: 1px solid #f0f0f0;
        }

        .entry-card.expanded .entry-detail {
            display: block;
            padding-top: 14px;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .detail-label {
            font-size: 10px;
            color: #adb5bd;
            font-weight: 600;
            text-transform: uppercase;
        }

        .detail-val {
            font-size: 13px;
            color: #1a1a2e;
            font-weight: 600;
        }

        /* Approval progress */
        .approval-progress {
            margin-top: 4px;
        }

        .progress-label {
            font-size: 11px;
            color: #6c757d;
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .progress-steps {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 4px;
        }

        .prog-step {
            flex: 1;
            height: 8px;
            border-radius: 4px;
            background: #e9ecef;
            transition: background 0.3s;
        }

            .prog-step.done {
                background: #28a745;
            }

            .prog-step.current {
                background: #ffc107;
            }

        .prog-labels {
            display: flex;
            justify-content: space-between;
        }

        .prog-lbl {
            font-size: 9px;
            color: #adb5bd;
            font-weight: 600;
            text-align: center;
            flex: 1;
            text-transform: uppercase;
        }

            .prog-lbl.done {
                color: #28a745;
            }

            .prog-lbl.current {
                color: #856404;
            }

        /* Empty state */
        .empty-state {
            background: rgba(255,255,255,0.97);
            border-radius: 16px;
            padding: 48px 24px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .empty-title {
            font-size: 18px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 6px;
        }

        .empty-sub {
            font-size: 14px;
            color: #6c757d;
        }

        .hidden {
            display: none !important;
        }

        .no-filter-results {
            text-align: center;
            padding: 32px;
            color: rgba(255,255,255,0.6);
            font-size: 15px;
        }

        @@media (max-width: 480px) {
            .page {
                padding: 10px;
            }

            .summary-num {
                font-size: 22px;
            }

            .detail-grid {
                grid-template-columns: 1fr;
            }

            .entry-reason {
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- Top bar -->
        <div class="top-bar">
            <a href="@Url.Action("Index", "Operator")" class="top-btn home-btn">
                <i class="bi bi-house-fill"></i> Home
            </a>
            <div class="page-title-block">
                <div class="page-title">My Scrap History</div>
                <div class="page-subtitle">Clock: @ViewData["ClockNumber"]</div>
            </div>
            <form action="/Account/Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="top-btn logout-btn">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <div class="empty-title">No entries yet</div>
                <div class="empty-sub">You haven't submitted any scrap entries.</div>
            </div>
        }
        else
        {
            <!-- Summary -->
            <div class="summary-row">
                <div class="summary-card total">
                    <div class="summary-num" style="color:#428bca;">@Model.Count</div>
                    <div class="summary-label">Total</div>
                </div>
                <div class="summary-card done">
                    <div class="summary-num" style="color:#28a745;">@approved</div>
                    <div class="summary-label">Approved</div>
                </div>
                <div class="summary-card wait">
                    <div class="summary-num" style="color:#856404;">@pending</div>
                    <div class="summary-label">Pending</div>
                </div>
            </div>

            <!-- Filter tabs -->
            <!-- Date filter -->
            <div style="background:rgba(255,255,255,0.12); border-radius:12px; padding:12px 14px; margin-bottom:12px;">
                <div style="color:rgba(255,255,255,0.7); font-size:11px; font-weight:700;
                    text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">
                    <i class="bi bi-calendar3"></i> Filter by Date
                </div>
                <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px;">
                    <button class="date-btn active" onclick="setDateFilter('today', this)">Today</button>
                    <button class="date-btn" onclick="setDateFilter('week', this)">This Week</button>
                    <button class="date-btn" onclick="setDateFilter('month', this)">This Month</button>
                    <button class="date-btn" onclick="setDateFilter('all', this)">All Time</button>
                </div>
                <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                    <input type="date" id="dateFrom" onchange="applyCustomDate()"
                           style="flex:1; min-width:120px; padding:7px 10px; border-radius:8px;
                          border:none; font-size:13px; background:white; color:#1a1a2e;" />
                    <span style="color:rgba(255,255,255,0.6); font-size:12px;">to</span>
                    <input type="date" id="dateTo" onchange="applyCustomDate()"
                           style="flex:1; min-width:120px; padding:7px 10px; border-radius:8px;
                          border:none; font-size:13px; background:white; color:#1a1a2e;" />
                </div>
                <div id="dateFilterLabel"
                     style="margin-top:6px; font-size:11px; color:rgba(255,255,255,0.5);">
                    Showing: Today
                </div>
            </div>

            <!-- Status filter tabs -->
            <div class="filter-tabs">
                <div class="tab active" id="tab-all" onclick="filterStatus('all', this)">All</div>
                <div class="tab" id="tab-pending" onclick="filterStatus('pending', this)">Pending</div>
                <div class="tab" id="tab-approved" onclick="filterStatus('approved', this)">Approved</div>
            </div>

            <!-- Entry cards -->
            <div id="entryContainer">
                @foreach (var item in Model.OrderByDescending(m => m.SubmissionDate))
                {
                    var statusUp = item.Status?.ToUpper() ?? "";
                    var color = StatusColor(item.Status);
                    var bg = StatusBg(item.Status);
                    var border = StatusBorder(item.Status);
                    var friendly = FriendlyStatus(item.Status);
                    var filterCat = statusUp == "APPROVED" ? "approved" : "pending";

                    int step = statusUp switch
                    {
                        "PENDING TL" => 0,
                        "PENDING GL" => 1,
                        "PENDING MANAGER" => 2,
                        "PENDING SENIOR MANAGER" => 3,
                        "APPROVED" => 4,
                        _ => 0
                    };

                    <div class="entry-card"
                         data-filter="@filterCat"
                         data-date="@item.SubmissionDate.ToString("yyyy-MM-dd")"
                         style="border-left-color: @border;"
                         onclick="toggleCard(this)">

                        <div class="entry-main">
                            <div class="entry-left">
                                <div class="entry-reason">@item.ScrapReason</div>
                                <div class="entry-meta">
                                    <span class="meta-tag meta-part">@item.PartNumber</span>
                                    <span class="meta-tag">@item.Section</span>
                                    <span class="meta-tag meta-date">
                                        @item.SubmissionDate.ToString("dd MMM HH:mm")
                                    </span>
                                </div>
                            </div>
                            <div class="entry-right">
                                <span class="qty-badge">Qty: @item.Quantity</span>
                                <span class="status-pill"
                                      style="color:@color; background:@bg; border-color:@border;">
                                    @friendly
                                </span>
                            </div>
                            <i class="bi bi-chevron-down expand-icon"></i>
                        </div>

                        <div class="entry-detail">
                            <div class="detail-grid">
                                <div class="detail-item">
                                    <span class="detail-label">Part Number</span>
                                    <span class="detail-val">@item.PartNumber</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Section</span>
                                    <span class="detail-val">@item.Section</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Department</span>
                                    <span class="detail-val">@item.Department</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Shift</span>
                                    <span class="detail-val">@item.Shift</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Submitted</span>
                                    <span class="detail-val">
                                        @item.SubmissionDate.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Quantity</span>
                                    <span class="detail-val">@item.Quantity</span>
                                </div>
                            </div>

                            <!-- Approval journey -->
                            <div class="approval-progress">
                                <div class="progress-label">Approval Journey</div>
                                <div class="progress-steps">
                                    <div class="prog-step @(step > 0 ? "done" : step == 0 ? "current" : "")"></div>
                                    <div class="prog-step @(step > 1 ? "done" : step == 1 ? "current" : "")"></div>
                                    <div class="prog-step @(step > 2 ? "done" : step == 2 ? "current" : "")"></div>
                                    <div class="prog-step @(step >= 4 ? "done" : step == 3 ? "current" : "")"></div>
                                </div>
                                <div class="prog-labels">
                                    <div class="prog-lbl @(step > 0 ? "done" : step == 0 ? "current" : "")">
                                        Team Leader
                                    </div>
                                    <div class="prog-lbl @(step > 1 ? "done" : step == 1 ? "current" : "")">
                                        Group Leader
                                    </div>
                                    <div class="prog-lbl @(step > 2 ? "done" : step == 2 ? "current" : "")">
                                        Manager
                                    </div>
                                    <div class="prog-lbl @(step >= 4 ? "done" : step == 3 ? "current" : "")">
                                        Done
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="noFilterResults" class="no-filter-results hidden">
                No entries in this category.
            </div>
        }

    </div>

    <script>
        let currentDateFilter = 'today';
        let currentStatusFilter = 'all';

        // On load — default to today
        document.addEventListener('DOMContentLoaded', function() {
            applyFilters();
        });

        function setDateFilter(range, btn) {
            document.querySelectorAll('.date-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentDateFilter = range;

            // Clear custom date inputs
            document.getElementById('dateFrom').value = '';
            document.getElementById('dateTo').value   = '';

            const labels = {
                today: 'Showing: Today',
                week:  'Showing: This Week',
                month: 'Showing: This Month',
                all:   'Showing: All Time'
            };
            document.getElementById('dateFilterLabel').textContent = labels[range] || '';

            applyFilters();
        }

        function applyCustomDate() {
            const from = document.getElementById('dateFrom').value;
            const to   = document.getElementById('dateTo').value;
            if (!from && !to) return;

            document.querySelectorAll('.date-btn').forEach(b => b.classList.remove('active'));
            currentDateFilter = 'custom';

            const label = from && to ? `${from} → ${to}`
                        : from       ? `From ${from}`
                        :              `Up to ${to}`;
            document.getElementById('dateFilterLabel').textContent = 'Showing: ' + label;

            applyFilters();
        }

        function filterStatus(status, tabEl) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            tabEl.classList.add('active');
            currentStatusFilter = status;
            applyFilters();
        }

        function applyFilters() {
            const cards  = document.querySelectorAll('.entry-card');
            const from   = document.getElementById('dateFrom').value;
            const to     = document.getElementById('dateTo').value;
            const today  = new Date(); today.setHours(0,0,0,0);
            let visible  = 0;

            cards.forEach(card => {
                const cardDate    = new Date(card.getAttribute('data-date'));
                const cardFilter  = card.getAttribute('data-filter');

                // Date check
                let dateMatch = true;
                if (currentDateFilter === 'today') {
                    const d = new Date(cardDate); d.setHours(0,0,0,0);
                    dateMatch = d.getTime() === today.getTime();
                } else if (currentDateFilter === 'week') {
                    const weekAgo = new Date(today); weekAgo.setDate(today.getDate() - 7);
                    dateMatch = cardDate >= weekAgo;
                } else if (currentDateFilter === 'month') {
                    dateMatch = cardDate.getMonth()     === today.getMonth() &&
                                cardDate.getFullYear()  === today.getFullYear();
                } else if (currentDateFilter === 'custom') {
                    if (from) dateMatch = dateMatch && cardDate >= new Date(from);
                    if (to)   dateMatch = dateMatch && cardDate <= new Date(to + 'T23:59:59');
                }

                // Status check
                const statusMatch = currentStatusFilter === 'all' || cardFilter === currentStatusFilter;

                const show = dateMatch && statusMatch;
                card.style.display = show ? 'block' : 'none';
                if (show) visible++;
            });

            const noResults = document.getElementById('noFilterResults');
            if (noResults) noResults.classList.toggle('hidden', visible > 0);
        }

        function toggleCard(card) {
            card.classList.toggle('expanded');
        }
    </script>

</body>
</html>

@{
    ViewData["Title"] = "Weight Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />

    <style>
        :root {
            --primary: #428bca;
            --success: #28a745;
            --warning: #f0ad4e;
            --danger: #dc3545;
            --dark: #1a1a2e;
            --muted: #6c757d;
            --light: #f5f7fa;
            --border: #dfe3e8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--light);
            margin: 0;
            color: var(--dark);
        }

        .topnav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 24px;
            background: #fff;
            border-bottom: 3px solid var(--primary);
        }

        .topnav-brand span {
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .topnav-brand strong {
            font-size: 18px;
            display: block;
        }

        .topnav-actions {
            display: flex;
            gap: 8px;
        }

        .btn {
            border: none;
            border-radius: 6px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--border);
            color: var(--dark);
        }

        .btn-danger {
            background: #fff;
            border: 1px solid var(--danger);
            color: var(--danger);
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

        .btn-success {
            background: var(--success);
            color: #fff;
        }

        .btn-sm {
            padding: 6px 10px;
            font-size: 12px;
        }

        .btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .page {
            max-width: 1500px;
            margin: 0 auto;
            padding: 20px;
        }

        .card {
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
        }

        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
        }

            .card-head h2 {
                font-size: 15px;
                margin: 0;
            }

        .card-body {
            padding: 16px 18px;
        }

        .fld {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .fld label {
                font-size: 11px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .5px;
            }

        .ctrl {
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 13px;
            min-width: 180px;
        }

            .ctrl:focus {
                outline: none;
                border-color: var(--primary);
            }

        .tbl-wrap {
            overflow-x: auto;
        }

        .tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .tbl th {
                text-align: left;
                padding: 10px 12px;
                background: var(--dark);
                color: #fff;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .tbl td {
                padding: 10px 12px;
                border-bottom: 1px solid var(--border);
            }

            .tbl .r {
                text-align: right;
            }

            .tbl .c {
                text-align: center;
            }

            .tbl .bold {
                font-weight: 700;
            }

        .loading-row td {
            text-align: center;
            padding: 30px;
            color: var(--muted);
        }

        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(66,139,202,.25);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
            vertical-align: middle;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .empty-state {
            text-align: center;
            padding: 30px;
            color: var(--muted);
        }

            .empty-state i {
                font-size: 28px;
                display: block;
                margin-bottom: 8px;
            }

        .notif-container {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .notif {
            padding: 10px 16px;
            border-radius: 6px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }

        .notif-success {
            background: var(--success);
        }

        .notif-error {
            background: var(--danger);
        }

        .bin-row {
            display: flex;
            gap: 10px;
            align-items: flex-end;
            flex-wrap: wrap;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
        }

            .bin-row .fld input {
                max-width: 110px;
            }

        .net-display {
            padding: 8px 10px;
            font-weight: 700;
            color: var(--success);
        }

        /* ── Bin-only page layout ── */
        .plant-bar {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .plant-totals {
            display: flex;
            gap: 18px;
            font-size: 13px;
            color: var(--muted);
        }

            .plant-totals b {
                color: var(--dark);
                font-size: 15px;
            }

        .bin-group {
            margin-bottom: 18px;
        }

        .bin-group-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: .5px;
            padding-bottom: 4px;
            border-bottom: 2px solid var(--primary);
        }

        .bin-cat {
            min-width: 180px;
            flex: 1;
        }

        .bin-cat-name {
            padding: 8px 0;
            font-weight: 700;
            font-size: 14px;
        }

        .bin-row select.ctrl {
            min-width: 170px;
        }

        .bin-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            align-items: start;
        }

        .sale-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

            .sale-row .ctrl, #saleCategory, #saleNotes {
                min-width: 0;
                width: 100%;
            }

        .sale-warning {
            background: rgba(240,173,78,.15);
            border: 1px solid var(--warning);
            color: #8a5a00;
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .export-row {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .export-plant {
            padding: 8px 0;
            font-weight: 700;
        }

        .muted-note {
            font-size: 12px;
            font-weight: 400;
            color: var(--muted);
        }

        .tbl .total-row td {
            font-weight: 700;
            border-top: 2px solid var(--dark);
        }

        @@media (max-width: 900px) {
            .bin-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    @Html.AntiForgeryToken()
    <div class="notif-container" id="notifContainer"></div>

    <nav class="topnav">
        <div class="topnav-brand">
            <div>
                <span>HESTO Harnesses</span>
                <br>
                <strong>Weight Management</strong>
            </div>
        </div>
        <div class="topnav-actions">
            <a href="/ScrapApproval/Dashboard" class="btn btn-outline"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/Analytics/Dashboard" class="btn btn-outline"><i class="bi bi-graph-up"></i> Analytics</a>
            <form method="post" action="/Account/Logout" class="d-inline">
                <button type="submit" class="btn btn-danger"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </div>
    </nav>

    <div class="page">

        <!-- Plant selector -->
        <div class="card" style="margin-bottom:16px;">
            <div class="card-body plant-bar">
                <div class="fld">
                    <label for="binPlantSelect">Plant</label>
                    <select class="ctrl" id="binPlantSelect" style="min-width:200px;">
                        <option value="">Select Plant</option>
                        <option value="Plant A">Plant A</option>
                        <option value="Plant B">Plant B</option>
                    </select>
                </div>
                <div class="plant-totals" id="plantTotals"></div>
            </div>
        </div>

        <!-- Bulk bin recording -->
        <div class="card" style="margin-bottom:16px;">
            <div class="card-head">
                <h2><i class="bi bi-boxes me-2"></i>Bulk Bin Recording</h2>
            </div>
            <div class="card-body">
                <div id="binCategoriesContainer">
                    <div class="empty-state"><i class="bi bi-building"></i><p>Select a plant to record bin weights.</p></div>
                </div>
            </div>
        </div>

        <div class="bin-grid">
            <!-- On-hand balance -->
            <div class="card">
                <div class="card-head"><h2><i class="bi bi-cash-coin me-2"></i>On-Hand Balance</h2></div>
                <div class="card-body">
                    <div class="tbl-wrap">
                        <table class="tbl" id="balanceTable">
                            <thead><tr><th>Category</th><th class="r">Weighed</th><th class="r">Sold</th><th class="r">On Hand</th></tr></thead>
                            <tbody id="balanceBody"><tr class="loading-row"><td colspan="4">Select a plant</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Record sale -->
            <div class="card">
                <div class="card-head"><h2><i class="bi bi-truck me-2"></i>Record Sale</h2></div>
                <div class="card-body">
                    <div class="fld" style="margin-bottom:10px;">
                        <label for="saleCategory">Category</label>
                        <select class="ctrl" id="saleCategory"><option value="">Select a plant first</option></select>
                    </div>
                    <div class="sale-row">
                        <div class="fld">
                            <label for="saleWeight">Weight Sold (kg)</label>
                            <input type="number" class="ctrl" id="saleWeight" step="0.01" min="0.01" placeholder="0.00">
                        </div>
                        <div class="fld">
                            <label for="saleDate">Sale Date</label>
                            <input type="date" class="ctrl" id="saleDate">
                        </div>
                    </div>
                    <div class="sale-row">
                        <div class="fld">
                            <label for="saleBuyer">Buyer</label>
                            <input type="text" class="ctrl" id="saleBuyer" placeholder="Buyer name">
                        </div>
                        <div class="fld">
                            <label for="saleReference">Reference / Invoice #</label>
                            <input type="text" class="ctrl" id="saleReference" placeholder="Optional">
                        </div>
                    </div>
                    <div class="fld" style="margin-bottom:10px;">
                        <label for="saleNotes">Notes</label>
                        <input type="text" class="ctrl" id="saleNotes" placeholder="Optional">
                    </div>
                    <div id="saleWarning" class="sale-warning" style="display:none;"></div>
                    <button class="btn btn-success btn-sm" id="saveSaleBtn"><i class="bi bi-save"></i> Record Sale</button>
                </div>
            </div>
        </div>

        <!-- Sales history -->
        <div class="card" style="margin-top:16px;">
            <div class="card-head"><h2><i class="bi bi-receipt me-2"></i>Sales History <span class="muted-note">(last 90 days)</span></h2></div>
            <div class="card-body">
                <div class="tbl-wrap">
                    <table class="tbl" id="salesHistoryTable">
                        <thead><tr><th>Date</th><th>Category</th><th class="r">Weight</th><th>Buyer</th><th>Reference</th><th>Recorded By</th></tr></thead>
                        <tbody id="salesHistoryBody"><tr class="loading-row"><td colspan="6">Select a plant</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Export -->
        <div class="card" style="margin-top:16px;">
            <div class="card-head"><h2><i class="bi bi-file-earmark-excel me-2"></i>Export Bin Weights &amp; Sales</h2></div>
            <div class="card-body">
                <form id="binExportForm" method="post" action="/Export/ExportBinWeightsToExcel" class="export-row">
                    <input type="hidden" name="__RequestVerificationToken" id="binExportToken" />
                    <input type="hidden" name="plant" id="binExportPlant" value="All Plants" />
                    <div class="fld">
                        <label for="binExportStart">From</label>
                        <input type="date" class="ctrl" name="startDate" id="binExportStart">
                    </div>
                    <div class="fld">
                        <label for="binExportEnd">To</label>
                        <input type="date" class="ctrl" name="endDate" id="binExportEnd">
                    </div>
                    <div class="fld">
                        <label>Plant</label>
                        <div class="export-plant" id="binExportPlantLabel">All Plants</div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-download"></i> Export to Excel</button>
                </form>
            </div>
        </div>

    </div><!-- /page -->

    <script>
        // ═══════════════════════════════════════════════════════════
        // HELPERS
        // ═══════════════════════════════════════════════════════════
        function TOKEN() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }
        function escHtml(s) {
            if (s === null || s === undefined) return '';
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }
        function kg(n) { return (Number(n) || 0).toFixed(2) + ' kg'; }
        function localDateStr(d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
        function notify(msg, type) {
            var el = document.createElement('div');
            el.className = 'notif notif-' + (type || 'success');
            el.textContent = msg;
            document.getElementById('notifContainer').appendChild(el);
            setTimeout(function () { el.remove(); }, 4000);
        }
        function currentPlant() { return document.getElementById('binPlantSelect').value; }

        var balances = [];

        // ═══════════════════════════════════════════════════════════
        // BULK BIN RECORDING
        // ═══════════════════════════════════════════════════════════
        function renderBinCategories(plant, data) {
            var container = document.getElementById('binCategoriesContainer');
            container.innerHTML = '';

            if (!data.categories || data.categories.length === 0) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>No active scrap categories are configured for ' + escHtml(plant) + '.</p></div>';
                return;
            }

            var bins = data.bins || [];
            var groups = {};
            var order = [];
            data.categories.forEach(function (c) {
                var key = c.parentCategory || c.categoryName;
                if (!groups[key]) { groups[key] = []; order.push(key); }
                groups[key].push(c);
            });

            order.forEach(function (groupName) {
                var group = document.createElement('div');
                group.className = 'bin-group';
                group.innerHTML = '<div class="bin-group-title">' + escHtml(groupName) + '</div>';

                groups[groupName].forEach(function (c) {
                    var binField = bins.length
                        ? '<select class="ctrl bin-select"><option value="">Select bin</option>' +
                          bins.map(function (b) {
                              return '<option value="' + b.binNumber + '" data-tare="' + b.tareWeightKg + '">Bin ' + b.binNumber + ' (' + Number(b.tareWeightKg).toFixed(2) + ' kg)</option>';
                          }).join('') + '</select>'
                        : '<input type="number" class="ctrl bin-select" min="1" step="1" placeholder="e.g. 3">';

                    var row = document.createElement('div');
                    row.className = 'bin-row';
                    row.innerHTML =
                        '<div class="fld bin-cat"><label>Category</label><div class="bin-cat-name">' + escHtml(c.categoryName) + '</div></div>' +
                        '<div class="fld"><label>Bin</label>' + binField + '</div>' +
                        '<div class="fld"><label>Tare (kg)</label><input type="number" class="ctrl tare-input" step="0.01" min="0" placeholder="0.00"></div>' +
                        '<div class="fld"><label>Gross (kg)</label><input type="number" class="ctrl gross-input" step="0.01" min="0.01" placeholder="0.00"></div>' +
                        '<div class="fld"><label>Net</label><div class="net-display">—</div></div>' +
                        '<button class="btn btn-success btn-sm save-bin-btn" disabled><i class="bi bi-save"></i> Save</button>';
                    group.appendChild(row);
                    wireBinRow(row, c.categoryName);
                });

                container.appendChild(group);
            });
        }

        function wireBinRow(row, categoryName) {
            var binEl = row.querySelector('.bin-select');
            var tare = row.querySelector('.tare-input');
            var gross = row.querySelector('.gross-input');
            var netDisplay = row.querySelector('.net-display');
            var saveBtn = row.querySelector('.save-bin-btn');

            function recalc() {
                var binNum = parseInt(binEl.value);
                var tareVal = parseFloat(tare.value);
                var grossVal = parseFloat(gross.value);
                if (binNum > 0 && tareVal >= 0 && grossVal > 0) {
                    var net = grossVal - tareVal;
                    netDisplay.textContent = net > 0 ? kg(net) : 'Gross must exceed tare';
                    netDisplay.style.color = net > 0 ? 'var(--success)' : 'var(--danger)';
                    saveBtn.disabled = net <= 0;
                } else {
                    netDisplay.textContent = '—';
                    netDisplay.style.color = '';
                    saveBtn.disabled = true;
                }
            }

            // Selecting a configured bin fills in its tare weight (still editable)
            binEl.addEventListener('change', function () {
                var opt = binEl.tagName === 'SELECT' ? binEl.selectedOptions[0] : null;
                if (opt && opt.dataset.tare !== undefined) tare.value = Number(opt.dataset.tare).toFixed(2);
                recalc();
            });
            [binEl, tare, gross].forEach(function (el) { el.addEventListener('input', recalc); });

            saveBtn.addEventListener('click', async function () {
                var plant = currentPlant();
                var payload = {
                    Plant: plant,
                    CategoryName: categoryName,
                    BinNumber: parseInt(binEl.value),
                    TareWeightKg: parseFloat(tare.value),
                    GrossWeightKg: parseFloat(gross.value),
                    Description: ''
                };
                saveBtn.disabled = true; saveBtn.innerHTML = '<div class="spinner"></div>';
                try {
                    var res = await fetch('/ScrapApproval/SaveBinCategoryWeight', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN() },
                        body: JSON.stringify(payload)
                    });
                    var result = await res.json();
                    if (result.success) {
                        notify('✓ ' + result.message, 'success');
                        binEl.value = ''; tare.value = ''; gross.value = '';
                        recalc();
                        loadBinSaleSummary(plant);
                    } else {
                        notify(result.message || 'Save failed', 'error');
                        recalc();
                    }
                } catch (err) {
                    notify('Network error — the weight was not saved', 'error');
                    recalc();
                } finally {
                    saveBtn.innerHTML = '<i class="bi bi-save"></i> Save';
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // ON-HAND BALANCE + SALES
        // ═══════════════════════════════════════════════════════════
        async function loadBinSaleSummary(plant) {
            var balBody = document.getElementById('balanceBody');
            var salesBody = document.getElementById('salesHistoryBody');
            balBody.innerHTML = '<tr class="loading-row"><td colspan="4"><div class="spinner"></div></td></tr>';
            salesBody.innerHTML = '<tr class="loading-row"><td colspan="6"><div class="spinner"></div></td></tr>';

            try {
                var res = await fetch('/ScrapApproval/GetBinSaleSummary?plant=' + encodeURIComponent(plant));
                var data = await res.json();
                if (plant !== currentPlant()) return;   // plant changed while loading

                if (!data.success) {
                    var msg = '<tr class="loading-row"><td colspan="6" style="color:var(--danger);">' + escHtml(data.message || 'Error loading') + '</td></tr>';
                    balBody.innerHTML = msg; salesBody.innerHTML = msg;
                    return;
                }

                balances = data.balances || [];
                var tw = 0, ts = 0;
                balBody.innerHTML = balances.length
                    ? balances.map(function (b) {
                        tw += b.totalWeighedKg; ts += b.totalSoldKg;
                        var color = b.onHandKg < 0 ? 'var(--danger)' : (b.onHandKg > 0 ? 'var(--success)' : 'var(--muted)');
                        return '<tr><td class="bold">' + escHtml(b.categoryName) + '</td>' +
                            '<td class="r">' + kg(b.totalWeighedKg) + '</td>' +
                            '<td class="r">' + kg(b.totalSoldKg) + '</td>' +
                            '<td class="r bold" style="color:' + color + ';">' + kg(b.onHandKg) + '</td></tr>';
                    }).join('') +
                    '<tr class="total-row"><td>Total</td><td class="r">' + kg(tw) + '</td><td class="r">' + kg(ts) + '</td><td class="r">' + kg(tw - ts) + '</td></tr>'
                    : '<tr class="loading-row"><td colspan="4">No categories for this plant yet.</td></tr>';

                document.getElementById('plantTotals').innerHTML = balances.length
                    ? '<span><b>' + kg(tw) + '</b> weighed</span><span><b>' + kg(ts) + '</b> sold</span><span><b>' + kg(tw - ts) + '</b> on hand</span>'
                    : '';

                var saleSel = document.getElementById('saleCategory');
                var prev = saleSel.value;
                saleSel.innerHTML = '<option value="">Select Category</option>' +
                    balances.map(function (b) {
                        return '<option value="' + escHtml(b.categoryName) + '">' + escHtml(b.categoryName) + ' — ' + kg(b.onHandKg) + ' on hand</option>';
                    }).join('');
                if (prev) saleSel.value = prev;
                checkSaleAgainstOnHand();

                var sales = data.sales || [];
                salesBody.innerHTML = sales.length
                    ? sales.map(function (s) {
                        return '<tr><td>' + escHtml(s.saleDate) + '</td>' +
                            '<td>' + escHtml(s.categoryName) + '</td>' +
                            '<td class="r bold">' + kg(s.weightSoldKg) + '</td>' +
                            '<td>' + escHtml(s.buyer) + '</td>' +
                            '<td>' + escHtml(s.reference) + '</td>' +
                            '<td>' + escHtml(s.createdBy) + '</td></tr>';
                    }).join('')
                    : '<tr class="loading-row"><td colspan="6">No sales in the last 90 days.</td></tr>';
            } catch (err) {
                var errRow = '<tr class="loading-row"><td colspan="6" style="color:var(--danger);">Error loading balances</td></tr>';
                balBody.innerHTML = errRow; salesBody.innerHTML = errRow;
            }
        }

        // Warn (not block) when a sale is more than what's on hand
        function checkSaleAgainstOnHand() {
            var warn = document.getElementById('saleWarning');
            var cat = document.getElementById('saleCategory').value;
            var weight = parseFloat(document.getElementById('saleWeight').value);
            var b = balances.find(function (x) { return x.categoryName === cat; });
            if (b && weight > 0 && weight > b.onHandKg + 0.005) {
                warn.textContent = 'This is more than the ' + kg(b.onHandKg) + ' on hand for ' + cat + '. Check the bin recordings before saving.';
                warn.style.display = 'block';
            } else {
                warn.style.display = 'none';
            }
        }

        async function saveBinSale() {
            var plant = currentPlant();
            var category = document.getElementById('saleCategory').value;
            var weight = parseFloat(document.getElementById('saleWeight').value);
            var saleDate = document.getElementById('saleDate').value;

            if (!plant) { notify('Select a plant first', 'error'); return; }
            if (!category) { notify('Select a category', 'error'); return; }
            if (!weight || weight <= 0) { notify('Enter a valid weight sold', 'error'); return; }
            if (!saleDate) { notify('Select a sale date', 'error'); return; }

            var b = balances.find(function (x) { return x.categoryName === category; });
            if (b && weight > b.onHandKg + 0.005 &&
                !confirm('You are selling ' + kg(weight) + ' of ' + category + ' but only ' + kg(b.onHandKg) + ' is on hand.\n\nRecord the sale anyway?')) {
                return;
            }

            var btn = document.getElementById('saveSaleBtn');
            btn.disabled = true; btn.innerHTML = '<div class="spinner"></div>';
            try {
                var res = await fetch('/ScrapApproval/SaveBinSale', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN() },
                    body: JSON.stringify({
                        Plant: plant, CategoryName: category, WeightSoldKg: weight,
                        Buyer: document.getElementById('saleBuyer').value,
                        Reference: document.getElementById('saleReference').value,
                        SaleDate: saleDate,
                        Notes: document.getElementById('saleNotes').value
                    })
                });
                var result = await res.json();
                if (result.success) {
                    notify('✓ ' + result.message, 'success');
                    ['saleWeight', 'saleBuyer', 'saleReference', 'saleNotes'].forEach(function (id) { document.getElementById(id).value = ''; });
                    loadBinSaleSummary(plant);
                } else {
                    notify(result.message || 'Save failed', 'error');
                }
            } catch (err) {
                notify('Network error — the sale was not saved', 'error');
            } finally {
                btn.disabled = false; btn.innerHTML = '<i class="bi bi-save"></i> Record Sale';
            }
        }

        // ═══════════════════════════════════════════════════════════
        // PLANT CHANGE + INIT
        // ═══════════════════════════════════════════════════════════
        async function onPlantChange() {
            var plant = currentPlant();
            var container = document.getElementById('binCategoriesContainer');

            document.getElementById('binExportPlant').value = plant || 'All Plants';
            document.getElementById('binExportPlantLabel').textContent = plant || 'All Plants';
            document.getElementById('plantTotals').innerHTML = '';
            balances = [];

            if (!plant) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-building"></i><p>Select a plant to record bin weights.</p></div>';
                document.getElementById('balanceBody').innerHTML = '<tr class="loading-row"><td colspan="4">Select a plant</td></tr>';
                document.getElementById('salesHistoryBody').innerHTML = '<tr class="loading-row"><td colspan="6">Select a plant</td></tr>';
                document.getElementById('saleCategory').innerHTML = '<option value="">Select a plant first</option>';
                return;
            }

            container.innerHTML = '<div class="loading-row"><div class="spinner"></div> Loading categories…</div>';
            try {
                var res = await fetch('/ScrapApproval/GetBinRecordingConfig?plant=' + encodeURIComponent(plant));
                var data = await res.json();
                if (plant !== currentPlant()) return;
                if (!data.success) {
                    container.innerHTML = '<div style="color:var(--danger);">' + escHtml(data.message) + '</div>';
                } else {
                    renderBinCategories(plant, data);
                }
            } catch (err) {
                container.innerHTML = '<div style="color:var(--danger);">Error loading categories</div>';
            }
            loadBinSaleSummary(plant);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var today = new Date();
            var monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
            document.getElementById('saleDate').value = localDateStr(today);
            document.getElementById('saleDate').max = localDateStr(today);
            document.getElementById('binExportStart').value = localDateStr(monthStart);
            document.getElementById('binExportEnd').value = localDateStr(today);

            document.getElementById('binPlantSelect').addEventListener('change', onPlantChange);
            document.getElementById('saveSaleBtn').addEventListener('click', saveBinSale);
            document.getElementById('saleCategory').addEventListener('change', checkSaleAgainstOnHand);
            document.getElementById('saleWeight').addEventListener('input', checkSaleAgainstOnHand);

            document.getElementById('binExportForm').addEventListener('submit', function () {
                document.getElementById('binExportToken').value = TOKEN();
            });
        });
    </script>
</body>
</html>

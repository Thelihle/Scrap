    <div class="card-body">
        <!-- GROUPED VIEW (Default for Admin/Senior Manager) -->
        <div id="groupedView" style="@(canViewAllData ? "display: block;" : "display: none;")">
            <div class="location-groups" id="locationGroupsContainer">
                <!-- Groups will be dynamically populated -->
            </div>
        </div>
        
        <!-- FLAT VIEW (Default for regular users, optional for admins) -->
<div id="flatView" style="@(canViewAllData ? "display: none;" : "display: block;")">

    <!-- Grouped scrap items -->
    <div id="groupedScrapContainer">
        @if (Model.ScrapItems != null && Model.ScrapItems.Any())
        {
            var groups = Model.ScrapItems
                .GroupBy(x => new { 
                    Reason = x.ErrorName ?? "Unknown Reason",
                    Type = x.ScrapType ?? "Other"
                })
                .OrderBy(g => g.Key.Reason)
                .ThenBy(g => g.Key.Type)
                .ToList();

            int groupIndex = 0;
            foreach (var group in groups)
            {
                var canApproveInGroup = group.Where(x => x.CanApprove == 1).ToList();
                var groupId = $"scrap-group-{groupIndex}";
                var typeClass = group.Key.Type?.ToLower() switch {
                    "wire" => "scrap-type-wire",
                    "component" => "scrap-type-component",
                    _ => "scrap-type-other"
                };
                var typeIcon = group.Key.Type?.ToLower() switch {
                    "wire" => "bi-lightning",
                    "component" => "bi-cpu",
                    _ => "bi-tag"
                };

                <div class="scrap-group" id="@groupId">
                    <div class="scrap-group-header" onclick="toggleScrapGroup('@groupId', event)">
                        <div class="scrap-group-title">
                            <i class="bi @typeIcon" style="color:rgba(255,255,255,0.7); font-size:15px;"></i>
                            <span>@group.Key.Reason</span>
                            <span class="scrap-type-badge @typeClass">
                                @(group.Key.Type ?? "Other")
                            </span>
                            <span class="scrap-group-count">@group.Count() items</span>
                            @if (canApproveInGroup.Any())
                            {
                                <span style="font-size:11px; color:#86efac; font-weight:600;">
                                    ✓ @canApproveInGroup.Count() ready
                                </span>
                            }
                        </div>
                        <div class="scrap-group-actions" onclick="event.stopPropagation()">
                            @if (!canViewAllData && canApproveInGroup.Any())
                            {
                                            <button class="btn-select-group"
                                                    data-group="@groupId"
                                                    onclick="selectGroup('@groupId', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(canApproveInGroup.Select(x => x.ScrapId).ToList())))">
                                                <i class="bi bi-check-all"></i> Select All
                                            </button>
                                <button class="btn-bulk-approve"
                                        id="bulk-approve-@groupId"
                                        onclick="approveGroup(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(canApproveInGroup.Select(x => x.ScrapId).ToList())))">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Approve All (@canApproveInGroup.Count())
                                </button>
                            }
                            <i class="bi bi-chevron-down expand-chevron"></i>
                        </div>
                    </div>

                    <div class="scrap-group-body">
                        <table class="professional-table">
                            <thead>
                                <tr>
                                    @if (!canViewAllData && itemsUserCanApprove > 0)
                                    {
                                        <th width="35">
                                            <input type="checkbox" 
                                                   onchange="toggleGroupRows('@groupId', this)">
                                        </th>
                                    }
                                    <th>Part Number</th>
                                    <th>Qty</th>
                                    <th>Status</th>
                                    <th>Approval Flow</th>
                                    <th>Submitted By</th>
                                    <th>Date</th>
                                    @if (!canViewAllData)
                                    {
                                        <th>Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    var canUserApprove = item.CanApprove == 1;
                                    var statusClass = item.Status switch {
                                        "Pending TL" => "pending-tl",
                                        "Pending GL" => "pending-gl",
                                        "Pending Manager" => "pending-manager",
                                        "Pending Senior Manager" => "pending-senior-manager",
                                        "Approved" => "approved",
                                        "Rejected" => "rejected",
                                        _ => "pending-tl"
                                    };

                                    <tr id="row-@item.ScrapId" 
                                        class="@(canUserApprove ? "" : "row-disabled")">
                                        @if (!canViewAllData && itemsUserCanApprove > 0)
                                        {
                                            <td>
                                                @if (canUserApprove)
                                                {
                                                    <input type="checkbox" 
                                                           class="row-checkbox" 
                                                           data-id="@item.ScrapId"
                                                           data-group="@groupId"
                                                           onchange="updateBulkButtonStates()">
                                                }
                                                else
                                                {
                                                    <input type="checkbox" disabled>
                                                }
                                            </td>
                                        }
                                        <td><strong>@item.PartNumber</strong></td>
                                        <td>@item.Quantity</td>
                                        <td>
                                            <span class="status-badge @statusClass">@item.Status</span>
                                        </td>
                                        <td>
                                            <div class="approval-flow">
                                                @for (int level = 1; level <= 4; level++)
                                                {
                                                    string stepClass = "pending";
                                                    switch (level)
                                                    {
                                                        case 1:
                                                            if (item.TeamLeaderApprovalStatus == "Approved") stepClass = "completed";
                                                            else if (item.TeamLeaderApprovalStatus == "Rejected") stepClass = "rejected";
                                                            else if (item.Status == "Pending TL") stepClass = "current";
                                                            break;
                                                        case 2:
                                                            if (item.GroupLeaderApprovalStatus == "Approved") stepClass = "completed";
                                                            else if (item.GroupLeaderApprovalStatus == "Rejected") stepClass = "rejected";
                                                            else if (item.Status == "Pending GL") stepClass = "current";
                                                            break;
                                                        case 3:
                                                            if (item.ManagerApprovalStatus == "Approved") stepClass = "completed";
                                                            else if (item.ManagerApprovalStatus == "Rejected") stepClass = "rejected";
                                                            else if (item.Status == "Pending Manager") stepClass = "current";
                                                            break;
                                                        case 4:
                                                            if (item.SeniorManagerApprovalStatus == "Approved") stepClass = "completed";
                                                            else if (item.SeniorManagerApprovalStatus == "Rejected") stepClass = "rejected";
                                                            else if (item.Status == "Pending Senior Manager") stepClass = "current";
                                                            break;
                                                    }
                                                    <div class="approval-step @stepClass">@level</div>
                                                    if (level < 4) { <i class="bi bi-arrow-right"></i> }
                                                }
                                            </div>
                                        </td>
                                        <td>@item.SubmittedBy</td>
                                        <td>@(item.SubmissionDate?.ToString("yyyy-MM-dd HH:mm") ?? item.CreatedAt.ToString("yyyy-MM-dd HH:mm"))</td>
                                        @if (!canViewAllData)
                                        {
                                            <td>
                                                @if (canUserApprove)
                                                {
                                                    <button class="btn-professional btn-professional-success btn-sm" 
                                                            onclick="approveItem(@item.ScrapId)">
                                                        <i class="bi bi-check"></i> Approve
                                                    </button>
                                                }
                                                else
                                                {
                                                    <small style="color:#6c757d;">
                                                        @if (item.Status == "Approved") { <span style="color:#28a745;">✓ Done</span> }
                                                        else if (item.Status == "Rejected") { <span style="color:#dc3545;">✗ Rejected</span> }
                                                        else { <span>⏳ Waiting</span> }
                                                    </small>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                groupIndex++;
            }
        }
        else
        {
            <div class="text-center py-4" style="color:#6c757d;">
                No scrap items found for your current view.
            </div>
        }
    </div>
</div>
    </div>
</div>
  



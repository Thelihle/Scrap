    font-size: 16px;
    background: white;
    color: #1a1a2e !important;
}

.copy-btn {
    padding: 0.75rem 1rem;
    background: #428bca;
    color: white !important;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.copy-btn:hover {
    background: #357abd;
}

.copy-success {
    display: none;
    color: #28a745 !important;
    font-weight: 600;
    margin-top: 0.5rem;
}

/* === HIDE AI ASSISTANT === */
.management-ai-assistant {
    display: none !important; /* Remove this component entirely */
}

/* === CARDS === */
.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
}

.card {

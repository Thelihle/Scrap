        function updateBulkButtonStates() {
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
            const bulkApproveBtn = document.getElementById('bulk-approve-btn');
            const hasSelection = checkedBoxes.length > 0;

            // Update Select All Ready button label
            const allCheckboxes = document.querySelectorAll('.row-checkbox:not(:disabled)');
            const allChecked = allCheckboxes.length > 0 && Array.from(allCheckboxes).every(cb => cb.checked);
            const selectAllBtn = document.querySelector('button[onclick="selectAllReady()"]');
            if (selectAllBtn) {
                const total = allCheckboxes.length;
                if (allChecked) {
                    selectAllBtn.innerHTML = `<i class="bi bi-x-circle"></i> Deselect All (${total})`;
                    selectAllBtn.style.borderColor = 'rgba(248,113,113,0.8)';
                    selectAllBtn.style.color = '#fca5a5';
                } else {
                    selectAllBtn.innerHTML = `<i class="bi bi-check2-all"></i> Select All Ready (${total})`;
                    selectAllBtn.style.borderColor = 'rgba(255,255,255,0.6)';
                    selectAllBtn.style.color = 'white';
                }
            }

            if (bulkApproveBtn) {
                bulkApproveBtn.disabled = !hasSelection;
                bulkApproveBtn.style.opacity = hasSelection ? '1' : '0.5';
                bulkApproveBtn.style.cursor = hasSelection ? 'pointer' : 'not-allowed';
                if (hasSelection) {
                    bulkApproveBtn.innerHTML = `<i class="bi bi-check-circle-fill"></i> Bulk Approve (${checkedBoxes.length})`;
                } else {
                    bulkApproveBtn.innerHTML = `<i class="bi bi-check-circle-fill"></i> Bulk Approve`;
                }
            }

            // ✅ NEW: Update each group's Select All button
            document.querySelectorAll('.btn-select-group[data-group]').forEach(btn => {
                const groupId = btn.getAttribute('data-group');
                if (!groupId) return;

                const groupCheckboxes = document.querySelectorAll(
                    `.row-checkbox[data-group="${groupId}"]:not(:disabled)`
                );
                const allGroupChecked = groupCheckboxes.length > 0 &&
                    Array.from(groupCheckboxes).every(cb => cb.checked);

                if (allGroupChecked) {
                    btn.innerHTML = `<i class="bi bi-x-circle"></i> Deselect`;
                    btn.style.background = 'rgba(248,113,113,0.2)';
                    btn.style.borderColor = 'rgba(248,113,113,0.6)';
                    btn.style.color = '#fca5a5';
                } else {
                    btn.innerHTML = `<i class="bi bi-check-all"></i> Select All`;
                    btn.style.background = 'rgba(255,255,255,0.1)';
                    btn.style.borderColor = 'rgba(255,255,255,0.3)';
                    btn.style.color = 'white';
                }
            });
        }

        function selectAllReady() {
            const allCheckboxes = document.querySelectorAll('.row-checkbox:not(:disabled)');
            const allChecked = Array.from(allCheckboxes).every(cb => cb.checked);

            // If all are checked → deselect all. Otherwise → select all.
            allCheckboxes.forEach(cb => {
                cb.checked = !allChecked;

                // Expand group if selecting so user can see
                if (!allChecked) {
                    const groupId = cb.getAttribute('data-group');
                    if (groupId) {
                        const group = document.getElementById(groupId);
                        if (group) group.classList.remove('collapsed');
                    }
                }
            });

            updateBulkButtonStates();

            const count = document.querySelectorAll('.row-checkbox:checked').length;
            if (count > 0) {
                showNotification(`Selected ${count} items ready for approval`, 'success');
            } else {
                showNotification('All items deselected', 'info');
            }
        }

        window.selectAllReady = selectAllReady;

function bulkApprove() {
    const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
    if (checkedBoxes.length === 0) {
        showNotification('Please select items to approve', 'error');
        return;
    }
    const scrapIds = Array.from(checkedBoxes).map(cb => parseInt(cb.dataset.id));
    if (confirm(`Are you sure you want to approve ${scrapIds.length} item(s)?`)) {
        processApproval(scrapIds, true);
    }
}

function bulkReject() {
    const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
    if (checkedBoxes.length === 0) {
        showNotification('Please select items to reject', 'error');
        return;
    }
    const scrapIds = Array.from(checkedBoxes).map(cb => parseInt(cb.dataset.id));
    document.getElementById('rejectScrapId').value = scrapIds.join(',');
    document.getElementById('isBulkReject').value = 'true';
    document.getElementById('rejectReason').value = '';
    showModal('rejectModal');
}

function approveItem(scrapId) {
    if (confirm('Are you sure you want to approve this item?')) {
        processApproval([scrapId], true);
    }
}

function rejectItem(scrapId) {
    document.getElementById('rejectScrapId').value = scrapId;
    document.getElementById('isBulkReject').value = 'false';
    document.getElementById('rejectReason').value = '';
    showModal('rejectModal');
}

function confirmReject() {
    const rejectReason = document.getElementById('rejectReason')?.value?.trim();
    if (!rejectReason) {
        showError('rejectError', 'Please provide a reason for rejection');
        return;
    }
    const scrapIdValue = document.getElementById('rejectScrapId')?.value;
    const isBulkReject = document.getElementById('isBulkReject')?.value === 'true';
    let scrapIds;
    if (isBulkReject) {
        scrapIds = scrapIdValue.split(',').map(id => parseInt(id.trim()));
    } else {
        scrapIds = [parseInt(scrapIdValue)];
    }
    hideModal('rejectModal');
    processApproval(scrapIds, false, rejectReason);
}

async function processApproval(scrapIds, isApproved, rejectReason = '') {
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenInput?.value;

    if (!token) {
        showNotification('Security token not found. Please refresh the page.', 'error');
        return;
    }

    const isBulk = scrapIds.length > 1;
    let loadingMessage = isApproved
        ? (isBulk ? `Approving ${scrapIds.length} items...` : 'Approving item...')
        : (isBulk ? `Rejecting ${scrapIds.length} items...` : 'Rejecting item...');

    showNotification(loadingMessage, 'info');

    try {
        const response = await fetch('/ScrapApproval/ProcessApproval', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                ScrapIds: scrapIds,
                IsApproved: isApproved,
                RejectReason: rejectReason || ''
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();

        if (data.success) {
            const action = isApproved ? 'approved' : 'rejected';
            showNotification(`Successfully ${action} ${data.processedCount || scrapIds.length} item(s)!`, 'success');
            setTimeout(() => window.location.reload(), 1500);
        } else {
            showNotification(data.message || 'Error processing approval', 'error');
        }
    } catch (error) {
        console.error('Error processing approval:', error);
        showNotification(`Error: ${error.message}`, 'error');
    }
}



function applyDateFilter() {
    const startDate = document.getElementById('filterStartDate')?.value;
    const endDate = document.getElementById('filterEndDate')?.value;
    
    if (!startDate && !endDate) {
        // No filter - show all
        filteredScrapData = [...originalScrapData];
    } else {
        filteredScrapData = originalScrapData.filter(item => {
            const itemDate = new Date(item.submissionDate || item.createdAt);
            const start = startDate ? new Date(startDate) : null;
            const end = endDate ? new Date(endDate + 'T23:59:59') : null;
            
            if (start && end) {
                return itemDate >= start && itemDate <= end;
            } else if (start) {
                return itemDate >= start;
            } else if (end) {
                return itemDate <= end;
            }
            return true;
        });
    }
    
    // Update the data and refresh views
    scrapItemsData = [...filteredScrapData];
    
    // ✅ Update filter count display
    const filterResultCount = document.getElementById('filterResultCount');
    const filterCount = document.getElementById('filterCount');
    if (filterResultCount && filterCount) {
        filterCount.textContent = scrapItemsData.length;
        filterResultCount.style.display = 'inline-block';
    }
    
    showNotification(`Showing ${scrapItemsData.length} of ${originalScrapData.length} items`, 'success');
    
    // Refresh current view
    if (currentView === 'grouped') {
        buildGroupedView();
    } else {
        refreshFlatView();
    }
}

function clearDateFilter() {
    document.getElementById('filterStartDate').value = '';
    document.getElementById('filterEndDate').value = '';
    scrapItemsData = [...originalScrapData];
    filteredScrapData = [...originalScrapData];
    
    showNotification('Date filter cleared', 'info');
    
    if (currentView === 'grouped') {
        buildGroupedView();
    } else {
        refreshFlatView();
    }
}

function setToday() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('filterStartDate').value = today;
    document.getElementById('filterEndDate').value = today;
    applyDateFilter();
}

function setThisWeek() {
    const today = new Date();
    const firstDay = new Date(today.setDate(today.getDate() - today.getDay()));
    const lastDay = new Date(today.setDate(today.getDate() - today.getDay() + 6));
    
    document.getElementById('filterStartDate').value = firstDay.toISOString().split('T')[0];
    document.getElementById('filterEndDate').value = lastDay.toISOString().split('T')[0];
    applyDateFilter();
}

function setThisMonth() {
    const today = new Date();
    const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
    const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    
    document.getElementById('filterStartDate').value = firstDay.toISOString().split('T')[0];
    document.getElementById('filterEndDate').value = lastDay.toISOString().split('T')[0];
    applyDateFilter();
}

function refreshFlatView() {
    const tbody = document.getElementById('flatViewTableBody');
    if (!tbody) return;
    
    // Rebuild the flat view table with filtered data
    tbody.innerHTML = '';
    
    if (scrapItemsData.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="11" class="text-center py-4" style="color: #6c757d;">
                    No scrap items match the selected date range.
                </td>
            </tr>
        `;
        return;
    }
    
    // Regenerate rows
    scrapItemsData.forEach(item => {
        const row = createFlatViewRow(item);
        tbody.innerHTML += row;
    });
}

function createFlatViewRow(item) {
    const canViewAll = '@canViewAllData'.toLowerCase() === 'true';
    const itemsUserCanApprove = @itemsUserCanApprove;
    const canUserApprove = item.canApprove === 1;
    const rowClass = canUserApprove ? '' : 'row-disabled';
    const statusClass = getStatusClass(item.status);
    
    let html = `<tr class="${rowClass}">`;
    
    // Checkbox column (if applicable)
    if (!canViewAll && itemsUserCanApprove > 0) {
        if (canUserApprove) {
            html += `<td><input type="checkbox" class="row-checkbox" data-id="${item.scrapId}"></td>`;
        } else {
            html += `<td><input type="checkbox" disabled></td>`;
        }
    }
    
    html += `
        <td>${escapeHtml(item.partNumber)}</td>
        <td>${item.quantity}</td>
        <td><span class="status-badge ${statusClass}">${escapeHtml(item.status)}</span></td>
        <td>${createApprovalFlow(item)}</td>
        <td>${escapeHtml(item.submittedBy)}</td>
        <td>${formatDate(item.submissionDate || item.createdAt)}</td>
    `;
    
    // Actions column (if applicable)
    if (!canViewAll) {
        if (canUserApprove) {
            html += `
                <td>
                    <div class="d-flex gap-1">
                        <button class="btn-professional btn-professional-success btn-sm" onclick="approveItem(${item.scrapId})">
                            <i class="bi bi-check"></i> Approve
                        </button>
                    </div>
                </td>
            `;
        } else {
            let statusIcon = '';
            if (item.status === 'Approved') {
                statusIcon = '<i class="bi bi-check-circle" style="color: #28a745;"></i> Approved';
            } else if (item.status === 'Rejected') {
                statusIcon = '<i class="bi bi-x-circle" style="color: #dc3545;"></i> Rejected';
            } else {
                statusIcon = '<i class="bi bi-clock" style="color: #ffc107;"></i> Waiting';
            }
            html += `<td><small style="color: #6c757d;">${statusIcon}</small></td>`;
        }
    }
    
    html += `</tr>`;
    return html;
}


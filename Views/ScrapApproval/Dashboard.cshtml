            group.querySelectorAll('.row-checkbox').forEach(cb => {
                if (!cb.disabled) cb.checked = masterCb.checked;
            });
            updateBulkButtonStates();
        }

        function approveGroup(scrapIds) {
            if (!scrapIds || scrapIds.length === 0) return;
            if (confirm(`Approve all ${scrapIds.length} items in this group?`)) {
                processApproval(scrapIds, true);
            }
        }

        // Make global
        window.toggleScrapGroup = toggleScrapGroup;
        window.selectGroup = selectGroup;
        window.toggleGroupRows = toggleGroupRows;
        window.approveGroup = approveGroup;

        // Make function globally available
        window.confirmBomBackfill = confirmBomBackfill;
        window.processBomBackfill = processBomBackfill;
        window.submitScrapLocationUpdate = submitScrapLocationUpdate;
</script>
</body>
</html>


    background: #28a745;
    color: white;
}

.btn-professional-danger {
    border-color: #dc3545;
    color: #dc3545;
}

.btn-professional-danger:hover {
    background: #dc3545;
    color: white;
}

.btn-sm {
    padding: 8px 12px;
    font-size: 13px;
    min-height: 40px;
}

/* === TEAM LEADER WEIGHT MANAGEMENT - COMPACT & VISIBLE === */
.card.team-leader-weight {
    margin-bottom: 1rem;
}


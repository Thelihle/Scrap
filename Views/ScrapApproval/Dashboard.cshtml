                            <strong>Assigned:</strong> ${new Date(scanner.HandoverDate).toLocaleString()}<br>
                            <strong>Location:</strong> ${scanner.Department}/${scanner.Line}/${scanner.Shift}
                        </div>
                        <div class="col-md-6">
                            <strong>Condition at Handover:</strong>
                            <span class="${scanner.IsInGoodCondition ? 'text-success' : 'text-warning'}">
                                ${scanner.IsInGoodCondition ? 'Good' : 'Issues Noted'}
                            </span><br>
                            <strong>Battery at Handover:</strong>
                            <span class="${scanner.IsFullyCharged ? 'text-success' : 'text-warning'}">
                                ${scanner.ChargeLevel}%
                            </span><br>
                            ${scanner.ConditionNotes ? `<strong>Notes:</strong> ${scanner.ConditionNotes}` : ''}
                        </div>
                    </div>
                `;

                statusDiv.style.display = 'block';
            } else {
                statusDiv.style.display = 'none';
            }
        })
        .catch(error => {
            console.error('Error loading scanner status:', error);
        });
}

function loadScannerForReturn() {
    fetch('/ScrapApproval/GetScannerStatus')

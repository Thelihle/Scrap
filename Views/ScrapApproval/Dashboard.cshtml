function submitScrapLocationUpdate() {
    const errorDiv = document.getElementById('scrapLocationError');
    if (errorDiv) errorDiv.style.display = 'none';
    
    const checked = document.querySelectorAll('.row-checkbox:checked');
    
    if (checked.length === 0) {
        showError('scrapLocationError', 'Please select scrap items first');
        return;
    }
    
    const department = document.getElementById('scrapUpdateDepartment')?.value;
    const line = document.getElementById('scrapUpdateLine')?.value;
    const shift = document.getElementById('scrapUpdateShift')?.value;
    
    if (!department || !line || !shift) {
        showError('scrapLocationError', 'All fields are required');
        return;
    }
    
    const scrapIds = Array.from(checked).map(cb => parseInt(cb.dataset.id));
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    if (!token) {
        showError('scrapLocationError', 'Security token not found');
        return;
    }
    
    const payload = {
        ScrapIds: scrapIds,
        Department: department,
        Line: line,
        Shift: shift
    };
    
    showNotification(`Updating ${scrapIds.length} scrap item(s)...`, 'info');
    
    fetch('/ScrapApproval/UpdateScrapLocation', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify(payload)
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
    })
    .then(res => {
        if (res.success) {
            showNotification(res.message, 'success');
            hideModal('updateScrapLocationModal');
            setTimeout(() => location.reload(), 1000);
        } else {
            showError('scrapLocationError', res.message);
        }
    })
    .catch(err => {
        console.error('Error updating scrap location:', err);
        showError('scrapLocationError', `Error: ${err.message}`);
    });
}



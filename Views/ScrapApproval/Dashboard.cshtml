<script>
// Professional Theme Modal System - CORRECTED VERSION

document.addEventListener('DOMContentLoaded', function() {
    console.log('🔧 Loading modal system...');

    // Clean initial state
    document.body.classList.remove('modal-open');
    document.querySelectorAll('.modal-professional').forEach(modal => {
        modal.style.display = 'none';
        modal.classList.remove('show');
    });

    // CRITICAL: Prevent modal backdrop from intercepting clicks on modal content
    document.addEventListener('click', function(e) {
        // Only close modal if clicking directly on the backdrop, not its children
        if (e.target.classList.contains('modal-professional') && 
            e.target.classList.contains('show')) {
            hideModal(e.target.id);
        }
    }, true); // Use capture phase

    // CRITICAL: Prevent form submissions from closing modals
    document.querySelectorAll('.modal-professional form').forEach(form => {
        form.addEventListener('submit', function(e) {
            // Only prevent default if it's not a form with action attribute
            if (!this.getAttribute('action') || this.getAttribute('action').includes('#')) {
                e.preventDefault();
                e.stopPropagation();
            }
        });
    });

    // Initialize everything
    initializeModalHandlers();
    initializeAllButtons();
    initializeLocationForm();
    initializeApprovalSystem();
    initializeScannerManagement();

    console.log('✅ Modal system loaded successfully');
});

        function initializeAllButtons() {
            console.log('🔧 Setting up button event listeners...');

            const buttons = {
                newUserButton: () => showModal('newUserModal'),
                resetPasswordButton: () => showModal('resetPasswordModal'),
                updateLocationBtn: () => { populateLocationForm(); showModal('locationModal'); },
                viewAllUsersButton: () => { loadAllUsers(); showModal('viewUsersModal'); },
                viewPendingRequestsButton: () => { loadPendingRequests(); showModal('viewRequestsModal'); },
                scannerHandoverButton: () => { loadAvailableScanners(); showModal('scannerHandoverModal'); },
                returnScannerButton: () => { loadScannerForReturn(); showModal('scannerReturnModal'); },
                scannerStatusButton: loadScannerStatus,
                saveLocationWeightBtn: saveTeamLeaderWeight,
                submitLocationBtn: submitLocationForm,
                backfillBomButton: confirmBomBackfill
            };

            Object.entries(buttons).forEach(([id, handler]) => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        handler();
                    });
                }
            });

            console.log('✅ All buttons initialized');
        }

        function submitLocationForm() {
            const errorDiv = document.getElementById('locationError');
            if (errorDiv) errorDiv.style.display = 'none';

            const department = document.getElementById('updateDepartment')?.value;
            const lineRaw    = document.getElementById('updateLine')?.value;
            const shift      = document.getElementById('updateShift')?.value;
            const token      = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            if (!department || !lineRaw || !shift) {
                showError('locationError', 'Department, Line and Shift are required');
                return;
            }

            const subAreaSelect = document.getElementById('subAreaSelect');
            if (subAreaSelect && !subAreaSelect.value) {
                showError('locationError', 'Please select an Area.');
                return;
            }

            const selectedMachines = Array.from(
                document.querySelectorAll('.machine-checkbox:checked')
            ).map(cb => cb.value);

            // Build the actual Line value to save:
            // - subAreaSelect present (Ford zone → area, or non-Ford zoned line) → "<lineRaw> - <area>"
            // - Everything else (Engineering Scrap, flat lines) → lineRaw unchanged
            let line = lineRaw;
            if (subAreaSelect && subAreaSelect.value) {
                line = `${lineRaw} - ${subAreaSelect.value}`;
            }

            if (isFordPreAssemblyDept(department) && lineRaw !== 'Engineering Scrap' && !subAreaSelect) {
                showError('locationError', 'Please select an Area (e.g. Komax) for this zone.');
                return;
            }

            const submitBtn = document.getElementById('submitLocationBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Updating...';
            submitBtn.disabled = true;

            fetch('/ScrapApproval/UpdateLocation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    Department: department,
                    Line: line,
                    Shift: shift,
                    MachineNumber: selectedMachines.join(', ')   // ✅ ADD
                })
            })
            .then(r => r.json())
            .then(data => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                if (data.success) {
                    let msg = `Location updated: ${department} / ${line} / ${shift}`;
                    if (selectedMachines.length > 0) {
                        msg += ` — Machines: ${selectedMachines.join(', ')}`;
                    }
                    showNotification(msg, 'success');
                    hideModal('locationModal');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showError('locationError', data.message || 'Error updating location');
                }
            })
            .catch(error => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                showError('locationError', `Error: ${error.message}`);
            });
        }

        function initializeModalHandlers() {
    console.log('🔧 Initializing modal handlers...');

    document.querySelectorAll('.modal-professional').forEach(modal => {
        // Backdrop click
        modal.addEventListener('click', function(event) {
            if (event.target === modal) {
                hideModal(modal.id);
            }
        });

        // Prevent content clicks from bubbling
        const modalDialog = modal.querySelector('.modal-dialog');
        if (modalDialog) {
            modalDialog.addEventListener('click', function(event) {
                event.stopPropagation();
            });
        }

        // Close button
        const closeBtn = modal.querySelector('.btn-close-professional');
        if (closeBtn) {
            closeBtn.addEventListener('click', function(event) {
                event.preventDefault();
                event.stopPropagation();
                hideModal(modal.id);
            });
        }
    });

    // Escape key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            const openModal = document.querySelector('.modal-professional.show');
            if (openModal) {
                hideModal(openModal.id);
            }
        }
    });
}

function showModal(modalId) {
    console.log('🔧 Showing modal:', modalId);

    // Hide all modals first
    document.querySelectorAll('.modal-professional').forEach(modal => {
        modal.classList.remove('show');
        modal.style.display = 'none';
    });

    const modal = document.getElementById(modalId);
    if (modal) {
        // Clear errors
        const errorEl = modal.querySelector('[id$="Error"]');
        if (errorEl) errorEl.style.display = 'none';

        // Show modal
        modal.style.display = 'flex';
        modal.classList.add('show');
        document.body.classList.add('modal-open');

        // Focus first input
        setTimeout(() => {
            const firstInput = modal.querySelector('input:not([readonly]):not([type="hidden"]):not([disabled]), select:not([disabled])');
            if (firstInput) firstInput.focus();
        }, 100);

        console.log('✅ Modal shown:', modalId);
    }
}

function hideModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('show');
        modal.style.display = 'none';
        document.body.classList.remove('modal-open');

        // Clear forms
        const form = modal.querySelector('form');
        if (form) form.reset();
    }
}


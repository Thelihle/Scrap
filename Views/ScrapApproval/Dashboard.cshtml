function confirmBomBackfill() {
    const message = `This will process all approved scrap items that don't have BOM components yet.

- Category B parts will be stored as raw materials
- Category M parts will be exploded to components

This may take a few minutes for large datasets.

Continue?`;
    
    if (!confirm(message)) {
        return;
    }
    
    processBomBackfill();
}

async function processBomBackfill() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    if (!token) {
        showNotification('Security token not found. Please refresh the page.', 'error');
        return;
    }
    
    // Show loading notification
    showNotification('Starting BOM backfill process... This may take several minutes. Please wait.', 'info');
    
    try {
        const response = await fetch('/ScrapApproval/BackfillBomComponents', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            }
        });
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const data = await response.json();
        
        if (data.success) {
            // Show success with detailed breakdown
            let message = data.message;
            
            if (data.details) {
                message += `\n\nDetails:\n`;
                message += `• Bought-out parts (B): ${data.details.categoryBCount}\n`;
                message += `• Manufactured parts (M): ${data.details.categoryMCount}\n`;
                message += `• Total components: ${data.details.componentsAdded}\n`;
                message += `• Errors: ${data.details.errorCount}`;
            }
            
            showNotification(data.message, 'success');
            
            // Optional: Show detailed alert
            if (data.details && data.details.componentsAdded > 0) {
                setTimeout(() => {
                    alert(`BOM Backfill Summary:\n\n` +
                          `✓ Bought-out parts (B): ${data.details.categoryBCount}\n` +
                          `✓ Manufactured parts (M): ${data.details.categoryMCount}\n` +
                          `✓ Total components added: ${data.details.componentsAdded}\n` +
                          `${data.details.errorCount > 0 ? `⚠ Errors: ${data.details.errorCount}` : '✓ No errors'}`);
                }, 500);
            }
        } else {
            showNotification(data.message || 'BOM backfill failed', 'error');
        }
    } catch (error) {
        console.error('Error during BOM backfill:', error);
        showNotification(`Error: ${error.message}`, 'error');
    }
}


}

.weight-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #28a745;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
}

.no-weight-badge {
    background: #6c757d;
}

/* Location actions */
.location-actions {
    display: flex;
    gap: 0.5rem;

function buildDeptOptions() {
    const depts = [
        'FORD','HILUX','HIACE','CSUV','CSUV SCRAP','FIELLI','PLANT C',
        'PRE-ASSEMBLY FORD','PRE-ASSEMBLY ISUZU','PRE-ASSEMBLY TSAM','PRE-ASSEMBLY CSUV',
        'ENGINEERING','ENGINEERING PLANT A','ENGINEERING PLANT B',
        'ENGINEERING PLANT C','ENGINEERING FIELLI',
        'SQA','STORES','PROCESS','KANBAN','PROJECT','QUALITY',
        'QUANTUM REWORK','HILUX REWORK','FIELLI REWORK',
        'FINAL ASSY-CSUV REWORK','FINAL ASSY-ISUZU REWORK','FINAL ASSY-FORD REWORK',
        'PRE ASSY-CSUV REWORK','PRE ASSY-ISUZU REWORK',
        'PRE ASSY-TSAM REWORK','PRE ASSY-FORD REWORK','PROJECT 581D REWORK'
    ];
    return depts.map(d => `<option value="${d}">${d}</option>`).join('');
}


  async function loadFilteredData() {
    const plant  = document.getElementById('adm-plant')?.value   || '';
    const dept   = document.getElementById('adm-dept')?.value    || '';
    const status = document.getElementById('adm-status')?.value  || '';
    const days   = document.getElementById('adm-days')?.value    || '30';
    const shift  = document.getElementById('adm-shift')?.value   || '';

    if (!plant) {
        showNotification('Please select a plant first', 'error');
        return;
    }

    const statusEl = document.getElementById('adm-load-status');
    if (statusEl) statusEl.style.display = 'inline';

    const params = new URLSearchParams();

    // If specific dept chosen, use it. Otherwise pass all depts for the plant.
    if (dept) {
        params.append('department', dept);
    } else if (plant !== 'ALL') {
        // Pass all departments for the plant as a comma-separated list
        const plantDepts = PLANT_DEPARTMENTS[plant] || [];
        params.append('departments', plantDepts.join(','));
    }
    // If plant === 'ALL' and no dept, no department filter — loads everything

    if (status) params.append('status', status);
    if (days && days !== '0') params.append('days', days);
    if (shift)  params.append('shift', shift);

    try {
        const resp = await fetch(`/ScrapApproval/GetScrapDataFiltered?${params}`);
        const json = await resp.json();

        if (!json.success) throw new Error(json.message);

        scrapItemsData    = json.data || [];
        originalScrapData = [...scrapItemsData];
        filteredScrapData = [...scrapItemsData];

        if (statusEl) statusEl.style.display = 'none';

        updateStatCards();
        showNotification(`Loaded ${scrapItemsData.length} items`, 'success');
        buildGroupedView();

    } catch (err) {
        if (statusEl) {
            statusEl.textContent = 'Error: ' + err.message;
            statusEl.style.display = 'inline';
        }
        showNotification('Error loading data: ' + err.message, 'error');
    }
}

// ✅ NEW — refreshes the 4 stat cards after data loads
function updateStatCards() {
    const total    = scrapItemsData.length;
    const approved = scrapItemsData.filter(x => x.status === 'Approved').length;
    const rejected = scrapItemsData.filter(x => x.status === 'Rejected').length;
    const cost     = scrapItemsData.reduce((s, x) => s + (parseFloat(x.totalItemCost) || 0), 0);

    // Target the stat-value elements inside .stats-row
    const statCards = document.querySelectorAll('.stat-card .stat-value');
    if (statCards[0]) statCards[0].textContent = total;
    if (statCards[1]) statCards[1].textContent = 'R ' + cost.toFixed(2);
    if (statCards[2]) statCards[2].textContent = approved;
    if (statCards[3]) statCards[3].textContent = rejected;
}



function toggleView(view) {
    console.log('🔄 Toggling view to:', view);
    currentView = view;
    
    const groupedView = document.getElementById('groupedView');
    const flatView = document.getElementById('flatView');
    const groupedBtn = document.getElementById('groupedViewBtn');
    const flatBtn = document.getElementById('flatViewBtn');
    
    if (view === 'grouped') {
        groupedView.style.display = 'block';
        flatView.style.display = 'none';
        groupedBtn.classList.add('active');
        flatBtn.classList.remove('active');
        
        // Always rebuild grouped view when switching to it
        buildGroupedView();
    } else {
        groupedView.style.display = 'none';
        flatView.style.display = 'block';
        flatBtn.classList.add('active');
        groupedBtn.classList.remove('active');
    }
}



function buildGroupedView() {

    // Right at the start of buildGroupedView function, add:
    console.log('📋 Sample item data:', scrapItemsData.slice(0, 2));
    console.log('🏗️ Building grouped view with', scrapItemsData?.length || 0, 'items');
    const container = document.getElementById('locationGroupsContainer');
    
    if (!container) return;
    
    if (!scrapItemsData || scrapItemsData.length === 0) {
        const canViewAll = '@(canViewAllData)'.toLowerCase() === 'true';
        if (canViewAll) {
            // Admin with no data loaded — show filter panel again
            renderAdminFilterPanel();
        } else {
            container.innerHTML = `
                <div class="alert-professional info">
                    <h4><i class="bi bi-info-circle"></i> No Data</h4>
                    <p>No scrap items found for your current location and access level.</p>
                </div>`;
        }
        return;
    }
    
    if (!scrapItemsData || scrapItemsData.length === 0) {
        container.innerHTML = `
            <div class="alert-professional info">
                <h4><i class="bi bi-info-circle"></i> No Data</h4>
                <p>No scrap items found for your current location and access level.</p>
            </div>
        `;
        return;
    }
    
    // Group items by location (Department + Line + Shift)
    const grouped = {};
    
    scrapItemsData.forEach(item => {
        // Extract location - using camelCase field names (ASP.NET Core default JSON serialization)
        const dept = item.department || 'Unknown';
        const line = item.line || 'Unknown';
        const shift = item.shift || 'Unknown';
        
        const locationKey = `${dept}|${line}|${shift}`;
        
        if (!grouped[locationKey]) {
            grouped[locationKey] = {
                department: dept,
                line: line,
                shift: shift,
                items: [],
                totalCost: 0,
                totalQuantity: 0,
                approvedCount: 0,
                pendingCount: 0,
                rejectedCount: 0,
                totalWeight: 0,
                submitters: new Map(),
                approvers: {
                    teamLeaders: new Map(),
                    groupLeaders: new Map(),
                    managers: new Map()
                }
            };
        }
        
        // Add item to location group
        grouped[locationKey].items.push(item);
        grouped[locationKey].totalCost += parseFloat(item.totalItemCost) || 0;
        grouped[locationKey].totalQuantity += parseInt(item.quantity) || 0;
        
        
        // Track submitters with full details
        if (item.submittedBy) {
            if (!grouped[locationKey].submitters.has(item.submittedBy)) {
                grouped[locationKey].submitters.set(item.submittedBy, {
                    name: item.submittedBy,
                    clockNumber: item.submitterClockNumber || 'N/A',
                    itemCount: 0
                });
            }
            grouped[locationKey].submitters.get(item.submittedBy).itemCount++;
        }
        
        // Track approvers with full details
        if (item.TeamLeaderApprovalBy && item.TeamLeaderApprovalStatus === 'Approved') {
            if (!grouped[locationKey].approvers.teamLeaders.has(item.TeamLeaderApprovalBy)) {
                grouped[locationKey].approvers.teamLeaders.set(item.TeamLeaderApprovalBy, {
                    name: item.TeamLeaderApprovalBy,
                    clockNumber: item.TeamLeaderClockNumber || 'N/A',
                    itemsApproved: 0,
                    lastApprovalDate: null
                });
            }
            const tl = grouped[locationKey].approvers.teamLeaders.get(item.TeamLeaderApprovalBy);
            tl.itemsApproved++;
            if (item.TeamLeaderApprovalDate) {
                const date = new Date(item.TeamLeaderApprovalDate);
                if (!tl.lastApprovalDate || date > tl.lastApprovalDate) {
                    tl.lastApprovalDate = date;
                }
            }
        }
        
        if (item.GroupLeaderApprovalBy && item.GroupLeaderApprovalStatus === 'Approved') {
            if (!grouped[locationKey].approvers.groupLeaders.has(item.GroupLeaderApprovalBy)) {
                grouped[locationKey].approvers.groupLeaders.set(item.GroupLeaderApprovalBy, {
                    name: item.GroupLeaderApprovalBy,
                    clockNumber: item.GroupLeaderClockNumber || 'N/A',
                    itemsApproved: 0,
                    lastApprovalDate: null
                });
            }
            const gl = grouped[locationKey].approvers.groupLeaders.get(item.GroupLeaderApprovalBy);
            gl.itemsApproved++;
            if (item.GroupLeaderApprovalDate) {
                const date = new Date(item.GroupLeaderApprovalDate);
                if (!gl.lastApprovalDate || date > gl.lastApprovalDate) {
                    gl.lastApprovalDate = date;
                }
            }
        }
        
        if (item.ManagerApprovalBy && item.ManagerApprovalStatus === 'Approved') {
            if (!grouped[locationKey].approvers.managers.has(item.ManagerApprovalBy)) {
                grouped[locationKey].approvers.managers.set(item.ManagerApprovalBy, {
                    name: item.ManagerApprovalBy,
                    clockNumber: item.ManagerClockNumber || 'N/A',
                    itemsApproved: 0,
                    lastApprovalDate: null
                });
            }
            const mgr = grouped[locationKey].approvers.managers.get(item.ManagerApprovalBy);
            mgr.itemsApproved++;
            if (item.ManagerApprovalDate) {
                const date = new Date(item.ManagerApprovalDate);
                if (!mgr.lastApprovalDate || date > mgr.lastApprovalDate) {
                    mgr.lastApprovalDate = date;
                }
            }
        }
        
            // Count statuses - use exact matches
        const statusLower = (item.status || '').toLowerCase();
        if (statusLower === 'approved' || item.status === 'Approved') {
            grouped[locationKey].approvedCount++;
        } else if (statusLower === 'rejected' || item.status === 'Rejected') {
            grouped[locationKey].rejectedCount++;
        } else {
            grouped[locationKey].pendingCount++;
        }

            // Add weight if available
            if (item.recordedWeight) {
                grouped[locationKey].totalWeight += parseFloat(item.recordedWeight) || 0;
            }
        });
    
    console.log('📊 Created', Object.keys(grouped).length, 'location groups');
    
    // ✅ Sort groups - put "Unknown" locations at the end
    const sortedGroups = Object.entries(grouped).sort(([keyA, locA], [keyB, locB]) => {
        const aIsUnknown = locA.department === 'Unknown' || locA.line === 'Unknown';
        const bIsUnknown = locB.department === 'Unknown' || locB.line === 'Unknown';
        
        if (aIsUnknown && !bIsUnknown) return 1;
        if (!aIsUnknown && bIsUnknown) return -1;
        
        // Sort by department, then line, then shift
        if (locA.department !== locB.department) {
            return locA.department.localeCompare(locB.department);
        }
        if (locA.line !== locB.line) {
            return locA.line.localeCompare(locB.line);
        }
        return locA.shift.localeCompare(locB.shift);
    });
    
    // Build HTML
    let groupsHTML = '<div class="location-groups">';
    
    sortedGroups.forEach(([key, location], index) => {
        groupsHTML += createLocationCard(location, index);
    });
    
groupsHTML += '</div>';

// ✅ ADD a "Change Filters" bar ABOVE the groups
const filterBar = `
    <div style="background:#e8f4fd;border:2px solid #428bca;border-radius:8px;padding:0.75rem 1rem;
                margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
        <div style="font-size:13px;color:#1a1a2e;">
            <strong><i class="bi bi-funnel-fill" style="color:#428bca;"></i> Active Filter:</strong>
            <span id="activeFilterSummary" style="color:#428bca;margin-left:0.5rem;"></span>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <button class="btn-professional" onclick="renderAdminFilterPanel()"
                    style="padding:6px 14px;font-size:12px;min-height:34px;">
                <i class="bi bi-funnel"></i> Change Filters
            </button>
            <button class="btn-professional btn-professional-danger" onclick="clearAllFilters()"
                    style="padding:6px 14px;font-size:12px;min-height:34px;">
                <i class="bi bi-x-circle"></i> Clear & Reset
            </button>
        </div>
    </div>`;

container.innerHTML = filterBar + groupsHTML;

// Show what filter is active
const summary = [];
const dept   = document.getElementById('adm-dept')?.value;
const status = document.getElementById('adm-status')?.value;
const days   = document.getElementById('adm-days')?.value;
const shift  = document.getElementById('adm-shift')?.value;
if (dept)   summary.push(`Dept: ${dept}`);
if (status) summary.push(`Status: ${status}`);
if (days && days !== '0')   summary.push(`Last ${days} days`);
if (shift)  summary.push(`Shift: ${shift}`);
const summaryEl = document.getElementById('activeFilterSummary');
if (summaryEl) {
    summaryEl.textContent = summary.length > 0 
        ? summary.join(' | ') 
        : 'All data (no filters)';
}

console.log('✅ Grouped view built successfully');

}

function clearAllFilters() {
    scrapItemsData = [];
    originalScrapData = [];
    filteredScrapData = [];
    updateStatCards();
    renderAdminFilterPanel();
    showNotification('Filters cleared. Select new filters to load data.', 'info');
}


function createLocationCard(location, index) {
    const locationId = `location-${index}`;
    
    return `
        <div class="location-group" id="${locationId}">
            <div class="location-group-header" onclick="toggleLocationGroup('${locationId}')">
                <div class="location-info">
                    <div class="location-name">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>${escapeHtml(location.department)} / ${escapeHtml(location.line)} / ${escapeHtml(location.shift)}</span>
                    </div>
                    <div class="location-stats">
                        <div class="location-stat">
                            <i class="bi bi-box-seam"></i>
                            <span class="stat-value">${location.items.length}</span> items
                        </div>
                        <div class="location-stat">
                            <i class="bi bi-currency-dollar"></i>
                            <span class="stat-value">R ${location.totalCost.toFixed(2)}</span>
                        </div>
                        <div class="location-stat">
                            <i class="bi bi-people"></i>
                            <span class="stat-value">${location.submitters.size}</span> submitters
                        </div>
                        ${location.totalWeight > 0 ? `
                        <div class="location-stat">
                            <i class="bi bi-scale"></i>
                            <span class="stat-value">${location.totalWeight.toFixed(2)} kg</span>
                        </div>
                        ` : ''}
                        ${location.approvedCount > 0 ? `
                        <div class="location-stat" style="color: #28a745;">
                            <i class="bi bi-check-circle"></i>
                            <span class="stat-value">${location.approvedCount}</span> approved
                        </div>
                        ` : ''}
                        ${location.pendingCount > 0 ? `
                        <div class="location-stat" style="color: #ffc107;">
                            <i class="bi bi-clock"></i>
                            <span class="stat-value">${location.pendingCount}</span> pending
                        </div>
                        ` : ''}
                        ${location.rejectedCount > 0 ? `
                        <div class="location-stat" style="color: #dc3545;">
                            <i class="bi bi-x-circle"></i>
                            <span class="stat-value">${location.rejectedCount}</span> rejected
                        </div>
                        ` : ''}
                    </div>
                </div>
                <i class="bi bi-chevron-down expand-icon"></i>
            </div>
            
            <div class="location-group-body">
                <div class="location-group-content">
                    ${createLocationSummary(location)}
                    ${createSubmittersList(location)}
                    ${createApproversList(location)}
                    ${createWeightInfo(location)}
                    ${createLocationActions(location)}
                    ${createLocationTable(location)}
                </div>
            </div>
        </div>
    `;
}

function createLocationSummary(location) {
    return `
        <div class="detail-section">
            <h4><i class="bi bi-info-circle"></i> Location Summary</h4>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Total Items</span>
                    <span class="detail-value highlight">${location.items.length}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Total Quantity</span>
                    <span class="detail-value">${location.totalQuantity}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Total Cost Impact</span>
                    <span class="detail-value highlight">R ${location.totalCost.toFixed(2)}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Status Breakdown</span>
                    <span class="detail-value">
                        <span style="color: #28a745;">${location.approvedCount} approved</span>, 
                        <span style="color: #ffc107;">${location.pendingCount} pending</span>, 
                        <span style="color: #dc3545;">${location.rejectedCount} rejected</span>
                    </span>
                </div>
            </div>
        </div>
    `;
}

function createSubmittersList(location) {
    if (location.submitters.size === 0) {
        return '';
    }
    
    let html = `
        <div class="detail-section submitter-info">
            <h4><i class="bi bi-person-fill"></i> Submitters (${location.submitters.size})</h4>
            <div class="detail-grid">
    `;
    
    Array.from(location.submitters.values()).forEach(submitter => {
        html += `
            <div class="detail-item">
                <span class="detail-label">${escapeHtml(submitter.name)}</span>
                <span class="detail-value">
                    Clock: ${escapeHtml(submitter.clockNumber)} | 
                    ${submitter.itemCount} item${submitter.itemCount !== 1 ? 's' : ''}
                </span>
            </div>
        `;
    });
    
    html += `
            </div>
        </div>
    `;
    
    return html;
}

function createApproversList(location) {
    const hasApprovers = location.approvers.teamLeaders.size > 0 || 
                        location.approvers.groupLeaders.size > 0 || 
                        location.approvers.managers.size > 0;
    
    if (!hasApprovers) {
        return `
            <div class="detail-section">
                <h4><i class="bi bi-clipboard-check"></i> Approvals</h4>
                <p style="color: #6c757d; font-size: 13px;">No approvals recorded yet</p>
            </div>
        `;
    }
    
    let html = `
        <div class="detail-section">
            <h4><i class="bi bi-clipboard-check"></i> Approval History</h4>
            <div class="approval-details">

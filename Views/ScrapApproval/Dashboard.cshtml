function createApprovalFlow(item) {
    let html = '<div class="approval-flow">';
 
    for (let level = 1; level <= 4; level++) {
        let stepClass = 'pending';
        let tooltip   = '';
 
        if (level === 1) {
            if (item.teamLeaderApprovalStatus === 'Approved')
            { stepClass = 'completed'; tooltip = `TL: ${item.teamLeaderApprovalBy || 'N/A'}`; }
            else if (item.teamLeaderApprovalStatus === 'Rejected')
            { stepClass = 'rejected';  tooltip = 'Rejected by TL'; }
            else if (item.status === 'Pending TL')
            { stepClass = 'current';   tooltip = 'Pending Team Leader'; }
            else { tooltip = 'Team Leader'; }
 
        } else if (level === 2) {
            if (item.groupLeaderApprovalStatus === 'Approved')
            { stepClass = 'completed'; tooltip = `GL: ${item.groupLeaderApprovalBy || 'N/A'}`; }
            else if (item.groupLeaderApprovalStatus === 'Rejected')
            { stepClass = 'rejected';  tooltip = 'Rejected by GL'; }
            else if (item.status === 'Pending GL')
            { stepClass = 'current';   tooltip = 'Pending Group Leader'; }
            else { tooltip = 'Group Leader'; }
 
        } else if (level === 3) {
            if (item.managerApprovalStatus === 'Approved')
            { stepClass = 'completed'; tooltip = `Manager: ${item.managerApprovalBy || 'N/A'}`; }
            else if (item.managerApprovalStatus === 'Rejected')
            { stepClass = 'rejected';  tooltip = 'Rejected by Manager'; }
            else if (item.status === 'Pending Manager')
            { stepClass = 'current';   tooltip = 'Pending Manager'; }
            else { tooltip = 'Manager'; }
 
        } else if (level === 4) {
            if (item.seniorManagerApprovalStatus === 'Approved')
            { stepClass = 'completed'; tooltip = `SM: ${item.seniorManagerApprovalBy || 'N/A'}`; }
            else if (item.seniorManagerApprovalStatus === 'Rejected')
            { stepClass = 'rejected';  tooltip = 'Rejected by Senior Manager'; }
            else if (item.status === 'Pending Senior Manager')
            { stepClass = 'current';   tooltip = 'Pending Senior Manager'; }
            else { tooltip = 'Senior Manager'; }
        }
 
        html += `<div class="approval-step ${stepClass}" title="${tooltip}">${level}</div>`;
        if (level < 4) html += '<i class="bi bi-arrow-right"></i>';
    }
 
    html += '</div>';
    return html;
}


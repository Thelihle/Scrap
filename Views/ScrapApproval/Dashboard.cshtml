// SCANNER MANAGEMENT
function initializeScannerManagement() {
    const confirmHandoverBtn = document.getElementById('confirmHandoverBtn');
    if (confirmHandoverBtn) {
        confirmHandoverBtn.addEventListener('click', confirmScannerHandover);
    }

    const confirmReturnBtn = document.getElementById('confirmReturnBtn');
    if (confirmReturnBtn) {
        confirmReturnBtn.addEventListener('click', confirmScannerReturn);
    }

    initializeScannerFormHandlers();
}

function initializeScannerFormHandlers() {
    const deviceConditionRadios = document.querySelectorAll('input[name="deviceCondition"]');
    deviceConditionRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            const notesGroup = document.getElementById('conditionNotesGroup');
            if (this.value === 'issues') {
                notesGroup.style.display = 'block';
                document.getElementById('conditionNotes').required = true;
            } else {
                notesGroup.style.display = 'none';
                document.getElementById('conditionNotes').required = false;
            }
        });
    });

    const batteryStatusRadios = document.querySelectorAll('input[name="batteryStatus"]');
    batteryStatusRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            const chargeLevelGroup = document.getElementById('chargeLevelGroup');
            if (this.value === 'partial') {
                chargeLevelGroup.style.display = 'block';
            } else {
                chargeLevelGroup.style.display = 'none';
            }
        });
    });

    const chargeLevel = document.getElementById('chargeLevel');
    if (chargeLevel) {
        chargeLevel.addEventListener('input', function() {
            document.getElementById('chargeLevelDisplay').textContent = this.value + '%';
        });
    }

    const returnChargeLevel = document.getElementById('returnChargeLevel');
    if (returnChargeLevel) {
        returnChargeLevel.addEventListener('input', function() {
            document.getElementById('returnChargeLevelDisplay').textContent = this.value + '%';
        });
    }
}

function loadAvailableScanners() {
    const scannerSelect = document.getElementById('scannerSelection');
    scannerSelect.innerHTML = '<option value="">Loading scanners...</option>';

    fetch('/ScrapApproval/GetAvailableScanners')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.scanners) {
                scannerSelect.innerHTML = '<option value="">Select a scanner</option>';

                if (data.scanners.length === 0) {
                    scannerSelect.innerHTML = '<option value="">No scanners available for your location</option>';
                    return;
                }

                data.scanners.forEach(scanner => {
                    const option = document.createElement('option');
                    option.value = scanner.SerialNumber;
                    option.textContent = `${scanner.SerialNumber} (${scanner.ScannerModel})`;
                    scannerSelect.appendChild(option);
                });
            } else {
                scannerSelect.innerHTML = '<option value="">Error loading scanners</option>';
                showNotification(data.message || 'Error loading scanners', 'error');
            }
        })
        .catch(error => {
            scannerSelect.innerHTML = '<option value="">Error loading scanners</option>';
            showNotification('Error loading available scanners', 'error');
        });
}

function confirmScannerHandover() {
    const errorDiv = document.getElementById('scannerHandoverError');
    errorDiv.style.display = 'none';

    const scannerSerial = document.getElementById('scannerSelection').value;
    const deviceCondition = document.querySelector('input[name="deviceCondition"]:checked')?.value;
    const batteryStatus = document.querySelector('input[name="batteryStatus"]:checked')?.value;
    const conditionNotes = document.getElementById('conditionNotes').value;
    const chargeLevel = document.getElementById('chargeLevel').value;

    if (!scannerSerial) {
        showError('scannerHandoverError', 'Please select a scanner');
        return;
    }

    if (!deviceCondition) {
        showError('scannerHandoverError', 'Please confirm device condition');
        return;
    }

    if (!batteryStatus) {
        showError('scannerHandoverError', 'Please confirm battery status');
        return;
    }

    if (deviceCondition === 'issues' && !conditionNotes.trim()) {
        showError('scannerHandoverError', 'Please specify the issues with the device');
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const confirmBtn = document.getElementById('confirmHandoverBtn');
    const originalText = confirmBtn.innerHTML;

    confirmBtn.innerHTML = '<i class="bi bi-arrow-clockwise spinner"></i> Processing...';
    confirmBtn.disabled = true;

    const request = {
        ScannerSerialNumber: scannerSerial,
        IsInGoodCondition: deviceCondition === 'good',
        ConditionNotes: conditionNotes.trim(),
        IsFullyCharged: batteryStatus === 'full',
        ChargeLevel: batteryStatus === 'full' ? 100 : parseInt(chargeLevel)
    };

    fetch('/ScrapApproval/ProcessScannerHandover', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify(request)
    })
    .then(response => response.json())
    .then(data => {
        confirmBtn.innerHTML = originalText;
        confirmBtn.disabled = false;

        if (data.success) {
            showNotification('Scanner handover completed successfully!', 'success');
            hideModal('scannerHandoverModal');
            loadScannerStatus();
        } else {
            showError('scannerHandoverError', data.message || 'Error processing handover');
        }
    })
    .catch(error => {
        confirmBtn.innerHTML = originalText;
        confirmBtn.disabled = false;
        showError('scannerHandoverError', 'Error processing scanner handover');
    });
}

function loadScannerStatus() {
    fetch('/ScrapApproval/GetScannerStatus')
        .then(response => response.json())
        .then(data => {
            const statusDiv = document.getElementById('currentScannerStatus');
            const contentDiv = document.getElementById('scannerStatusContent');


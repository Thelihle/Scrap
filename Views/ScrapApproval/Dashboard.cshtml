<script>

    // Fix z-index issues when showing modals
function showModal(modalId) {
    console.log('🔧 Showing modal:', modalId);

    // Hide all modals first
    document.querySelectorAll('.modal-professional').forEach(modal => {
        modal.classList.remove('show');
        modal.style.display = 'none';
    });

    const modal = document.getElementById(modalId);
    if (modal) {
        // Clear errors
        const errorEl = modal.querySelector('[id$="Error"]');
        if (errorEl) errorEl.style.display = 'none';

        // FORCE z-index
        modal.style.zIndex = '999999999';
        modal.style.position = 'fixed';
        
        // Show modal
        modal.style.display = 'flex';
        modal.classList.add('show');
        document.body.classList.add('modal-open');

        // FORCE all modal content to highest z-index
        const modalDialog = modal.querySelector('.modal-dialog');
        if (modalDialog) {
            modalDialog.style.zIndex = '999999999';
            modalDialog.style.position = 'relative';
        }

        // Focus first input
        setTimeout(() => {             
            const firstInput = modal.querySelector('input:not([readonly]):not([type="hidden"]):not([disabled]), select:not([disabled])');
            if (firstInput) firstInput.focus();
        }, 100);

        console.log('✅ Modal shown:', modalId);
    }
}

const CURRENT_USER_TYPE = '@userType'.toLowerCase();
const IS_ADMIN = CURRENT_USER_TYPE === 'admin';

async function loadDashboardDepartments(selectId, leadingHtml, excludeScrapClerk) {
    const sel = document.getElementById(selectId);
    if (!sel) return;

    sel.innerHTML = '<option value="">Select Department</option>' + (leadingHtml || '');

    try {
        const res = await fetch('/Account/GetDepartmentsDirect');
        const data = await res.json();
        if (!data.success) return;

        const displayOrder = ['SCRAP CLERK', 'FINAL ASSEMBLY', 'PRE ASSEMBLY', 'REWORK', 'SUPPORT', 'OTHER'];
        const grouped = {};
        data.departments.forEach(d => {
            const cat = d.category || 'OTHER';
            if (excludeScrapClerk && cat === 'SCRAP CLERK') return;   // ✅ hide admin-only departments from non-admins
            (grouped[cat] = grouped[cat] || []).push(d);
        });

        displayOrder.forEach(cat => {
            const depts = grouped[cat];
            if (!depts || depts.length === 0) return;

            const optgroup = document.createElement('optgroup');
            optgroup.label = '── ' + cat + ' ──';
            depts
                .sort((a, b) => a.name.localeCompare(b.name))
                .forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.name;
                    opt.textContent = d.name;
                    optgroup.appendChild(opt);
                });
            sel.appendChild(optgroup);
        });
    } catch (err) {
        console.error('Error loading departments for', selectId, err);
    }
}

</script>


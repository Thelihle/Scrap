    const checked  = machineGroup.querySelectorAll('.machine-checkbox:checked');
    const total    = machineGroup.querySelectorAll('.machine-checkbox');
    const summary  = machineGroup.querySelector('#machine-selection-summary');
    const selectAll = machineGroup.querySelector('#machine-select-all');

    if (summary) {
        summary.textContent = checked.length === 0
            ? '0 machines selected'
            : checked.length === total.length
                ? `All ${total.length} machines selected`
                : `${checked.length} of ${total.length} machines selected`;
    }

    if (selectAll) {
        selectAll.checked = checked.length === total.length && total.length > 0;
        selectAll.indeterminate = checked.length > 0 && checked.length < total.length;
    }
}


    border: 2px solid #428bca !important;
    color: #1a1a2e !important;
}

.card.team-leader-weight .text-end {
    margin-top: 0;
    text-align: right;
}

.card.team-leader-weight .btn-professional {
    padding: 0.5rem 1rem;
    font-size: 13px;
    min-height: 38px;
}

.weight-input-container {
    position: relative;
    display: flex;
    align-items: center;
}

.weight-input-container input {
    flex: 1;
    padding-right: 40px !important;
}

.weight-unit-label {
    position: absolute;
    right: 12px;
    color: #495057;
    font-weight: 600;
    font-size: 14px;
    pointer-events: none;
}

/* Enhanced Scrap Items Header */
.card-header > div {
    width: 100%;
}

.card-header small {
    display: block;
    margin-top: 0.25rem;
    font-size: 13px;
}

/* === VIEW TOGGLE STYLES === */
.view-toggle {
    display: inline-flex;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    overflow: hidden;
}

.view-toggle-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    padding: 8px 16px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    min-height: 44px;
}

.view-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
}

.view-toggle-btn.active {
    background: white;
    color: #428bca;
}

.view-toggle-btn i {
    font-size: 14px;
}

@@media (max-width: 768px) {
    .view-toggle {
        width: 100%;
    }
    
    .view-toggle-btn {
        flex: 1;
        justify-content: center;
    }
}

/* Mobile responsive adjustments for Scrap Items header */
@@media (max-width: 768px) {
    .card-header > div {
        flex-direction: column;
        align-items: flex-start !important;
    }
    
    .card-header > div > div:last-child {
        width: 100%;
        justify-content: flex-start;
        margin-top: 0.5rem;
    }
    
    .card-header .btn-professional {
        font-size: 12px;
        padding: 8px 12px;
        min-height: 38px;
    }
}


/* === ENHANCED LOCATION GROUPING STYLES === */
.location-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.location-group {
    background: white;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 0.5rem; /* Reduced from 1rem */
    transition: all 0.2s ease;
}

.location-group.expanded {
    border-color: #428bca;
    border-width: 2px;
    box-shadow: 0 4px 12px rgba(66, 139, 202, 0.15);
}

.location-group:hover {
    border-color: #428bca;
    box-shadow: 0 2px 6px rgba(66, 139, 202, 0.1);
}

.location-group-header {
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    padding: 0.5rem 1rem; /* Reduced from 1rem 1.5rem */
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s ease;
    user-select: none;
    min-height: 45px; /* Fixed height for consistency */
}

.location-group-header:hover {
    background: linear-gradient(135deg, #e9ecef, #dee2e6);
}

.location-group.expanded .location-group-header {
    background: linear-gradient(135deg, #428bca, #5daeed);
    color: white;
}

.location-info {
    display: flex;
    align-items: center;
    gap: 1rem; /* Reduced from 1.5rem */
    flex-wrap: wrap;
    flex: 1;
}

.location-name {
    font-size: 13px !important; /* Reduced from 16px */
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 200px; 
}

.location-group.expanded .location-name {
    color: white;
}

.location-name i {
    font-size: 12px;
}

.location-stats {
    display: flex;
    gap: 0.75rem; /* Reduced from 1.5rem */
    font-size: 11px; /* Reduced from 13px */
    flex-wrap: wrap;
    align-items: center;
}

.location-stat {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    white-space: nowrap;
}

.location-group.expanded .location-stat {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.15);
}

.location-stat i {
    font-size: 11px;
}

.stat-value {
    font-weight: 700;
    font-size: 13px !important; /* Reduced from 15px */
}

.expand-icon {
    font-size: 16px; /* Reduced from 20px */
    transition: transform 0.2s ease;
    color: #495057;
    min-width: 20px;
    text-align: center;
}

.location-group.expanded .expand-icon {
    transform: rotate(180deg);
    color: white;
}

.location-group-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
}

.location-group.expanded .location-group-body {
    max-height: 10000px;
}

.location-group-content {
    padding: 1rem;
}

/* Enhanced detail sections */
.detail-section {
    background: #f8f9fa;
    border-radius: 6px;
    padding: 0.75rem; /* Reduced from 1rem */
    margin-bottom: 0.75rem;
    border-left: 3px solid #428bca;
}

.detail-section h4 {
    font-size: 12px; /* Reduced from 14px */
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.detail-section h4 i {
    font-size: 12px;
}

.detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); /* Reduced from 200px */
    gap: 0.5rem; /* Reduced from 0.75rem */
}

.detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.detail-label {
    font-size: 9px !important; /* Reduced from 11px */
    color: #6c757d;
    font-weight: 600;
    text-transform: uppercase;
}

.detail-value {
    font-size: 11px !important; /* Reduced from 13px */
    color: #1a1a2e;
    font-weight: 500;
}

.detail-value.highlight {
    color: #428bca;
    font-weight: 600;
    font-size: 12px !important;
}

.approval-details {
    display: grid;

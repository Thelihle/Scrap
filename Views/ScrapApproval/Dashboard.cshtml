    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    if (!token) {
        showNotification('Security token not found. Please refresh the page.', 'error');
        return;
    }

    const saveBtn = document.getElementById('saveLocationWeightBtn');
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="bi bi-arrow-clockwise spinner"></i> Saving...';
    saveBtn.disabled = true;

    const dept = '@Model.CurrentDepartment';
    const line = '@Model.CurrentLine';
    const shift = '@Model.CurrentShift';

    fetch('/ScrapApproval/SaveWeight', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            Department: dept,
            Line: line,
            Shift: shift,
            Weight: weight,
            Description: description
        })
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;

        if (data.success) {
            showNotification('Weight recorded successfully!', 'success');
            weightInput.value = '';
            const descInput = document.getElementById('locationWeightDescription');
            if (descInput) descInput.value = '';
        } else {
            showNotification(data.message || 'Error saving weight', 'error');
        }
    })
    .catch(error => {
        console.error('Error saving weight:', error);
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;
        showNotification(`Error saving weight: ${error.message}`, 'error');
    });
}


@{
    ViewData["Title"] = "Error";
    Layout = "_OperatorLayout";

    // Determine redirect URL based on user role
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var dashboardUrl = userRole?.ToLower() switch
    {
        "operator" => Url.Action("Index", "Operator"),
        var role when new[] { "teamleader", "groupleader", "manager", "seniormanager", "admin" }
            .Contains(role?.ToLower()) => Url.Action("Dashboard", "ScrapApproval"),
        _ => Url.Action("Login", "Account")
    };
}

<div style="
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 500px;
    background: rgba(0, 21, 20, 0.95);
    border: 2px solid #00fffc;
    border-radius: 8px;
    padding: 30px;
    text-align: center;
    box-shadow: 0 0 30px rgba(0, 255, 252, 0.3);
">
    <h1 style="
        color: #00fffc;
        font-size: 28px;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 2px;
    ">
        ERROR
    </h1>

    <p style="
        color: #ff3333;
        margin-bottom: 30px;
        font-size: 16px;
    ">@(ViewData["ErrorMessage"] ?? "An error occurred. Please try again.")</p>

    <a href="@dashboardUrl"
       style="
        display: inline-block;
        padding: 12px 30px;
        background: transparent;
        border: 2px solid #00fffc;
        color: #00fffc;
        text-decoration: none;
        border-radius: 4px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        cursor: pointer;
    "
       onmouseover="this.style.backgroundColor='rgba(0, 255, 252, 0.1)';this.style.boxShadow='0 0 15px rgba(0, 255, 252, 0.3)'"
       onmouseout="this.style.backgroundColor='transparent';this.style.boxShadow='none'">
        Return to Dashboard
    </a>
</div>

@section Scripts {
    <script>
        // Ensure the error page takes up the full viewport
        document.body.style.margin = '0';
        document.body.style.padding = '0';
        document.body.style.minHeight = '100vh';
        document.body.style.backgroundColor = '#000';
    </script>
}
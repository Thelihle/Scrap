@model SCP_Control.ViewModels.ScrapApprovalDashboardViewModel

<!-- Bulk Actions Modal -->
<div class="modal" id="bulkActionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Action Confirmation</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form id="bulkActionForm">
                    <input type="hidden" name="isApproved" id="bulkIsApproved" />
                    <div class="form-group">
                        <label for="verificationPassword">Your Password</label>
                        <input type="password" class="form-input" id="verificationPassword" required />
                    </div>
                    <div class="form-group" id="rejectReasonGroup" style="display: none;">
                        <label for="rejectReason">Reason for Rejection</label>
                        <textarea class="form-input" id="rejectReason"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-outline" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn-outline" onclick="submitBulkAction()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- User Management Modal -->
<div class="modal" id="userManagementModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">User Management</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="user-actions">
                    <button class="btn-outline mb-2 w-full" onclick="showNewUserForm()">
                        New User Request
                    </button>
                    <button class="btn-outline w-full" onclick="showPasswordResetForm()">
                        Reset User Password
                    </button>
                </div>

                <!-- New User Form -->
                <form id="newUserForm" style="display: none;">
                    <div class="form-group">
                        <label for="userClockNumber">Clock Number</label>
                        <input type="text" class="form-input" id="userClockNumber" required />
                    </div>
                    <div class="form-group">
                        <label for="userRole">Role</label>
                        <select class="form-input" id="userRole" required>
                            <option value="">Select Role</option>
                            <option value="Operator">Operator</option>
                            <option value="TeamLeader">Team Leader</option>
                            <option value="GroupLeader">Group Leader</option>
                            <option value="Manager">Manager</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="userEmail">Email (required for management roles)</label>
                        <input type="email" class="form-input" id="userEmail" />
                    </div>
                </form>

                <!-- Password Reset Form -->
                <form id="passwordResetForm" style="display: none;">
                    <div class="form-group">
                        <label for="resetClockNumber">User Clock Number</label>
                        <input type="text" class="form-input" id="resetClockNumber" required />
                    </div>
                    <div class="form-group">
                        <label for="adminPassword">Your Admin Password</label>
                        <input type="password" class="form-input" id="adminPassword" required />
                    </div>
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" class="form-input" id="newPassword" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-outline" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn-outline" id="userManagementSubmit">Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Actions Bar -->
<div class="bulk-actions" style="display: none;">
    <div class="selected-count">0 items selected</div>
    <div class="action-buttons">
        <button class="btn-outline btn-approve" onclick="showBulkActionModal(true)" disabled>
            Bulk Approve
        </button>
        <button class="btn-outline btn-reject" onclick="showBulkActionModal(false)" disabled>
            Bulk Reject
        </button>
    </div>
</div>

        <script>

    // Bulk Actions Handler
    const bulkActionsHandler = {
        selectedItems: [],

        initialize() {
            this.setupCheckboxHandlers();
            this.setupModalHandlers();
        },

        setupCheckboxHandlers() {
            // Select all checkbox
            const selectAll = document.getElementById('selectAll');
            if (selectAll) {
                selectAll.addEventListener('change', (e) => {
                    const checkboxes = document.querySelectorAll('.scrap-select');
                    checkboxes.forEach(checkbox => {
                        checkbox.checked = e.target.checked;
                        this.updateSelectedItems();
                    });
                });
            }

            // Individual checkboxes
            document.addEventListener('change', (e) => {
                if (e.target.classList.contains('scrap-select')) {
                    this.updateSelectedItems();
                }
            });
        },

        updateSelectedItems() {
            const checkboxes = document.querySelectorAll('.scrap-select:checked');
            this.selectedItems = Array.from(checkboxes).map(cb => cb.value);

            const bulkActions = document.querySelector('.bulk-actions');
            const selectedCount = document.querySelector('.selected-count');
            const actionButtons = document.querySelectorAll('.bulk-actions button');

            if (this.selectedItems.length > 0) {
                bulkActions.style.display = 'flex';
                selectedCount.textContent = `${this.selectedItems.length} items selected`;
                actionButtons.forEach(btn => btn.disabled = false);
            } else {
                bulkActions.style.display = 'none';
                actionButtons.forEach(btn => btn.disabled = true);
            }
        },

        showBulkActionModal(isApprove) {
            const modal = document.getElementById('bulkActionModal');
            const rejectReasonGroup = document.getElementById('rejectReasonGroup');
            document.getElementById('bulkIsApproved').value = isApprove;

            rejectReasonGroup.style.display = isApprove ? 'none' : 'block';
            $(modal).modal('show');
        },

        async submitBulkAction() {
            const isApproved = document.getElementById('bulkIsApproved').value === 'true';
            const password = document.getElementById('verificationPassword').value;
            const reason = document.getElementById('rejectReason').value;

            if (!password || (!isApproved && !reason)) {
                alert('Please fill in all required fields');
                return;
            }

            try {
                const response = await fetch('/ScrapApproval/BulkUpdateItems', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        scrapIds: this.selectedItems,
                        isApproved: isApproved,
                        verificationPassword: password,
                        reason: reason
                    })
                });

                const result = await response.json();
                if (result.success) {
                    $('#bulkActionModal').modal('hide');
                    window.location.reload();
                } else {
                    alert(result.message || 'Error processing bulk action');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error processing bulk action');
            }
        }
    };

    // User Management Handler
    const userManagementHandler = {
        currentAction: '',

        showNewUserForm() {
            this.currentAction = 'newUser';
            document.getElementById('newUserForm').style.display = 'block';
            document.getElementById('passwordResetForm').style.display = 'none';
            $('#userManagementModal').modal('show');
        },

        showPasswordResetForm() {
            this.currentAction = 'resetPassword';
            document.getElementById('newUserForm').style.display = 'none';
            document.getElementById('passwordResetForm').style.display = 'block';
            $('#userManagementModal').modal('show');
        },

        async handleSubmit() {
            if (this.currentAction === 'newUser') {
                await this.submitNewUser();
            } else if (this.currentAction === 'resetPassword') {
                await this.submitPasswordReset();
            }
        },

        async submitNewUser() {
            const clockNumber = document.getElementById('userClockNumber').value;
            const role = document.getElementById('userRole').value;
            const email = document.getElementById('userEmail').value;

            if (!clockNumber || !role || (this.isManagementRole(role) && !email)) {
                alert('Please fill in all required fields');
                return;
            }

            try {
                const response = await fetch('/ScrapApproval/GrantAccess', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        userClockNumber: clockNumber,
                        role: role,
                        email: email
                    })
                });

                const result = await response.json();
                if (result.success) {
                    $('#userManagementModal').modal('hide');
                    alert('User created successfully');
                } else {
                    alert(result.message || 'Error creating user');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error creating user');
            }
        },

        async submitPasswordReset() {
            const clockNumber = document.getElementById('resetClockNumber').value;
            const adminPassword = document.getElementById('adminPassword').value;
            const newPassword = document.getElementById('newPassword').value;

            if (!clockNumber || !adminPassword || !newPassword) {
                alert('Please fill in all required fields');
                return;
            }

            try {
                const response = await fetch('/ScrapApproval/ResetPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        userClockNumber: clockNumber,
                        approverPassword: adminPassword,
                        newPassword: newPassword
                    })
                });

                const result = await response.json();
                if (result.success) {
                    $('#userManagementModal').modal('hide');
                    alert('Password reset successful');
                } else {
                    alert(result.message || 'Error resetting password');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error resetting password');
            }
        },

        isManagementRole(role) {
            return ['GroupLeader', 'Manager', 'SeniorManager'].includes(role);
        }
    };

    // Initialize handlers when document is ready
    document.addEventListener('DOMContentLoaded', () => {
        bulkActionsHandler.initialize();

        // Set up user management submit handler
        document.getElementById('userManagementSubmit').addEventListener('click', () => {
            userManagementHandler.handleSubmit();
        });
    });

        </script>
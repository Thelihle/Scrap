@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scrap Management</title>

    <!-- CSS References -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Script References -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>

    <style>
        :root {
            --neon-cyan: #00ffff;
            --dark-bg: #1a1a1a;
            --neon-cyan-transparent: rgba(0, 255, 255, 0.1);
            --neon-cyan-border: rgba(0, 255, 255, 0.3);
        }

        body {
            background-color: var(--dark-bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 1rem;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .container {
            width: 100%;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .login-container {
            background: var(--neon-cyan-transparent);
            border: 1px solid var(--neon-cyan);
            border-radius: 8px;
            padding: 2rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.1);
        }

        .login-title {
            color: var(--neon-cyan);
            text-align: center;
            margin-bottom: 2rem;
            font-size: 24px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
        }

        .form-control {
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid var(--neon-cyan-border);
            color: var(--neon-cyan);
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: rgba(0, 0, 0, 0.8);
                border-color: var(--neon-cyan);
                box-shadow: 0 0 0 0.2rem rgba(0, 255, 242, 0.25);
                color: var(--neon-cyan);
                outline: none;
            }

            .form-control::placeholder {
                color: rgba(0, 255, 255, 0.5);
            }

        .btn-login {
            background: var(--neon-cyan);
            border: none;
            color: var(--dark-bg);
            padding: 0.75rem 2rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 1rem;
        }

            .btn-login:hover {
                background: #00cccc;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 255, 255, 0.3);
            }

        .error-box {
            display: none;
            background: rgba(255, 0, 0, 0.1);
            border: 1px solid rgba(255, 0, 0, 0.3);
            color: #ff3333;
            padding: 1rem;
            border-radius: 4px;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            align-items: center;
            gap: 0.5rem;
        }

        .password-wrapper {
            position: relative;
        }

        .toggle-pwd {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--neon-cyan);
            cursor: pointer;
            transition: color 0.3s ease;
        }

            .toggle-pwd:hover {
                color: #00cccc;
            }

        /* Toast customization */
        .toast-container {
            margin-top: 1rem;
        }

        #toast-container > div {
            opacity: 1;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@* /Views/Shared/_ResetPasswordModalPartial.cshtml *@

<div id="resetPasswordModal" class="modal">
    <div class="setup-container">
        <div class="setup-box">
            <h1 class="setup-title">Reset Password</h1>
            <p class="setup-subtitle">Reset user password</p>

            <form id="resetPasswordForm">
                @Html.AntiForgeryToken()
                <div class="validation-message"></div>

                <div class="form-group">
                    <label for="userClockNumber">User Clock Number</label>
                    <input type="text" id="userClockNumber" class="form-control" required
                           placeholder="Enter user's clock number" />
                </div>

                <div class="form-group">
                    <label for="approverPasswordReset">Your Password</label>
                    <input type="password" id="approverPasswordReset" class="form-control" required
                           placeholder="Enter your password" />
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" class="form-control" required
                           placeholder="Enter new password" />
                </div>

                <button type="submit" class="save-button">
                    <span class="button-text">Reset Password</span>
                    <div class="spinner-border spinner-border-sm d-none" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </button>
            </form>
        </div>
    </div>
</div>
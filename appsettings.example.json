{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Information",
        "Microsoft.AspNetCore.Authorization": "Information",
        "System": "Warning",
        "SCP_Control": "Information",
        "SCP_Control.Controllers": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Application/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Errors/errors-.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Performance/performance-.log",
          "restrictedToMinimumLevel": "Warning",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 26214400,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithMachineName", "WithProcessName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Antiforgery": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information",
      "SCP_Control.Controllers": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=hhsql3;Database=IntegrationCompanyB;Trusted_Connection=True;TrustServerCertificate=True;",
    "SysproConnection": "Server=hhsql3;Database=SysproCompanyB;Trusted_Connection=True;TrustServerCertificate=True;"
    // "SysproConnectionX": "Server=HHFS1\\SQLSERVER2008;Database=SysproCompanyX;User Id=hestowebappsuser;Password=<password>;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:9000"
      }
    }
  },
  "Authentication": {
    "Cookie": {
      "Domain": null,
      "SecurePolicy": "Never",
      "SameSite": "Lax",
      "HttpOnly": true,
      "Path": "/",
      "Name": "SCP_Auth",
      "LoginPath": "/Account/Login",
      "LogoutPath": "/Account/Logout",
      "ExpireTimeSpan": "12:00:00"
    }
  },
  "UseHttpsRedirection": false,
  "RequireHttpsMetadata": false,
  "BaseUrl": "http://myhesto:9000",
  "Scanner": {
    "AllowedBarcodeTypes": [
      "code_128",
      "ean",
      "ean_8",
      "code_39",
      "upc",
      "upc_e"
    ],
    "CameraSettings": {
      "facingMode": "environment",
      "width": {
        "min": 640,
        "ideal": 1280,
        "max": 1920
      },
      "height": {
        "min": 480,
        "ideal": 720,
        "max": 1080
      }
    },
    "ScannerOptions": {
      "numberOfWorkers": 4,
      "locate": true,
      "inputStream": {
        "name": "Live",
        "type": "LiveStream",
        "constraints": {
          "facingMode": "environment",
          "aspectRatio": {
            "min": 1,
            "max": 2
          }
        }
      },
      "locator": {
        "patchSize": "medium",
        "halfSample": true
      },
      "numOfWorkers": 4,
      "decoder": {
        "readers": [
          "code_128_reader",
          "ean_reader",
          "ean_8_reader",
          "code_39_reader",
          "upc_reader",
          "upc_e_reader"
        ]
      }
    }
  },
  "Security": {
    "AllowedOrigins": [
      "https://localhost:7226",
      "http://localhost:5226",
      "https://10.190.17.121:7226",
      "http://10.190.17.121:5226",
      "http://myhesto:9000"
    ],
    "MaxUploadSize": 10485760,
    "AllowedFileTypes": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf"
    ]
  },
  "Application": {
    "Name": "SCP Control",
    "Version": "1.0.0",
    "Company": "Hesto",
    "SupportEmail": "thembelihle.manyoni@hesto.co.za",
    "DefaultTimeZone": "Africa/Johannesburg"
  },
  "Cache": {
    "SlidingExpirationMinutes": 20,
    "AbsoluteExpirationMinutes": 60
  },
  "Features": {
    "EnableMobileScanner": true,
    "EnableBarcodeScanning": true,
    "EnableAutoLogout": true,
    "AutoLogoutMinutes": 30
  }
}